---
/**
 * 文章布局 — LiuShen's Blog (清羽飞扬) 美学风格 + 1400px 全站等宽
 * 顶部独立全宽毛玻璃英雄头卡（.post-hero：氛围光晕 + 分类角标 + 渐变大标题 + 标签 + 元信息胶囊）
 * 下方双栏（左：顶部渐隐封面 + 正文 + 底栏 + 评论；右 300px：公告置顶 + 粘性[目录 TOC + 站点统计]）
 */
import BaseLayout from "./BaseLayout.astro";
import TOC from "../components/blog/TOC.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Encryptor from "../components/blog/Encryptor.astro";
import ArticleFooter from "../components/blog/ArticleFooter.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import type { SidebarStats } from "../components/sidebar/Sidebar.astro";
import { Icon } from "astro-icon/components";
import { commentConfig } from "../config/comment";

import "../styles/expressive-code.css";
import "../styles/encrypted-content.css";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description: string;
  tags?: string[];
  category?: string;
  cover?: string;
  pinned?: boolean;
  author?: string;
  draft?: boolean;
  abbrlink?: string;
  toc?: boolean;
  comment?: boolean;
  readingTime?: number;
  wordCount?: number;
  headings?: { depth: number; slug: string; text: string }[];
  password?: string;
  hint?: string;
  slug?: string;
  contentPath?: string;
  share?: boolean;
  license?: false | { name: string; url: string };
  stats?: SidebarStats;
}

const {
  title,
  date,
  updated,
  description,
  tags,
  category,
  cover,
  author,
  toc: showToc = true,
  comment: showComment = true,
  readingTime,
  wordCount,
  headings = [],
  password,
  hint,
  slug,
  contentPath,
  share = true,
  license,
  stats,
} = Astro.props;

const displayUpdated = updated || date;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEncrypted = !!password;
const commentsEnabled = showComment && commentConfig.enabled;
const hasToc = showToc && !isEncrypted && headings.some((h) => h.depth >= 2 && h.depth <= 4);
---

<BaseLayout title={title} description={description} image={cover}>
  <JsonLd
    type="article"
    title={title}
    description={description}
    url={canonicalURL.href}
    image={cover}
    datePublished={date.toISOString()}
    dateModified={displayUpdated.toISOString()}
    author={author}
  />

  <div class="article-page" data-pagefind-body={!isEncrypted ? true : undefined}>
    {/* ── 顶部独立全宽英雄头卡（LiuShen 风格） ── */}
    <header class="post-hero">
      <div class="post-hero__glow" aria-hidden="true"></div>
      <div class="post-hero__card glass-panel">
        {category && (
          <a href={`/categories/${encodeURIComponent(category.trim())}/`} class="post-hero__category">
            <Icon name="fa7-solid:folder-open" />
            <span>{category.trim()}</span>
          </a>
        )}

        <h1 class="post-hero__title" data-pagefind-meta="title">{title}</h1>

        {category && <span hidden data-pagefind-filter={`category:${category.trim()}`}>{category.trim()}</span>}
        {(tags ?? []).map((tag) => <span hidden data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}

        {tags && tags.length > 0 && (
          <div class="post-hero__tags">
            {tags.map((t) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} class="post-hero__tag">
                <span class="post-hero__tag-hash">#</span>
                {t}
              </a>
            ))}
          </div>
        )}

        <div class="post-hero__meta">
          <div class="post-hero__meta-row">
            <span class="post-hero__badge">
              <Icon name="fa7-solid:calendar-days" class="post-hero__badge-icon" />
              发布于 <time datetime={date.toISOString()}><FormattedDate date={date} /></time>
            </span>
            {updated && (
              <span class="post-hero__badge">
                <Icon name="fa7-solid:pencil" class="post-hero__badge-icon" />
                更新于 <time datetime={updated.toISOString()}><FormattedDate date={updated} /></time>
              </span>
            )}
            {wordCount && (
              <span class="post-hero__badge">
                <Icon name="fa7-solid:font" class="post-hero__badge-icon" />
                {wordCount.toLocaleString("zh-CN")} 字
              </span>
            )}
            {readingTime && (
              <span class="post-hero__badge">
                <Icon name="fa7-regular:clock" class="post-hero__badge-icon" />
                {readingTime} 分钟
              </span>
            )}
          </div>
        </div>

        {description && (
          <div class="post-hero__summary">
            <div class="post-hero__summary-head">
              <div class="post-hero__summary-dots" aria-hidden="true">
                <span class="dot dot--red"></span>
                <span class="dot dot--yellow"></span>
                <span class="dot dot--green"></span>
              </div>
              <span class="post-hero__summary-label">文章导读</span>
            </div>
            <p class="post-hero__summary-text">{description}</p>
          </div>
        )}
      </div>
    </header>

    {/* ── 下方双栏：左正文 + 右 300px 侧栏（与首页 .home-grid 等宽对齐） ── */}
    <div class="article-layout">
      <article class="article glass-panel">
        {cover && (
          <div class="article__cover">
            <img src={cover} alt={title} loading="eager" decoding="async" />
          </div>
        )}

        <div class="article__body">
          {isEncrypted ? (
            <Encryptor password={password} slug={slug || ""} hint={hint}>
              <slot />
            </Encryptor>
          ) : (
            <div class="article__content prose custom-md">
              <slot />
            </div>
          )}

          <ArticleFooter
            title={title}
            description={description}
            date={date}
            updated={updated}
            cover={cover}
            author={author}
            slug={slug || ""}
            contentPath={contentPath}
            share={share}
            license={license}
          />

          {commentsEnabled && <TwikooComments />}
        </div>
      </article>

      <div class="article__sidebar">
        <Sidebar stats={stats ?? { postCount: 0, categoryCount: 0, tagCount: 0, totalWords: 0, latestDay: "2026-01-01" }}>
          {hasToc && <TOC slot="after-announcement" headings={headings} />}
        </Sidebar>
      </div>
    </div>
  </div>

  {/* 浮动操作按钮组 — TOC / 评论 / 回顶部 */}
  {commentsEnabled && (
    <button class="fab fab--comments" id="fab-comments" aria-label="跳转到评论">
      <Icon name="fa7-solid:comment-dots" />
    </button>
  )}
  {hasToc && (
    <button class="fab fab--toc" id="fab-toc" aria-label="文章目录">
      <Icon name="fa7-solid:list" />
    </button>
  )}
  {/* TOC 弹出面板 */}
  <div class="toc-overlay" id="toc-overlay">
    <div class="toc-overlay__panel glass-panel">
      <div class="toc-overlay__header">
        <span class="toc-overlay__title">目录</span>
        <button class="toc-overlay__close" id="toc-overlay-close" aria-label="关闭目录">
          <Icon name="fa7-solid:xmark" />
        </button>
      </div>
      <nav class="toc-overlay__nav">
        {headings.filter(h => h.depth >= 2 && h.depth <= 4).map((h) => (
          <a href={`#${h.slug}`} class={`toc-overlay__link toc-overlay__link--h${h.depth}`}>
            {h.text.replace(/\s*#$/, "").trim()}
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── 全站统一 1400px 外框容器 ── */
  .article-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) var(--space-12);
  }

  /* ── 顶部独立全宽英雄头卡（LiuShen 风格） ── */
  .post-hero {
    position: relative;
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .post-hero__glow {
    position: absolute;
    inset: -2px;
    border-radius: calc(var(--radius-xl) + 4px);
    background:
      radial-gradient(circle at 18% 20%, oklch(from var(--accent) l c h / 0.16), transparent 55%),
      radial-gradient(circle at 82% 80%, oklch(from var(--accent) l c h / 0.12), transparent 55%);
    opacity: 0.85;
    pointer-events: none;
    z-index: 0;
  }

  .post-hero__card {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8) var(--space-6);
    overflow: hidden;
  }

  .post-hero__category {
    position: absolute;
    top: var(--space-4);
    left: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-md);
    border: 1px solid oklch(from var(--accent) l c h / 0.3);
    background: oklch(from var(--accent) l c h / 0.12);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition:
      background var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-material);
  }

  .post-hero__category:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .post-hero__category :global(svg) {
    width: 13px;
    height: 13px;
  }

  .post-hero__title {
    max-width: 52rem;
    margin: var(--space-2) auto 0;
    font-size: clamp(1.75rem, 1.35rem + 1.8vw, 2.65rem);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.025em;
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 55%, var(--foreground)) 28%,
      var(--foreground) 55%,
      var(--foreground) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-wrap: balance;
  }

  .post-hero__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .post-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px 11px;
    border-radius: var(--radius-full);
    border: 1px solid oklch(from var(--accent) l c h / 0.24);
    background: oklch(from var(--accent) l c h / 0.08);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--duration-fast) var(--ease-material),
      border-color var(--duration-fast) var(--ease-material);
  }

  .post-hero__tag:hover {
    background: oklch(from var(--accent) l c h / 0.18);
    border-color: var(--accent);
  }

  .post-hero__tag-hash {
    opacity: 0.7;
  }

  .post-hero__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .post-hero__meta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .post-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px;
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    background: oklch(0.96 0.008 var(--hue) / 0.45);
    color: var(--foreground-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  :global(:root.dark) .post-hero__badge {
    background: oklch(0.14 0.01 var(--hue) / 0.55);
  }

  .post-hero__badge-icon {
    width: 13px;
    height: 13px;
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── 仿 macOS 窗口式文章导读卡（LiuShen ai-summary 风格） ── */
  .post-hero__summary {
    max-width: 56rem;
    margin: var(--space-6) auto 0;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid oklch(from var(--accent) l c h / 0.22);
    background: linear-gradient(
      145deg,
      oklch(from var(--accent) l c h / 0.08),
      oklch(0 0 0 / 0.08)
    );
    text-align: left;
    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.1);
  }

  .post-hero__summary-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .post-hero__summary-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .post-hero__summary-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .post-hero__summary-dots .dot--red { background: #fc625d; }
  .post-hero__summary-dots .dot--yellow { background: #fdbc40; }
  .post-hero__summary-dots .dot--green { background: #35cd4b; }

  .post-hero__summary-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .post-hero__summary-text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.72;
    color: var(--foreground-secondary);
  }

  /* ── 下方双栏：与首页 .home-grid 列宽 100% 一致；align-items: stretch 使侧栏同高拉伸以支撑目录粘性固定并在文末释放 ── */
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-8);
    align-items: stretch;
  }

  .article {
    --prose-width: 100%;
    width: 100%;
    min-width: 0;
    align-self: start;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  /* 顶部封面图：LiuShen 风格底部渐隐遮罩融入正文 */
  .article__cover {
    position: relative;
    width: 100%;
    height: clamp(190px, 24vw, 280px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 0% 48%, transparent 100%);
    mask-image: linear-gradient(#000 0% 48%, transparent 100%);
    margin-bottom: calc(var(--space-4) * -1);
  }

  .article__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  :global(:root.dark) .article__cover img {
    filter: brightness(0.84);
  }

  .article__body {
    padding: var(--space-8);
  }

  /* 右侧 300px 侧栏复用全站 Sidebar；撑满轨道高度以允许目录在公告后粘性定位 */
  .article__sidebar {
    position: relative;
    min-width: 0;
    height: 100%;
  }

  .article__sidebar :global(.sidebar) {
    height: 100%;
  }

  .article__sidebar :global(.toc) {
    position: sticky;
    top: calc(var(--header-height) + 20px);
    z-index: 10;
    max-height: calc(100vh - var(--header-height) - 44px);
    background: color-mix(in oklab, var(--glass-dropdown-bg) 92%, var(--surface-1));
    -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturation));
  }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .article__sidebar {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .post-hero__card {
      padding: var(--space-10) var(--space-4) var(--space-5);
      border-radius: var(--radius-lg);
    }
    .article {
      border-radius: var(--radius-lg);
    }
    .article__body {
      padding: var(--space-5) var(--space-4);
    }
  }

  /* ── 浮动操作按钮组（TOC / 跳评论 / 回顶部） ── */
  .fab {
    position: fixed;
    right: var(--space-4);
    z-index: 80;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    pointer-events: none;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    transition:
      opacity 0.22s var(--ease-decelerate),
      transform 0.22s var(--ease-decelerate);
  }

  .fab--top { bottom: calc(var(--space-10) + 20px); }
  .fab--comments { bottom: calc(var(--space-10) + 20px + 44px + var(--space-2)); }
  .fab--toc { bottom: calc(var(--space-10) + 20px + 88px + var(--space-4)); }

  .fab:hover {
    color: var(--foreground);
  }

  .fab svg {
    width: 18px;
    height: 18px;
  }

  .fab--visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .fab--hiding {
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    transition:
      opacity 0.18s var(--ease-accelerate),
      transform 0.18s var(--ease-accelerate);
  }

  .fab--hiding.fab--top { transition-delay: 0s; }
  .fab--hiding.fab--comments { transition-delay: 0.06s; }
  .fab--hiding.fab--toc { transition-delay: 0.12s; }

  /* ── TOC 弹出面板 ── */
  .toc-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s var(--ease-standard);
  }

  .toc-overlay--open {
    opacity: 1;
    pointer-events: auto;
  }

  .toc-overlay__panel {
    width: min(320px, calc(100vw - var(--space-8)));
    max-height: 60vh;
    padding: var(--space-4);
    overflow-y: auto;
    transform: translateY(12px) scale(0.96);
    transition: transform 0.22s var(--ease-decelerate);
  }

  .toc-overlay--open .toc-overlay__panel {
    transform: translateY(0) scale(1);
  }

  .toc-overlay__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .toc-overlay__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
  }

  .toc-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    color: var(--foreground-muted);
    transition: background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__close:hover {
    background: var(--accent-subtle);
  }

  .toc-overlay__close svg {
    width: 16px;
    height: 16px;
  }

  .toc-overlay__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-overlay__link {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--foreground-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .toc-overlay__link--h3 { padding-left: calc(var(--space-2) + var(--space-4)); }
  .toc-overlay__link--h4 { padding-left: calc(var(--space-2) + var(--space-8)); }

  .toc-overlay__panel::-webkit-scrollbar { width: 4px; }
  .toc-overlay__panel::-webkit-scrollbar-track { background: transparent; }
  .toc-overlay__panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-sm); }

  @media (max-width: 768px) {
    .fab { right: var(--space-3); width: 40px; height: 40px; }
    .fab svg { width: 16px; height: 16px; }
    .fab--top { bottom: calc(var(--space-8) + 16px); }
    .fab--comments { bottom: calc(var(--space-8) + 16px + 40px + var(--space-2)); }
    .fab--toc { bottom: calc(var(--space-8) + 16px + 80px + var(--space-4)); }
  }
</style>

<script>
  let fabMO: MutationObserver | null = null;
  let fabTimer: ReturnType<typeof setTimeout> | null = null;
  const FAB_ENTRANCE_STAGGER = 60;
  const FAB_EXIT_STAGGER = 50;

  function initFabs() {
    const backToTop = document.getElementById("back-to-top");
    const fabComments = document.getElementById("fab-comments");
    const fabToc = document.getElementById("fab-toc");
    const tocOverlay = document.getElementById("toc-overlay");
    const tocClose = document.getElementById("toc-overlay-close");

    if (!backToTop || (backToTop as HTMLElement).dataset.fabInit) return;
    (backToTop as HTMLElement).dataset.fabInit = "1";

    const fabs = [backToTop, fabComments, fabToc].filter(Boolean) as HTMLElement[];
    let visible = false;

    function showFabs() {
      if (visible) return;
      visible = true;
      if (fabTimer) clearTimeout(fabTimer);
      fabs.forEach((fab, i) => {
        setTimeout(() => {
          fab.classList.remove("fab--hiding");
          fab.classList.add("fab--visible");
        }, i * FAB_ENTRANCE_STAGGER);
      });
    }

    function hideFabs() {
      if (!visible) return;
      visible = false;
      if (fabTimer) clearTimeout(fabTimer);
      if (tocOverlay) tocOverlay.classList.remove("toc-overlay--open");
      fabs.forEach((fab, i) => {
        setTimeout(() => {
          fab.classList.remove("fab--visible");
          fab.classList.add("fab--hiding");
          setTimeout(() => fab.classList.remove("fab--hiding"), 200);
        }, (fabs.length - 1 - i) * FAB_EXIT_STAGGER);
      });
    }

    fabMO?.disconnect();
    fabMO = new MutationObserver(() => {
      if (backToTop.classList.contains("fab--visible")) {
        showFabs();
      } else {
        hideFabs();
      }
    });
    fabMO.observe(backToTop, { attributes: true, attributeFilter: ["class"] });

    if (backToTop.classList.contains("fab--visible")) {
      showFabs();
    }

    if (fabToc && tocOverlay) {
      fabToc.addEventListener("click", () => {
        tocOverlay.classList.toggle("toc-overlay--open");
      });

      tocClose?.addEventListener("click", () => {
        tocOverlay.classList.remove("toc-overlay--open");
      });

      tocOverlay.addEventListener("click", (e) => {
        if (e.target === tocOverlay) {
          tocOverlay.classList.remove("toc-overlay--open");
        }
      });

      tocOverlay.querySelectorAll(".toc-overlay__link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          tocOverlay.classList.remove("toc-overlay--open");
          const id = (link as HTMLAnchorElement).getAttribute("href")?.slice(1);
          const target = id ? document.getElementById(id) : null;
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    }

    fabComments?.addEventListener("click", () => {
      document.getElementById("comments")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.getElementById("toc-overlay")?.classList.remove("toc-overlay--open");
    }
  });

  document.addEventListener("DOMContentLoaded", initFabs);
  document.addEventListener("astro:page-load", initFabs);
</script>
