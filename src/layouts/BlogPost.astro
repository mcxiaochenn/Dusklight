---
/**
 * 文章布局
 * BaseLayout + .prose + TOC + ArticleMeta + Tag + 加密支持
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TOC from "../components/blog/TOC.astro";
import ArticleMeta from "../components/blog/ArticleMeta.astro";
import Tag from "../components/ui/Tag.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Encryptor from "../components/blog/Encryptor.astro";
import { Icon } from "astro-icon/components";

import "../styles/expressive-code.css";
import "../styles/encrypted-content.css";

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description: string;
  tags?: string[];
  category?: string;
  cover?: string;
  pinned?: boolean;
  author?: string;
  draft?: boolean;
  abbrlink?: string;
  toc?: boolean;
  comment?: boolean;
  readingTime?: number;
  wordCount?: number;
  headings?: { depth: number; slug: string; text: string }[];
  password?: string;
  hint?: string;
  slug?: string;
}

const { title, date, updated, description, tags, category, cover, author, toc: showToc = true, comment: showComment = true, readingTime, wordCount, headings = [], password, hint, slug } = Astro.props;
const displayUpdated = updated || date;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEncrypted = !!password;
---

<BaseLayout title={title} description={description} image={cover}>
  <JsonLd type="article" title={title} description={description} url={canonicalURL.href} image={cover} datePublished={date.toISOString()} dateModified={displayUpdated.toISOString()} author={author} />

  <div class="article-layout">
    <article class="article">
      {cover && (
        <div class="article__cover">
          <img src={cover} alt={title} loading="eager" decoding="async" />
        </div>
      )}

      <header class="article__header">
        {tags && tags.length > 0 && (
          <div class="article__tags">
            {tags.map((t) => <Tag>{t}</Tag>)}
          </div>
        )}
        <h1 class="article__title">{title}</h1>
        {/* 传 frontmatter 原值而非 displayUpdated —— 后者以 date 兜底，
            会让每篇没写 updated 的文章都并排显示「更新于 <同一天>」。
            兜底语义只对上方 JSON-LD 的 dateModified 有意义。 */}
        <ArticleMeta date={date} updated={updated} category={category} readingTime={readingTime} wordCount={wordCount} />
      </header>

      {isEncrypted ? (
        <Encryptor password={password} slug={slug || ""} hint={hint}>
          <slot />
        </Encryptor>
      ) : (
        <div class="article__content prose custom-md">
          <slot />
        </div>
      )}

      {/* 评论区锚点 — 始终渲染，用于跳转定位 */}
      <div id="comments-anchor" style="height: 0; overflow: hidden;"></div>
      {showComment && <TwikooComments />}
    </article>

    {/* 加密文章不渲染目录：headings 来自 render(post) 的明文结果，
        Encryptor 只加密 slot 正文，目录会把全部小标题以静态 HTML
        暴露给未解锁的访客（搜索引擎同样能索引到）。 */}
    {showToc && !isEncrypted && headings.length > 0 && (
      <aside class="article__sidebar">
        <TOC headings={headings} />
      </aside>
    )}
  </div>

  {/* 评论跳转按钮 — 固定定位，在 grid 外部 */}
  {showComment && (
    <button class="jump-comments" id="jump-comments" aria-label="跳转到评论">
      <Icon name="ph:chat-circle-text" />
    </button>
  )}
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: var(--space-8);
    max-width: calc(var(--content-width) + 250px + var(--space-8));
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .article { max-width: var(--content-width); }

  .article__cover {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article__cover img { width: 100%; height: auto; display: block; border-radius: 0; }

  .article__header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }

  .article__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .article__sidebar { position: relative; }

  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr; }
    .article__sidebar { display: none; }
  }

  @media (max-width: 768px) {
    .article__title { font-size: var(--text-xl); }
  }

  /* ── 评论跳转按钮 ── */
  .jump-comments {
    position: fixed;
    bottom: calc(var(--space-10) + 20px + 44px + var(--space-2));
    right: var(--space-4);
    z-index: 80;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    transition:
      opacity var(--duration-normal) var(--ease-material),
      transform var(--duration-normal) var(--ease-decelerate),
      color var(--duration-fast) var(--ease-material);
  }

  .jump-comments--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .jump-comments:hover {
    color: var(--foreground);
  }

  .jump-comments svg {
    width: 18px;
    height: 18px;
  }
</style>

<script>
  let jumpMO: MutationObserver | null = null;
  function initJumpComments() {
    const btn = document.getElementById("jump-comments");
    const backToTop = document.getElementById("back-to-top");
    if (!btn || !backToTop || (btn as HTMLElement).dataset.jcInit) return;
    (btn as HTMLElement).dataset.jcInit = "1";

    // 与 back-to-top 同步显示/隐藏
    function syncVisibility() {
      if (backToTop.classList.contains("back-to-top--visible")) {
        btn.classList.add("jump-comments--visible");
      } else {
        btn.classList.remove("jump-comments--visible");
      }
    }

    jumpMO?.disconnect();
    jumpMO = new MutationObserver(syncVisibility);
    jumpMO.observe(backToTop, { attributes: true, attributeFilter: ["class"] });
    syncVisibility();

    btn.addEventListener("click", () => {
      const target = document.getElementById("comments-anchor") || document.getElementById("twikoo");
      target?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  }

  document.addEventListener("DOMContentLoaded", initJumpComments);
  document.addEventListener("astro:page-load", initJumpComments);
</script>
