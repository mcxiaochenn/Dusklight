---
/**
 * 文章布局
 * BaseLayout + .prose + TOC + ArticleMeta + Tag
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TOC from "../components/blog/TOC.astro";
import ArticleMeta from "../components/blog/ArticleMeta.astro";
import Tag from "../components/ui/Tag.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import JsonLd from "../components/seo/JsonLd.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: { src: string };
  cover?: string;
  coverAlt?: string;
  tags?: string[];
  category?: string;
  toc?: boolean;
  comment?: boolean;
  readingTime?: number;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, cover, coverAlt, tags, category, toc: showToc = true, comment: showComment = true, readingTime, headings = [] } = Astro.props;
const coverImage = cover || (heroImage ? heroImage.src : undefined);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout title={title} description={description} image={cover}>
  <JsonLd type="article" title={title} description={description} url={canonicalURL.href} image={cover} datePublished={pubDate.toISOString()} dateModified={updatedDate?.toISOString()} />

  <div class="article-layout">
    <article class="article">
      {coverImage && (
        <div class="article__cover">
          <img src={coverImage} alt={coverAlt || title} loading="eager" decoding="async" />
        </div>
      )}

      <header class="article__header">
        {tags && tags.length > 0 && (
          <div class="article__tags">
            {tags.map((t) => <Tag>{t}</Tag>)}
          </div>
        )}
        <h1 class="article__title">{title}</h1>
        <ArticleMeta pubDate={pubDate} updatedDate={updatedDate} category={category} readingTime={readingTime} />
      </header>

      <div class="article__content prose">
        <slot />
      </div>

      {showComment && <TwikooComments />}
    </article>

    {showToc && headings.length > 0 && (
      <aside class="article__sidebar">
        <TOC headings={headings} />
      </aside>
    )}
  </div>

  {/* 评论跳转按钮 — 固定定位，在 grid 外部 */}
  {showComment && (
    <button class="jump-comments" id="jump-comments" aria-label="跳转到评论">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </button>
  )}
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: var(--space-8);
    max-width: calc(var(--content-width) + 250px + var(--space-8));
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .article { max-width: var(--content-width); }

  .article__cover {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article__cover img { width: 100%; height: auto; display: block; border-radius: 0; }

  .article__header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }

  .article__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .article__sidebar { position: relative; }

  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr; }
    .article__sidebar { display: none; }
  }

  @media (max-width: 768px) {
    .article__title { font-size: var(--text-xl); }
  }

  /* ── 评论跳转按钮 ── */
  .jump-comments {
    position: fixed;
    bottom: calc(var(--space-8) + 20px + 44px + var(--space-2));
    right: var(--space-4);
    z-index: 50;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    transform: translateY(var(--space-4));
    pointer-events: none;
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md), inset 0 0.5px 0 var(--glass-highlight);
    transition:
      opacity var(--duration-normal) var(--ease-entrance),
      transform var(--duration-normal) var(--ease-entrance),
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .jump-comments--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .jump-comments:hover {
    color: var(--foreground);
  }
</style>

<script>
  function initJumpComments() {
    const btn = document.getElementById("jump-comments");
    const backToTop = document.getElementById("back-to-top");
    if (!btn || !backToTop) return;

    // 与 back-to-top 同步显示/隐藏
    function syncVisibility() {
      if (backToTop.classList.contains("back-to-top--visible")) {
        btn.classList.add("jump-comments--visible");
      } else {
        btn.classList.remove("jump-comments--visible");
      }
    }

    const observer = new MutationObserver(syncVisibility);
    observer.observe(backToTop, { attributes: true, attributeFilter: ["class"] });
    syncVisibility();

    btn.addEventListener("click", () => {
      const target = document.getElementById("tcomment");
      target?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  }

  document.addEventListener("DOMContentLoaded", initJumpComments);
  document.addEventListener("astro:page-load", initJumpComments);
</script>
