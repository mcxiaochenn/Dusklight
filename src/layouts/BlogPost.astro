---
/**
 * 文章布局
 * BaseLayout + .prose + TOC + ArticleMeta + Tag + 加密支持
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TOC from "../components/blog/TOC.astro";
import ArticleMeta from "../components/blog/ArticleMeta.astro";
import Tag from "../components/ui/Tag.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Encryptor from "../components/blog/Encryptor.astro";
import { Icon } from "astro-icon/components";

import "../styles/expressive-code.css";
import "../styles/encrypted-content.css";

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description: string;
  tags?: string[];
  category?: string;
  cover?: string;
  pinned?: boolean;
  author?: string;
  draft?: boolean;
  abbrlink?: string;
  toc?: boolean;
  comment?: boolean;
  readingTime?: number;
  wordCount?: number;
  headings?: { depth: number; slug: string; text: string }[];
  password?: string;
  hint?: string;
  slug?: string;
}

const { title, date, updated, description, tags, category, cover, author, toc: showToc = true, comment: showComment = true, readingTime, wordCount, headings = [], password, hint, slug } = Astro.props;
const displayUpdated = updated || date;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEncrypted = !!password;
---

<BaseLayout title={title} description={description} image={cover}>
  <JsonLd type="article" title={title} description={description} url={canonicalURL.href} image={cover} datePublished={date.toISOString()} dateModified={displayUpdated.toISOString()} author={author} />

  <div class="article-layout">
    <article class="article">
      {cover && (
        <div class="article__cover">
          <img src={cover} alt={title} loading="eager" decoding="async" />
        </div>
      )}

      <header class="article__header">
        {tags && tags.length > 0 && (
          <div class="article__tags">
            {tags.map((t) => <Tag>{t}</Tag>)}
          </div>
        )}
        <h1 class="article__title">{title}</h1>
        {/* 传 frontmatter 原值而非 displayUpdated —— 后者以 date 兜底，
            会让每篇没写 updated 的文章都并排显示「更新于 <同一天>」。
            兜底语义只对上方 JSON-LD 的 dateModified 有意义。 */}
        <ArticleMeta date={date} updated={updated} category={category} readingTime={readingTime} wordCount={wordCount} />
      </header>

      {isEncrypted ? (
        <Encryptor password={password} slug={slug || ""} hint={hint}>
          <slot />
        </Encryptor>
      ) : (
        <div class="article__content prose custom-md">
          <slot />
        </div>
      )}

      {/* 评论区锚点 — 始终渲染，用于跳转定位 */}
      <div id="comments-anchor" style="height: 0; overflow: hidden;"></div>
      {showComment && <TwikooComments />}
    </article>

    {/* 加密文章不渲染目录：headings 来自 render(post) 的明文结果，
        Encryptor 只加密 slot 正文，目录会把全部小标题以静态 HTML
        暴露给未解锁的访客（搜索引擎同样能索引到）。 */}
    {showToc && !isEncrypted && headings.length > 0 && (
      <aside class="article__sidebar">
        <TOC headings={headings} />
      </aside>
    )}
  </div>

  {/* 浮动操作按钮组 — TOC / 跳评论 / 回顶部
      三个按钮共享 .fab 基类，入场时从右边缘逐个弹入，出场时逐个缩回。
      顺序（自下而上）：回顶部 → 跳评论 → TOC */}
  {showComment && (
    <button class="fab fab--comments" id="jump-comments" aria-label="跳转到评论">
      <Icon name="ph:chat-circle-text" />
    </button>
  )}
  {showToc && !isEncrypted && headings.length > 0 && (
    <button class="fab fab--toc" id="fab-toc" aria-label="文章目录">
      <Icon name="ph:list-bullets" />
    </button>
  )}
  {/* TOC 弹出面板 */}
  <div class="toc-overlay" id="toc-overlay">
    <div class="toc-overlay__panel glass-panel">
      <div class="toc-overlay__header">
        <span class="toc-overlay__title">目录</span>
        <button class="toc-overlay__close" id="toc-overlay-close" aria-label="关闭目录">
          <Icon name="ph:x" />
        </button>
      </div>
      <nav class="toc-overlay__nav">
        {headings.filter(h => h.depth >= 2 && h.depth <= 4).map((h) => (
          <a href={`#${h.slug}`} class={`toc-overlay__link toc-overlay__link--h${h.depth}`}>
            {h.text.replace(/\s*#$/, "").trim()}
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: var(--space-8);
    max-width: calc(var(--content-width) + 250px + var(--space-8));
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .article { max-width: var(--content-width); }

  .article__cover {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article__cover img { width: 100%; height: auto; display: block; border-radius: 0; }

  .article__header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }

  .article__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .article__sidebar { position: relative; }

  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr; }
    .article__sidebar { display: none; }
  }

  @media (max-width: 768px) {
    .article__title { font-size: var(--text-xl); }
  }

  /* ── 浮动操作按钮组（TOC / 跳评论 / 回顶部） ──
     三个 FAB 共享 .fab 基类玻璃 pill 样式。
     动画：入场时从右边缘逐个弹入（自下而上），出场反向。
     Bottom 偏移（自底向上堆叠）：
     - 回顶部 (BackToTop)：--space-10 + 20px
     - 跳评论：+ 44px + --space-2
     - TOC：   + 44px + --space-2 */
  .fab {
    position: fixed;
    right: var(--space-4);
    z-index: 80;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    pointer-events: none;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    transition:
      opacity 0.22s var(--ease-decelerate),
      transform 0.22s var(--ease-decelerate);
  }

  .fab--top { bottom: calc(var(--space-10) + 20px); }
  .fab--comments { bottom: calc(var(--space-10) + 20px + 44px + var(--space-2)); }
  .fab--toc { bottom: calc(var(--space-10) + 20px + 88px + var(--space-4)); }

  .fab:hover {
    color: var(--foreground);
  }

  .fab svg {
    width: 18px;
    height: 18px;
  }

  /* 可见态 —— 从边缘弹入 */
  .fab--visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* 退场态 —— 缩回边缘 */
  .fab--hiding {
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    transition:
      opacity 0.18s var(--ease-accelerate),
      transform 0.18s var(--ease-accelerate);
  }

  /* 出场交错延迟（自上而下消失） */
  .fab--hiding.fab--top { transition-delay: 0s; }
  .fab--hiding.fab--comments { transition-delay: 0.06s; }
  .fab--hiding.fab--toc { transition-delay: 0.12s; }

  /* ── TOC 弹出面板 ── */
  .toc-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-4);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s var(--ease-standard);
  }

  .toc-overlay--open {
    opacity: 1;
    pointer-events: auto;
  }

  .toc-overlay__panel {
    width: min(320px, calc(100vw - var(--space-8)));
    max-height: 60vh;
    padding: var(--space-4);
    overflow-y: auto;
    transform: translateY(12px) scale(0.96);
    transition: transform 0.22s var(--ease-decelerate);
  }

  .toc-overlay--open .toc-overlay__panel {
    transform: translateY(0) scale(1);
  }

  .toc-overlay__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .toc-overlay__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
  }

  .toc-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    color: var(--foreground-muted);
    transition: background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__close:hover {
    background: var(--accent-subtle);
  }

  .toc-overlay__close svg {
    width: 16px;
    height: 16px;
  }

  .toc-overlay__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-overlay__link {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--foreground-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .toc-overlay__link--h3 { padding-left: calc(var(--space-2) + var(--space-4)); }
  .toc-overlay__link--h4 { padding-left: calc(var(--space-2) + var(--space-8)); }

  .toc-overlay__panel::-webkit-scrollbar { width: 4px; }
  .toc-overlay__panel::-webkit-scrollbar-track { background: transparent; }
  .toc-overlay__panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-sm); }

  @media (max-width: 768px) {
    .fab { width: 40px; height: 40px; }
    .fab svg { width: 16px; height: 16px; }
    .fab--top { bottom: calc(var(--space-8) + 16px); }
    .fab--comments { bottom: calc(var(--space-8) + 16px + 40px + var(--space-2)); }
    .fab--toc { bottom: calc(var(--space-8) + 16px + 80px + var(--space-4)); }
  }
</style>

<script>
  /*
   * 浮动操作按钮组管理
   * ─────────────────────────────────────────────────────────
   * 三个 FAB（自下而上）：BackToTop → 跳评论 → TOC
   * 入场：从右边缘逐个弹入，自下而上（BackToTop 最先出现）
   * 出场：缩回右边缘，自上而下（TOC 最先消失）
   */
  let fabMO: MutationObserver | null = null;
  let fabTimer: ReturnType<typeof setTimeout> | null = null;
  const FAB_ENTRANCE_STAGGER = 60; // 每层入场间隔 ms
  const FAB_EXIT_STAGGER = 50;     // 每层出场间隔 ms

  function initFabs() {
    const backToTop = document.getElementById("back-to-top");
    const jumpComments = document.getElementById("jump-comments");
    const fabToc = document.getElementById("fab-toc");
    const tocOverlay = document.getElementById("toc-overlay");
    const tocClose = document.getElementById("toc-overlay-close");

    if (!backToTop || (backToTop as HTMLElement).dataset.fabInit) return;
    (backToTop as HTMLElement).dataset.fabInit = "1";

    // 按距离底部的顺序排列（最近的先出现）
    const fabs = [backToTop, jumpComments, fabToc].filter(Boolean) as HTMLElement[];

    let visible = false;

    function showFabs() {
      if (visible) return;
      visible = true;
      if (fabTimer) clearTimeout(fabTimer);
      fabs.forEach((fab, i) => {
        setTimeout(() => {
          fab.classList.remove("fab--hiding");
          fab.classList.add("fab--visible");
        }, i * FAB_ENTRANCE_STAGGER);
      });
    }

    function hideFabs() {
      if (!visible) return;
      visible = false;
      if (fabTimer) clearTimeout(fabTimer);
      // 关闭 TOC 面板（如果打开着）
      if (tocOverlay) tocOverlay.classList.remove("toc-overlay--open");
      // 自上而下消失（index 反转）
      fabs.forEach((fab, i) => {
        setTimeout(() => {
          fab.classList.remove("fab--visible");
          fab.classList.add("fab--hiding");
          // 动画完成后清除 hiding 类，避免下次入场冲突
          setTimeout(() => fab.classList.remove("fab--hiding"), 200);
        }, (fabs.length - 1 - i) * FAB_EXIT_STAGGER);
      });
    }

    // 监听 BackToTop 的可见性变化（由 GlobalScripts 控制）
    fabMO?.disconnect();
    fabMO = new MutationObserver(() => {
      if (backToTop.classList.contains("fab--visible")) {
        showFabs();
      } else {
        hideFabs();
      }
    });
    fabMO.observe(backToTop, { attributes: true, attributeFilter: ["class"] });

    // 初始同步
    if (backToTop.classList.contains("fab--visible")) {
      showFabs();
    }

    // 跳评论按钮点击
    jumpComments?.addEventListener("click", () => {
      const target = document.getElementById("comments-anchor") || document.getElementById("twikoo");
      target?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    // TOC 面板 开/关
    if (fabToc && tocOverlay) {
      fabToc.addEventListener("click", () => {
        tocOverlay.classList.toggle("toc-overlay--open");
      });

      tocClose?.addEventListener("click", () => {
        tocOverlay.classList.remove("toc-overlay--open");
      });

      // 点击遮罩层关闭
      tocOverlay.addEventListener("click", (e) => {
        if (e.target === tocOverlay) {
          tocOverlay.classList.remove("toc-overlay--open");
        }
      });

      // 点击 TOC 链接 → 关闭面板 + 平滑滚动
      tocOverlay.querySelectorAll(".toc-overlay__link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          tocOverlay.classList.remove("toc-overlay--open");
          const id = (link as HTMLAnchorElement).getAttribute("href")?.slice(1);
          const target = id ? document.getElementById(id) : null;
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      // ESC 关闭
      document.addEventListener("keydown", function onEsc(e) {
        if (e.key === "Escape" && tocOverlay.classList.contains("toc-overlay--open")) {
          tocOverlay.classList.remove("toc-overlay--open");
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initFabs);
  document.addEventListener("astro:page-load", initFabs);
</script>
