---
/**
 * 文章布局
 * BaseLayout + .prose + TOC + ArticleMeta + Tag + 加密支持
 */
import BaseLayout from "./BaseLayout.astro";
import TOC from "../components/blog/TOC.astro";
import ArticleMeta from "../components/blog/ArticleMeta.astro";
import Tag from "../components/ui/Tag.astro";
import ArtalkComments from "../components/blog/ArtalkComments.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Encryptor from "../components/blog/Encryptor.astro";
import ArticleFooter from "../components/blog/ArticleFooter.astro";
import { Icon } from "astro-icon/components";
import { commentConfig } from "../config/comment";

import "../styles/expressive-code.css";
import "../styles/encrypted-content.css";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description: string;
  tags?: string[];
  category?: string;
  cover?: string;
  pinned?: boolean;
  author?: string;
  draft?: boolean;
  abbrlink?: string;
  toc?: boolean;
  comment?: boolean;
  readingTime?: number;
  wordCount?: number;
  headings?: { depth: number; slug: string; text: string }[];
  password?: string;
  hint?: string;
  slug?: string;
  contentPath?: string;
  share?: boolean;
  license?: false | { name: string; url: string };
}

const { title, date, updated, description, tags, category, cover, author, toc: showToc = true, comment: showComment = true, readingTime, wordCount, headings = [], password, hint, slug, contentPath, share = true, license } = Astro.props;
const displayUpdated = updated || date;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isEncrypted = !!password;
const commentsEnabled = showComment && commentConfig.enabled;
const hasToc = showToc && !isEncrypted && headings.length > 0;
---

<BaseLayout title={title} description={description} image={cover}>
  <JsonLd type="article" title={title} description={description} url={canonicalURL.href} image={cover} datePublished={date.toISOString()} dateModified={displayUpdated.toISOString()} author={author} />

  <div class="article-layout">
    <article class="article glass-panel" data-pagefind-body={!isEncrypted ? true : undefined}>
      {cover && (
        <div class="article__cover">
          <img src={cover} alt={title} loading="eager" decoding="async" />
        </div>
      )}

      <header class="article__header">
        {tags && tags.length > 0 && (
          <div class="article__tags">
            {tags.map((t) => <Tag>{t}</Tag>)}
          </div>
        )}
        <h1 class="article__title" data-pagefind-meta="title">{title}</h1>
        {category && <span hidden data-pagefind-filter={`category:${category.trim()}`}>{category.trim()}</span>}
        {(tags ?? []).map((tag) => <span hidden data-pagefind-filter={`tag:${tag}`}>{tag}</span>)}
        {/* 传 frontmatter 原值而非 displayUpdated —— 后者以 date 兜底，
            会让每篇没写 updated 的文章都并排显示「更新于 <同一天>」。
            兜底语义只对上方 JSON-LD 的 dateModified 有意义。 */}
        <ArticleMeta date={date} updated={updated} category={category} readingTime={readingTime} wordCount={wordCount} />
      </header>

      {isEncrypted ? (
        <Encryptor password={password} slug={slug || ""} hint={hint}>
          <slot />
        </Encryptor>
      ) : (
        <div class="article__content prose custom-md">
          <slot />
        </div>
      )}

      <ArticleFooter
        title={title}
        description={description}
        date={date}
        updated={updated}
        cover={cover}
        author={author}
        slug={slug || ""}
        contentPath={contentPath}
        share={share}
        license={license}
      />

      {commentsEnabled && <ArtalkComments />}
    </article>

    {/* 加密文章不渲染目录：headings 来自 render(post) 的明文结果，
        Encryptor 只加密 slot 正文，目录会把全部小标题以静态 HTML
        暴露给未解锁的访客（搜索引擎同样能索引到）。 */}
    {hasToc && (
      <aside class="article__sidebar">
        <TOC headings={headings} />
      </aside>
    )}
  </div>

  {/* 浮动操作按钮组 — TOC / 评论 / 回顶部 */}
  {commentsEnabled && (
    <button class="fab fab--comments" id="fab-comments" aria-label="跳转到评论">
      <Icon name="fa7-solid:comment-dots" />
    </button>
  )}
  {hasToc && (
    <button
      class="fab fab--toc"
      id="fab-toc"
      aria-label="文章目录"
      aria-haspopup="dialog"
      aria-controls="toc-overlay"
      aria-expanded="false"
    >
      <Icon name="fa7-solid:list" />
    </button>
  )}
  {/* TOC 弹出面板 — 原生 dialog 提供焦点隔离与 Esc；无标题时不渲染 */}
  {hasToc && (
    <dialog class="toc-overlay" id="toc-overlay" aria-labelledby="toc-overlay-title">
      <div class="toc-overlay__panel glass-panel">
        <div class="toc-overlay__header">
          <span class="toc-overlay__title" id="toc-overlay-title">目录</span>
          <button class="toc-overlay__close" id="toc-overlay-close" aria-label="关闭目录">
            <Icon name="fa7-solid:xmark" />
          </button>
        </div>
        <nav class="toc-overlay__nav" aria-label="文章目录">
          {headings.filter(h => h.depth >= 2 && h.depth <= 4).map((h) => (
            <a href={`#${h.slug}`} class={`toc-overlay__link toc-overlay__link--h${h.depth}`}>
              {h.text.replace(/\s*#$/, "").trim()}
            </a>
          ))}
        </nav>
      </div>
    </dialog>
  )}
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--post-content-width)) 250px;
    gap: var(--space-8);
    max-width: calc(var(--post-content-width) + 250px + var(--space-8) + var(--space-8));
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .article {
    --prose-width: var(--post-content-width);
    width: 100%;
    max-width: var(--post-content-width);
    min-width: 0;
    padding: var(--space-6);
  }

  .article__cover {
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .article__cover img { width: 100%; height: auto; display: block; border-radius: 0; }

  .article__header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .article__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }

  .article__title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .article__sidebar { position: relative; }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(var(--post-content-width) + var(--space-8));
    }
    .article__sidebar { display: none; }
  }

  @media (max-width: 768px) {
    .article { padding: var(--space-4); }
    .article__title { font-size: var(--text-xl); }
  }

  /* ── 浮动操作按钮组（TOC / 跳评论 / 回顶部） ──
     动画：入场时从右边缘逐个弹入（自下而上），出场反向。
     Bottom 偏移（自底向上堆叠）：
     - 回顶部 (BackToTop)：--space-10 + 20px
     - 评论：+ 44px + --space-2
     - TOC：+ 88px + --space-4 */
  .fab {
    position: fixed;
    right: var(--space-4);
    z-index: 80;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    pointer-events: none;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    transition:
      opacity 0.22s var(--ease-decelerate),
      transform 0.22s var(--ease-decelerate);
  }

  .fab--top { bottom: calc(var(--space-10) + 20px); }
  .fab--comments { bottom: calc(var(--space-10) + 20px + 44px + var(--space-2)); }
  .fab--toc { bottom: calc(var(--space-10) + 20px + 88px + var(--space-4)); }

  .fab:hover {
    color: var(--foreground);
  }

  .fab svg {
    width: 18px;
    height: 18px;
  }

  /* 可见态 —— 从边缘弹入。
     错峰全部交给 transition-delay（不再用 JS 定时器）：
     入场自下而上（回顶 → 评论 → TOC），退场自上而下（TOC → 评论）。 */
  .fab--visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .fab--comments.fab--visible { transition-delay: 60ms; }
  .fab--toc.fab--visible { transition-delay: 120ms; }
  .fab--comments:not(.fab--visible) { transition-delay: 50ms; }
  .fab--toc:not(.fab--visible) { transition-delay: 0ms; }

  /* ── TOC 弹出面板（原生 dialog） ── */
  .toc-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    padding: var(--space-4);
    opacity: 0;
    transition: opacity 0.18s var(--ease-standard);
  }

  .toc-overlay[open] {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .toc-overlay::backdrop { background: transparent; }

  .toc-overlay--open {
    opacity: 1;
  }

  .toc-overlay__panel {
    width: min(320px, calc(100vw - var(--space-8)));
    max-height: 60vh;
    padding: var(--space-4);
    overflow-y: auto;
    transform: translateY(12px) scale(0.96);
    transition: transform 0.22s var(--ease-decelerate);
  }

  .toc-overlay--open .toc-overlay__panel {
    transform: translateY(0) scale(1);
  }

  .toc-overlay__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .toc-overlay__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
  }

  .toc-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    color: var(--foreground-muted);
    transition: background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__close:hover {
    background: var(--accent-subtle);
  }

  .toc-overlay__close svg {
    width: 16px;
    height: 16px;
  }

  .toc-overlay__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-overlay__link {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--foreground-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .toc-overlay__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .toc-overlay__link--h3 { padding-left: calc(var(--space-2) + var(--space-4)); }
  .toc-overlay__link--h4 { padding-left: calc(var(--space-2) + var(--space-8)); }

  .toc-overlay__panel::-webkit-scrollbar { width: 4px; }
  .toc-overlay__panel::-webkit-scrollbar-track { background: transparent; }
  .toc-overlay__panel::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-sm); }

  @media (max-width: 768px) {
    /* 与 BackToTop 的移动端 right 对齐，三个按钮保持同一竖线 */
    .fab { right: var(--space-3); width: 40px; height: 40px; }
    .fab svg { width: 16px; height: 16px; }
    .fab--top { bottom: calc(var(--space-8) + 16px); }
    .fab--comments { bottom: calc(var(--space-8) + 16px + 40px + var(--space-2)); }
    .fab--toc { bottom: calc(var(--space-8) + 16px + 80px + var(--space-4)); }
  }
</style>

<script>
  /*
   * 浮动操作按钮组管理
   * ─────────────────────────────────────────────────────────
   * 三个 FAB（自下而上）：BackToTop → 跳评论 → TOC
   * 错峰动画全部通过 CSS transition-delay 实现，避免 JS 定时器竞争。
   * TOC 浮层采用原生 <dialog>，自带 Esc 关闭与焦点隔离。
   */
  let fabMO: MutationObserver | null = null;
  let tocCloseTimer = 0;

  function openTocDialog(tocOverlay: HTMLDialogElement, fabToc: HTMLElement) {
    window.clearTimeout(tocCloseTimer);
    if (!tocOverlay.open) tocOverlay.showModal();
    fabToc.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => tocOverlay.classList.add("toc-overlay--open"));
  }

  function closeTocDialog(tocOverlay: HTMLDialogElement, fabToc?: HTMLElement | null) {
    if (!tocOverlay.open) return;
    tocOverlay.classList.remove("toc-overlay--open");
    fabToc?.setAttribute("aria-expanded", "false");
    window.clearTimeout(tocCloseTimer);
    tocCloseTimer = window.setTimeout(() => {
      if (tocOverlay.open) tocOverlay.close();
    }, 180);
  }

  function initFabs() {
    const backToTop = document.getElementById("back-to-top");
    const fabComments = document.getElementById("fab-comments");
    const fabToc = document.getElementById("fab-toc");
    const tocOverlay = document.getElementById("toc-overlay");
    const tocClose = document.getElementById("toc-overlay-close");

    if (!backToTop || (backToTop as HTMLElement).dataset.fabInit) return;
    (backToTop as HTMLElement).dataset.fabInit = "1";

    const extraFabs = [fabComments, fabToc].filter(Boolean) as HTMLElement[];

    function syncFabs() {
      const visible = backToTop!.classList.contains("fab--visible");
      extraFabs.forEach((fab) => fab.classList.toggle("fab--visible", visible));
      if (!visible && tocOverlay instanceof HTMLDialogElement) {
        closeTocDialog(tocOverlay, fabToc);
      }
    }

    // 监听 BackToTop 的可见性变化（由 GlobalScripts 控制）
    fabMO?.disconnect();
    fabMO = new MutationObserver(syncFabs);
    fabMO.observe(backToTop, { attributes: true, attributeFilter: ["class"] });

    // 初始同步
    syncFabs();

    // TOC 面板 开/关
    if (fabToc && tocOverlay instanceof HTMLDialogElement) {
      fabToc.addEventListener("click", () => {
        if (tocOverlay.open) {
          closeTocDialog(tocOverlay, fabToc);
        } else {
          openTocDialog(tocOverlay, fabToc);
        }
      });

      tocClose?.addEventListener("click", () => {
        closeTocDialog(tocOverlay, fabToc);
      });

      // 点击遮罩层关闭
      tocOverlay.addEventListener("click", (e) => {
        if (e.target === tocOverlay) {
          closeTocDialog(tocOverlay, fabToc);
        }
      });

      // 拦截 Esc 默认瞬间关闭，改走淡出动画
      tocOverlay.addEventListener("cancel", (e) => {
        e.preventDefault();
        closeTocDialog(tocOverlay, fabToc);
      });

      tocOverlay.addEventListener("close", () => {
        fabToc.setAttribute("aria-expanded", "false");
        tocOverlay.classList.remove("toc-overlay--open");
      });

      // 点击 TOC 链接 → 关闭面板 + 平滑滚动
      tocOverlay.querySelectorAll(".toc-overlay__link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          closeTocDialog(tocOverlay, fabToc);
          const id = (link as HTMLAnchorElement).getAttribute("href")?.slice(1);
          const target = id ? document.getElementById(id) : null;
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    }

    fabComments?.addEventListener("click", () => {
      document.getElementById("comments")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  document.addEventListener("DOMContentLoaded", initFabs);
  document.addEventListener("astro:page-load", initFabs);
</script>
