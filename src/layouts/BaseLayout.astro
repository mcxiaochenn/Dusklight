---
/**
 * 全局 Shell 布局
 * ─────────────────────────────────────────────────
 * 每个页面的骨架。Header + 内容 + Footer + ScrollProgress + BackToTop。
 * 页面只提供 <slot /> 内容，Shell 元素全局统一。
 */
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import ScrollProgress from "../components/common/ScrollProgress.astro";
import BackToTop from "../components/common/BackToTop.astro";
import SiteBackdrop from "../components/common/SiteBackdrop.astro";
import GlobalScripts from "../components/common/GlobalScripts.astro";
import AntiMirror from "../components/common/AntiMirror.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/twikoo.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead title={title} description={description} image={image} />
    <AntiMirror />
    <ClientRouter />
    <script defer src="https://umami.mcxiaochen.top/script.js" data-website-id="9b066975-f44d-4b3c-bd7a-7077c58e2bdd"></script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">跳转到主要内容</a>
    <SiteBackdrop />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <ScrollProgress />
    <BackToTop />
    <GlobalScripts />
  </body>
</html>

<style>
  main {
    min-height: calc(100dvh - var(--header-height));
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 200;
    padding: var(--space-2) var(--space-4);
    background: var(--accent);
    color: var(--surface-0);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: top var(--duration-fast) var(--ease-material);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
