---
/**
 * 追番页 — 数据来自 scripts/update-anime.mjs 构建期拉取的
 * src/data/bilibili-data.json（gitignored，缺失时空态提示）
 */
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

interface AnimeItem {
  title: string;
  status: "watching" | "completed" | "planned";
  rating: number;
  cover: string;
  year: string;
  studio: string;
  link: string;
  progress: number;
  totalEpisodes: number;
  progressPercent: number;
}

// 必须以 process.cwd()（项目根）定位 —— import.meta.url 在构建后指向
// dist/chunks/ 的编译产物，相对路径会解析到不存在的位置
const DATA_FILE = resolve(process.cwd(), "src/data/bilibili-data.json");
let animeList: AnimeItem[] = [];
if (existsSync(DATA_FILE)) {
  try {
    animeList = JSON.parse(readFileSync(DATA_FILE, "utf-8"));
  } catch (err) {
    // 必须留痕：文件存在却解析失败（写入中断、内容损坏）时，页面表现与
    // 「从未抓取过」完全一致，构建日志静默无差别，排查会被引向 update-anime.mjs
    // 的抓取逻辑，而真正的问题是数据文件本身已损坏
    console.warn(`⚠️  bilibili-data.json 解析失败，追番页将显示空态: ${err instanceof Error ? err.message : err}`);
    animeList = [];
  }
}

const groups = (
  [
    ["watching", "在看", "ph:play-circle"],
    ["completed", "看完", "ph:check-circle"],
    ["planned", "想看", "ph:bookmark-simple"],
  ] as const
)
  .map(([key, label, icon]) => ({
    key,
    label,
    icon,
    list: animeList.filter((a) => a.status === key),
  }))
  .filter((g) => g.list.length > 0);
---

<BaseLayout title="我的追番" description="B 站追番记录">
  <section class="section">
    <div class="page-container">
      <header class="anime__header">
        <h1 class="anime__title">我的追番</h1>
        <p class="anime__subtitle">
          {animeList.length > 0 ? `共 ${animeList.length} 部 · 数据来自 Bilibili` : "追番数据"}
        </p>
      </header>

      {animeList.length === 0 && (
        <p class="anime__empty">
          构建时未获取到追番数据（B 站接口可能临时不可用），稍后重新构建即可。
        </p>
      )}

      {groups.map((g) => (
        <div class="anime__group">
          <h2 class="anime__group-title">
            <Icon name={g.icon} />
            {g.label}
            <span class="anime__count">{g.list.length}</span>
          </h2>
          <div class="anime__grid">
            {g.list.map((a) => (
              <a href={a.link} target="_blank" rel="noopener noreferrer" class="anime-card" title={a.title}>
                <div class="anime-card__cover">
                  {a.cover && (
                    <img src={a.cover} alt={a.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  )}
                  {a.rating > 0 && <span class="anime-card__rating">{a.rating}</span>}
                  {a.status === "watching" && a.totalEpisodes > 0 && (
                    <span class="anime-card__progress" style={`--p: ${a.progressPercent}%`}></span>
                  )}
                </div>
                <span class="anime-card__name">{a.title}</span>
                <span class="anime-card__meta">
                  {a.year}{a.year && a.studio && " · "}{a.studio}
                  {a.status === "watching" && a.totalEpisodes > 0 && ` · ${a.progress}/${a.totalEpisodes}`}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .anime__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .anime__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }

  .anime__subtitle {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
  }

  .anime__empty {
    text-align: center;
    color: var(--foreground-muted);
    padding: var(--space-10) 0;
  }

  .anime__group {
    margin-bottom: var(--space-10);
  }

  .anime__group-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--foreground);
    margin: 0 0 var(--space-4);
  }

  .anime__group-title [data-icon] {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }

  .anime__count {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    background: oklch(from var(--accent) l c h / 0.12);
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
  }

  .anime__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-4);
  }

  .anime-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }

  .anime-card__cover {
    position: relative;
    aspect-ratio: 11 / 14;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition: transform var(--duration-fast) var(--ease-material),
                box-shadow var(--duration-fast) var(--ease-material);
  }

  .anime-card:hover .anime-card__cover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .anime-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .anime-card__rating {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
    background: oklch(0.2 0.02 var(--hue) / 0.75);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: oklch(0.9 0.1 85);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .anime-card__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: oklch(0 0 0 / 0.35);
  }

  .anime-card__progress::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--p, 0%);
    background: var(--accent);
  }

  .anime-card__name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-card__meta {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }
</style>
