---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout title="即将离开本站" description="外部链接安全提示" robots="noindex,nofollow">
  <section class="redirect-page">
    <div class="redirect-card glass-panel" data-redirect-root data-countdown-seconds={siteConfig.externalRedirect.countdownSeconds}>
      <span class="redirect-card__icon icon-[fa7-solid--arrow-up-right-from-square]" aria-hidden="true"></span>
      <p class="redirect-card__eyebrow">外部链接</p>
      <h1>即将离开本站</h1>
      <p class="redirect-card__message" data-redirect-message>正在检查目标地址……</p>
      <code class="redirect-card__url" data-redirect-url>—</code>
      <p class="redirect-card__countdown" data-redirect-countdown hidden></p>
      <div class="redirect-card__actions">
        <button class="redirect-card__button redirect-card__button--primary" data-redirect-continue disabled>立即访问</button>
        <button class="redirect-card__button" data-redirect-back>返回上一页</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .redirect-page { min-height: calc(100dvh - var(--header-height)); display: grid; place-items: center; padding: var(--space-8) var(--space-4); }
  .redirect-card { width: min(560px, 100%); padding: var(--space-8); text-align: center; border-radius: var(--radius-xl); }
  .redirect-card__icon { display: inline-block; width: 40px; height: 40px; color: var(--accent); margin-bottom: var(--space-3); }
  .redirect-card__eyebrow { margin: 0 0 var(--space-2); color: var(--accent); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-wide); }
  h1 { margin: 0 0 var(--space-3); font-size: var(--text-xl); }
  .redirect-card__message, .redirect-card__countdown { color: var(--foreground-secondary); }
  .redirect-card__url { display: block; max-height: 8rem; margin: var(--space-5) 0; padding: var(--space-3); overflow: auto; color: var(--foreground); overflow-wrap: anywhere; }
  .redirect-card__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .redirect-card__button { min-height: 42px; padding: 0 var(--space-5); border: 1px solid var(--glass-border); border-radius: var(--radius-md); color: var(--foreground); background: var(--glass-bg); cursor: pointer; }
  .redirect-card__button--primary { color: var(--surface-0); background: var(--accent); border-color: var(--accent); }
  .redirect-card__button:disabled { opacity: .5; cursor: not-allowed; }
  @media (max-width: 520px) { .redirect-card { padding: var(--space-6) var(--space-4); } .redirect-card__actions { flex-direction: column; } }
</style>

<script>
  let redirectTimer: number | undefined;

  const clearRedirectTimer = () => {
    if (redirectTimer !== undefined) {
      window.clearInterval(redirectTimer);
      redirectTimer = undefined;
    }
  };

  const initRedirectPage = () => {
    clearRedirectTimer();
    const root = document.querySelector("[data-redirect-root]");
    if (!(root instanceof HTMLElement)) return;

    const urlEl = root.querySelector<HTMLElement>("[data-redirect-url]");
    const messageEl = root.querySelector<HTMLElement>("[data-redirect-message]");
    const countdownEl = root.querySelector<HTMLElement>("[data-redirect-countdown]");
    const continueButton = root.querySelector<HTMLButtonElement>("[data-redirect-continue]");
    const backButton = root.querySelector<HTMLButtonElement>("[data-redirect-back]");
    if (!urlEl || !messageEl || !countdownEl || !continueButton || !backButton) return;

    const decode = (value: string) => {
      const base64 = value.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(value.length / 4) * 4, "=");
      const bytes = Uint8Array.from(atob(base64), (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    };

    const goBack = () => history.length > 1 ? history.back() : location.assign("/");
    backButton.addEventListener("click", goBack, { once: true });

    const params = new URLSearchParams(location.search);
    let target: URL;
    try {
      target = new URL(decode(params.get("url") || ""));
      if (target.protocol !== "http:" && target.protocol !== "https:") throw new Error("protocol");
    } catch {
      messageEl.textContent = "目标地址无效，已阻止跳转。";
      urlEl.textContent = "无效链接";
      return;
    }

    urlEl.textContent = target.href;
    continueButton.disabled = false;
    continueButton.addEventListener("click", () => location.assign(target.href), { once: true });

    messageEl.textContent = "即将前往外部网站，请确认目标地址。";
    countdownEl.hidden = false;
    let remaining = Number(root.dataset.countdownSeconds) || 5;
    const render = () => countdownEl.textContent = `${remaining} 秒后自动继续`;
    render();
    redirectTimer = window.setInterval(() => {
      remaining -= 1;
      render();
      if (remaining <= 0) {
        clearRedirectTimer();
        location.assign(target.href);
      }
    }, 1000);
  };

  document.addEventListener("astro:page-load", initRedirectPage);
  document.addEventListener("astro:before-swap", clearRedirectTimer);
</script>
