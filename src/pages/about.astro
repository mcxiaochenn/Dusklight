---
/**
 * 关于页面 — 借鉴 Heo About 的信息层级，保留 Dusklight 玻璃视觉。
 * 结构：头像标签 → 问候/关键词 → 技能 → 性格/追番 → 游戏/站点资料
 *       → 访问统计/selfInfo → 关于我 → 打赏 → 评论区
 * 数据全部来自 profileConfig。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config/profile";
import { siteConfig } from "../config/site";
import { skillsData } from "@/data/skills";
import { getSortedSponsors } from "@/data/sponsors";

const sponsors = getSortedSponsors();
const sortedSponsors = [...sponsors].sort((a, b) => {
  const na = parseFloat(a.amount.replace(/[^0-9.]/g, "")) || 0;
  const nb = parseFloat(b.amount.replace(/[^0-9.]/g, "")) || 0;
  return nb - na;
});
---

<BaseLayout title="关于" description={`关于 ${profileConfig.name}`}>
  <section class="about section" id="about-page">
    <div class="page-container">

      {/* ── author-box：头像 + 两侧漂浮标签 ── */}
      <div class="about-author-box">
        <div class="about-author-tag-left">
          {profileConfig.authorTags.map((tag, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{tag.left}</span>
          ))}
        </div>
        <div class="about-author-img">
          <img src={profileConfig.avatar} alt={profileConfig.name} loading="lazy" decoding="async" />
        </div>
        <div class="about-author-tag-right">
          {profileConfig.authorTags.map((tag, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{tag.right}</span>
          ))}
        </div>
      </div>

      {/* ── 问候卡(59%) + 关键词轮播(39%) ── */}
      <div class="about-row">
        <div class="about-item about-item--hello">
          <div class="about-card-tips">你好呀</div>
          <h1 class="about-hello-title">
            我是 <span class="about-inline-word">{profileConfig.helloName}</span>
          </h1>
          <div class="about-card-tips">{profileConfig.intro}</div>
        </div>

        <div class="about-item about-item--tips">
          <div class="about-card-tips">{profileConfig.aboutsiteTips.tips}</div>
          <h2 class="about-tips-heading">
            {profileConfig.aboutsiteTips.title1}
            <br />
            {profileConfig.aboutsiteTips.title2}
            <div class="about-tips-mask" id="about-tips-mask">
              {profileConfig.aboutsiteTips.words.map((w, i) => (
                <span class:list={["about-tips-word", { "first-tips": i === 0 }]} data-show={i === 0 ? "" : undefined}>
                  {w}
                </span>
              ))}
            </div>
          </h2>
        </div>
      </div>

      {/* ── 技能墙（全宽） ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--skills">
          <div class="about-card-tips">{profileConfig.skillsTips}</div>
          <span class="about-item-title">{profileConfig.skillsTitle}</span>
          <div class="about-skill-wall">
            {skillsData.map((s) => (
              <a href="/skills/" class="about-skill-icon" title={s.name}>
                <Icon name={s.icon} />
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ── 性格 + 喜欢的番 ── */}
      <div class="about-row">
        <div class="about-item about-item--personality">
          <div class="about-card-tips">性格</div>
          <span class="about-item-title">{profileConfig.mbtiTitle}</span>
          <div class="about-mbti" style="color: var(--accent)">{profileConfig.mbti}</div>
          <p class="about-mbti-desc">{profileConfig.mbtiDesc}</p>
          <a
            class="about-personality-link"
            href={profileConfig.mbtiUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            了解逻辑学家人格档案
          </a>
          <div class="about-personality-img">
            <img src={profileConfig.personalityImage} alt="INTP-T 逻辑学家人物" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="about-item about-item--comic">
          <div class="about-card-tips about-comic-tips">爱好番剧</div>
          <span class="about-item-title about-comic-title">追番</span>
          <div class="about-comic-box">
            {profileConfig.favorites.anime.map((a) => (
              <div class="about-comic-item" title={a.name}>
                <div class="about-comic-cover">
                  <img src={a.image} alt={a.name} loading="lazy" decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ── 喜欢的游戏 + 站点资料 ── */}
      <div class="about-row">
        <div class="about-item about-item--comic about-item--game">
          <div class="about-card-tips about-comic-tips">喜欢的游戏</div>
          <span class="about-item-title about-comic-title">游戏</span>
          <div class="about-comic-box">
            {profileConfig.favorites.games.map((g) => (
              <div class:list={["about-comic-item", { "about-comic-item--landscape": "landscape" in g && g.landscape }]} title={g.name}>
                <div class="about-comic-cover">
                  <img src={g.image} alt={g.name} loading="lazy" decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="about-item about-item--cards">
          {profileConfig.siteCards.map((card) => (
            <div class="about-card-block">
              <h3 class="about-card-block-title">
                <Icon name={card.icon} /> {card.title}
              </h3>
              {card.body && (
                <div class="about-card-block-body">
                  {card.body.split("\n\n").map((para) => <p>{para}</p>)}
                </div>
              )}
              {card.links && (
                <ul class="about-card-block-links">
                  {card.links.map((l) => (
                    <li>
                      {l.href ? (
                        <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>{l.text}</a>
                      ) : (
                        <span>{l.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      {/* ── 访问统计 + 横向个人信息 ── */}
      <div class="about-row about-row--data">
        <div class="about-item about-item--statistics" data-api={siteConfig.analytics.apiUrl}>
          <div class="about-card-tips">数据</div>
          <span class="about-item-title">访问统计</span>
          <dl class="about-statistics-grid" aria-label="站点访问统计">
            <div><dt>今日人数</dt><dd data-visit-stat="today_uv">—</dd></div>
            <div><dt>今日访问</dt><dd data-visit-stat="today_pv">—</dd></div>
            <div><dt>昨日人数</dt><dd data-visit-stat="yesterday_uv">—</dd></div>
            <div><dt>昨日访问</dt><dd data-visit-stat="yesterday_pv">—</dd></div>
            <div><dt>最近月访问</dt><dd data-visit-stat="last_month_pv">—</dd></div>
            <div><dt>总访问</dt><dd data-visit-stat="total_pv">—</dd></div>
          </dl>
          <p class="about-statistics-error" role="status" hidden>统计暂时无法加载</p>
        </div>

        <div class="about-item about-item--selfinfo">
          {profileConfig.selfInfo.map((item) => (
            <div class="about-selfinfo-item" style={`--selfinfo-accent: ${item.accent}`}>
              <span class="about-selfinfo-icon" aria-hidden="true"><Icon name={item.icon} /></span>
              <span class="about-selfinfo-value">{item.value}</span>
              <span class="about-selfinfo-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      {/* ── 关于我（全宽，打赏上方） ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--aboutme">
          <h2 class="about-card-block-title about-card-block-title--aboutme">
            <Icon name={profileConfig.aboutMe.icon} /> {profileConfig.aboutMe.title}
          </h2>
          <div class="about-card-block-body about-card-block-body--aboutme">
            {profileConfig.aboutMe.body.split("\n\n").map((para) => <p>{para}</p>)}
          </div>
        </div>
      </div>

      {/* ── 致谢 reward 卡（全宽）+ 打赏 ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--reward" id="about-reward">
          <div class="about-card-tips">感谢</div>
          <span class="about-item-title">打赏名单</span>
          <p class="about-reward-desc">感谢每一位支持者的慷慨解囊，你们的支持是我持续创作最大的动力 ❤️</p>
          <div class="about-reward-list">
            {sortedSponsors.length > 0 ? sortedSponsors.map((s) => (
              <div class="about-reward-item">
                <span class="about-reward-name">{s.name}</span>
                <div class="about-reward-bottom">
                  <span class="about-reward-amount" class:list={parseFloat(s.amount.replace(/[^0-9.]/g, "") || "0") >= 50 && "about-reward-amount--hl"}>
                    {s.amount}
                  </span>
                  <span class="about-reward-time">{s.date}</span>
                </div>
              </div>
            )) : (
              <p class="about-reward-empty">还没有赞助记录，第一个支持者就是你~</p>
            )}
          </div>
          <div class="about-reward-actions">
            <button class="about-donate-btn" id="btn-donate">
              <Icon name="ph:coffee" /> 打赏作者
            </button>
          </div>
        </div>
      </div>

      {/* ── 评论区 ── */}
      <div class="about-comments">
        <TwikooComments />
      </div>

    </div>
  </section>

  {/* ── 打赏二维码弹层 ── */}
  <div class="donate-modal" id="donate-modal">
    <div class="donate-modal__backdrop" id="donate-modal-backdrop"></div>
    <div class="donate-modal__card glass-panel">
      <div class="donate-modal__header">
        <span class="donate-modal__title">打赏作者</span>
        <button class="donate-modal__close" id="donate-modal-close" aria-label="关闭">
          <Icon name="ph:x" />
        </button>
      </div>
      <p class="donate-modal__sub">扫描二维码，请小尘喝杯咖啡 ☕</p>
      <div class="donate-modal__qrs">
        <figure class="donate-modal__qr">
          <img src="/sponsors/wechat.svg" alt="微信收款码" loading="lazy" />
          <figcaption>微信</figcaption>
        </figure>
        <figure class="donate-modal__qr">
          <img src="/sponsors/alipay.svg" alt="支付宝收款码" loading="lazy" />
          <figcaption>支付宝</figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  let tipsTimer: number | undefined;
  let activeTipsMask: HTMLElement | null = null;

  /* 关键词轮播动画（anheyu aboutsiteTips 遮罩） */
  function initTipsCarousel() {
    const mask = document.getElementById("about-tips-mask");
    if (mask === activeTipsMask && tipsTimer !== undefined) return;

    if (tipsTimer !== undefined) {
      window.clearInterval(tipsTimer);
      tipsTimer = undefined;
    }
    activeTipsMask = mask;
    if (!mask) return;

    const words = Array.from(mask.querySelectorAll(".about-tips-word"));
    if (words.length < 2) return;
    let idx = 0;

    function next() {
      const cur = words[idx % words.length];
      const nxt = words[(idx + 1) % words.length];
      cur?.removeAttribute("data-show");
      cur?.removeAttribute("data-up");
      cur?.setAttribute("data-up", "");
      nxt?.removeAttribute("data-up");
      nxt?.setAttribute("data-show", "");
      idx++;
    }

    tipsTimer = window.setInterval(next, 2000);
  }

  /* 打赏弹层开关 */
  function initDonateModal() {
    const modal = document.getElementById("donate-modal");
    const btn = document.getElementById("btn-donate");
    const close = document.getElementById("donate-modal-close");
    const backdrop = document.getElementById("donate-modal-backdrop");
    if (!modal || !btn || modal.dataset.donateInit === "1") return;
    modal.dataset.donateInit = "1";

    function open() { modal.classList.add("open"); modal.classList.add("visible"); }
    function closeModal() {
      modal.classList.remove("visible");
      setTimeout(() => modal.classList.remove("open"), 200);
    }
    btn.addEventListener("click", open);
    close?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);
  }

  /* 访问统计：页面切换后的新 DOM 会重新请求，单个卡片只初始化一次。 */
  async function initVisitStats() {
    const card = document.querySelector<HTMLElement>(".about-item--statistics");
    if (!card || card.dataset.statisticsInit === "1") return;
    card.dataset.statisticsInit = "1";

    const keys = [
      "today_uv",
      "today_pv",
      "yesterday_uv",
      "yesterday_pv",
      "last_month_pv",
      "total_pv",
    ];

    try {
      const response = await fetch(card.dataset.api ?? "");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();

      keys.forEach((key) => {
        const value = Number(data[key]);
        if (!Number.isFinite(value)) throw new Error(`Invalid statistic: ${key}`);
        const target = card.querySelector<HTMLElement>(`[data-visit-stat="${key}"]`);
        if (target) target.textContent = value.toLocaleString("zh-CN");
      });
      card.dataset.state = "ready";
    } catch {
      card.dataset.state = "error";
      const error = card.querySelector<HTMLElement>(".about-statistics-error");
      if (error) error.hidden = false;
    }
  }

  // 模块脚本只绑定一次；每次触发时查询当前页面的弹层，避免换页后捕获旧 DOM。
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const modal = document.getElementById("donate-modal");
    if (!modal?.classList.contains("visible")) return;
    modal.classList.remove("visible");
    window.setTimeout(() => modal.classList.remove("open"), 200);
  });

  document.addEventListener("DOMContentLoaded", initTipsCarousel);
  document.addEventListener("astro:page-load", initTipsCarousel);
  document.addEventListener("DOMContentLoaded", initDonateModal);
  document.addEventListener("astro:page-load", initDonateModal);
  document.addEventListener("DOMContentLoaded", initVisitStats);
  document.addEventListener("astro:page-load", initVisitStats);
</script>

<style>
  /* ── 页面容器 ── */
  .about { padding-bottom: var(--space-16); }

  /* ── author-box：头像 + 两侧漂浮标签（anheyu） ── */
  .about-author-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-5);
  }

  .about-author-tag-left,
  .about-author-tag-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about-author-tag-left { align-items: flex-end; }
  .about-author-tag-right { align-items: flex-start; }

  .about-author-tag {
    box-sizing: border-box;
    width: 142px;
    transform: translate(0, -4px);
    padding: 1px 8px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--foreground-secondary);
    animation: about-float 6s ease-in-out infinite;
    white-space: nowrap;
  }

  .about-author-tag-left .about-author-tag { text-align: right; }
  .about-author-tag-right .about-author-tag { text-align: left; }

  .about-author-tag-left .about-author-tag:first-child,
  .about-author-tag-left .about-author-tag:last-child { margin-right: -16px; }
  .about-author-tag-right .about-author-tag:first-child,
  .about-author-tag-right .about-author-tag:last-child { margin-left: -16px; }

  @keyframes about-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .about-author-img {
    --corner-shape: var(--corner-shape-round);
    margin: 0 var(--space-5);
    border-radius: 50%;
    width: 150px;
    height: 150px;
    position: relative;
    background: var(--glass-bg);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-material);
  }

  .about-author-img:hover { transform: scale(1.1); }

  .about-author-img img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
  }

  .about-author-img::before {
    content: "";
    position: absolute;
    bottom: 5px;
    right: 10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--success);
    border: 4px solid var(--surface-0);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .about-author-img { width: 120px; height: 120px; }
    .about-author-tag-left, .about-author-tag-right { display: none; }
  }

  /* ── 行容器（59/39 不等宽） ── */
  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-4);
    width: 100%;
    margin-bottom: var(--space-4);
  }

  .about-item {
    min-width: 0;
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    position: relative;
    padding: var(--space-5) var(--space-6);
    overflow: hidden;
    min-height: 200px;
  }

  .about-item--hello,
  .about-item--skills,
  .about-item--personality,
  .about-item--game {
    width: auto;
  }

  .about-item--tips,
  .about-item--selfinfo,
  .about-item--comic,
  .about-item--cards {
    width: auto;
  }

  .about-item--single { grid-column: 1 / -1; }

  /* ── 通用标题 ── */
  .about-card-tips {
    opacity: 0.8;
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
    color: var(--foreground-muted);
  }

  .about-item-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: var(--foreground);
    display: block;
    margin-bottom: var(--space-3);
  }

  /* ── 问候渐变卡 ── */
  .about-item--hello {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    background: linear-gradient(120deg, oklch(0.55 0.2 290) 0%, oklch(0.7 0.15 200) 100%);
    background-size: 200%;
    animation: about-gradient 15s ease infinite;
  }

  .about-hello-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin: var(--space-2) 0;
  }

  .about-item--hello .about-card-tips {
    color: oklch(1 0 0 / 0.84);
    opacity: 1;
  }

  .about-inline-word {
    word-break: keep-all;
    white-space: nowrap;
    color: #fff;
  }

  @keyframes about-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ── 关键词轮播（遮罩动画） ── */
  .about-item--tips {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
  }

  .about-tips-heading {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .about-tips-mask {
    height: 34px;
    position: relative;
    overflow: hidden;
    margin-top: 4px;
  }

  .about-tips-word {
    display: block;
    position: absolute;
    top: 34px;
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-repeat: no-repeat;
    font-weight: 700;
  }

  .about-tips-word[data-show] {
    transform: translateY(-100%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word[data-up] {
    transform: translateY(-200%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word:nth-child(1) { background-image: linear-gradient(45deg, oklch(0.7 0.15 200) 50%, oklch(0.6 0.15 220)); }
  .about-tips-word:nth-child(2) { background-image: linear-gradient(45deg, oklch(0.75 0.15 155) 50%, oklch(0.65 0.15 155)); }
  .about-tips-word:nth-child(3) { background-image: linear-gradient(45deg, oklch(0.6 0.2 290) 50%, oklch(0.55 0.2 280)); }
  .about-tips-word:nth-child(4) { background-image: linear-gradient(45deg, oklch(0.7 0.18 25) 50%, oklch(0.65 0.18 25)); }
  .about-tips-word:nth-child(5) { background-image: linear-gradient(45deg, oklch(0.7 0.15 170) 50%, oklch(0.6 0.15 170)); }

  /* ── 技能墙 ── */
  .about-item--skills {
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-skill-wall {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about-skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
