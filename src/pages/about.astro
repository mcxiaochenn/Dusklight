---
/**
 * 关于页面 — 参照 Mo 的记事簿 (blog.xiowo.net/about) 布局 + Dusklight 鲜活毛玻璃体系
 * 结构：
 * 1. 头像 + 两侧漂浮标签
 * 2. 问候卡 (59%) + 关键词遮罩轮播 (39%)
 * 3. 动态滚动技能卡 (50%，双排无限滚动 + 悬停展开胶囊网格) + 生涯/站点历程卡 (49%)
 * 4. 访问统计数据板 (39%，深邃暗角底板 + 文章隧道按钮) + 右侧上下分栏 (59%：上 60% 嘉兴地图卡 + 下 40% 小标题上置三列个人信息栏)
 * 5. 性格 MBTI (59%) + 追番斜切封面墙 (39%)
 * 6. 游戏斜切封面墙 (59%) + 站点资料 (39%)
 * 7. 关于我 (全宽) + 赞赏名单 (全宽) + 评论区
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config/profile";
import { siteConfig } from "../config/site";
import { skillsData } from "@/data/skills";
import { getSortedSponsors } from "@/data/sponsors";

const sponsors = getSortedSponsors();
const sortedSponsors = [...sponsors].sort((a, b) => {
  const na = parseFloat(a.amount.replace(/[^0-9.]/g, "")) || 0;
  const nb = parseFloat(b.amount.replace(/[^0-9.]/g, "")) || 0;
  return nb - na;
});

// 将技能两两配对成双排图标列，并复制一份以实现 -50% 无缝循环滚动
const skillPairs: Array<[typeof skillsData[number], typeof skillsData[number]]> = [];
for (let i = 0; i < skillsData.length; i += 2) {
  const first = skillsData[i];
  const second = skillsData[(i + 1) % skillsData.length];
  if (first && second) skillPairs.push([first, second]);
}
const marqueePairs = [...skillPairs, ...skillPairs];
---

<BaseLayout title="关于" description={`关于 ${profileConfig.name}`}>
  <section class="about section" id="about-page">
    <div class="page-container">

      {/* ── author-box：头像 + 两侧漂浮标签 ── */}
      <div class="about-author-box">
        <div class="about-author-tag-left">
          {profileConfig.authorTags.map((tag, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{tag.left}</span>
          ))}
        </div>
        <div class="about-author-img" id="about-avatar-trigger" title="辰渊尘" role="button" tabindex="0" aria-label="关于页面作者头像（连点5次打开前端调试面板）">
          <img src={profileConfig.avatar} alt={profileConfig.name} loading="lazy" decoding="async" />
        </div>
        <div class="about-author-tag-right">
          {profileConfig.authorTags.map((tag, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{tag.right}</span>
          ))}
        </div>
      </div>

      {/* ── Row 1：问候卡(59%) + 关键词轮播(39%) ── */}
      <div class="about-row">
        <div class="about-item about-item--hello">
          <div class="about-card-tips">{profileConfig.hello}</div>
          <h1 class="about-hello-title">
            我是 <span class="about-inline-word">{profileConfig.helloName}</span>
          </h1>
          <div class="about-card-tips">{profileConfig.intro}</div>
        </div>

        <div class="about-item about-item--tips">
          <div class="about-card-tips">{profileConfig.aboutsiteTips.tips}</div>
          <h2 class="about-tips-heading">
            {profileConfig.aboutsiteTips.title1}
            <br />
            {profileConfig.aboutsiteTips.title2}
            <div class="about-tips-mask" id="about-tips-mask">
              {profileConfig.aboutsiteTips.words.map((w, i) => (
                <span class:list={["about-tips-word", { "first-tips": i === 0 }]} data-show={i === 0 ? "" : undefined}>
                  {w}
                </span>
              ))}
            </div>
          </h2>
        </div>
      </div>

      {/* ── Row 2：动态滚动技能卡(50%) + 生涯卡(50%)（Mo 的记事簿同款） ── */}
      <div class="about-row about-row--equal">
        <div class="about-item about-item--skills">
          <div class="about-card-tips">{profileConfig.skillsTips}</div>
          <span class="about-item-title">{profileConfig.skillsTitle}</span>

          <div class="skills-style-group">
            {/* 默认态：双排无限横向滚动大图标 */}
            <div class="skills-marquee" aria-hidden="true">
              <div class="skills-marquee__track">
                {marqueePairs.map(([topSkill, bottomSkill]) => (
                  <div class="skills-marquee__pair">
                    <div class="skills-marquee__icon" style={`--skill-bg: ${topSkill.color || "#3b82f6"}`} title={topSkill.name}>
                      <Icon name={topSkill.icon} />
                    </div>
                    <div class="skills-marquee__icon" style={`--skill-bg: ${bottomSkill.color || "#10b981"}`} title={bottomSkill.name}>
                      <Icon name={bottomSkill.icon} />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* 悬停态：完整技能胶囊列表 */}
            <div class="skills-hover-list">
              {skillsData.map((s) => (
                <a href="/skills/" class="skill-pill" title={s.description}>
                  <span class="skill-pill__icon" style={`--skill-bg: ${s.color || "#3b82f6"}`}>
                    <Icon name={s.icon} />
                  </span>
                  <span class="skill-pill__name">{s.name}</span>
                </a>
              ))}
              <a href="/skills/" class="skill-pill skill-pill--more">
                查看全部技能 →
              </a>
            </div>
          </div>
        </div>

        <div class="about-item about-item--careers">
          <div class="about-card-tips">生涯</div>
          <span class="about-item-title">无限进步</span>
          <div class="careers-group">
            <div class="career-item">
              <span class="career-item__dot" style="background: #43a6c6"></span>
              <div class="career-item__body">
                <span class="career-item__name">在读高中生 · 计算机与数码方向</span>
                <span class="career-item__desc">保持好奇心，持续折腾 Linux、前端与搞机</span>
              </div>
            </div>
            <div class="career-item">
              <span class="career-item__dot" style="background: #c69043"></span>
              <div class="career-item__body">
                <span class="career-item__name">个人开发者 · 独立建站</span>
                <span class="career-item__desc">从 Hexo / Fuwari 到自研 Astro Dusklight 主题</span>
              </div>
            </div>
            <div class="career-item">
              <span class="career-item__dot" style="background: #b04fe6"></span>
              <div class="career-item__body">
                <span class="career-item__name">安卓搞机 & 开源分享</span>
                <span class="career-item__desc">记录玩机教程、内核提权与自动化实践笔记</span>
              </div>
            </div>
          </div>
          <div class="careers-timeline-bar">
            <div class="careers-timeline-track">
              <span style="width: 100%"></span>
            </div>
            <div class="careers-timeline-labels">
              <span>2025.07 建站启航</span>
              <span>持续进化中 ✨</span>
            </div>
          </div>
        </div>
      </div>

      {/* ── Row 3：访问统计数据板(39%) + 右侧上下砍半 [上地图(60%) + 下小标题上置个人信息(40%)] (59%) ── */}
      <div class="about-row about-row--data">
        <div class="about-item about-item--statistics" data-api={siteConfig.analytics.apiUrl}>
          <div class="about-statistics__content">
            <div class="about-card-tips">数据</div>
            <span class="about-item-title">访问统计</span>
            <dl class="about-statistics-grid" aria-label="站点访问统计">
              <div><dt>今日人数</dt><dd data-visit-stat="today_uv">—</dd></div>
              <div><dt>今日访问</dt><dd data-visit-stat="today_pv">—</dd></div>
              <div><dt>昨日人数</dt><dd data-visit-stat="yesterday_uv">—</dd></div>
              <div><dt>昨日访问</dt><dd data-visit-stat="yesterday_pv">—</dd></div>
              <div><dt>本月访问</dt><dd data-visit-stat="last_month_pv">—</dd></div>
              <div><dt>总访问量</dt><dd data-visit-stat="total_pv">—</dd></div>
            </dl>
            <p class="about-statistics-error" role="status" hidden>统计暂时无法加载</p>
          </div>

          <div class="about-statistics__footer">
            <span class="about-statistics__tips">
              统计信息来自 <a href="https://umami.is/" target="_blank" rel="noopener noreferrer">Umami 统计</a>
            </span>
            <a href="/archive/" class="about-statistics__btn">
              <Icon name="fa7-solid:arrow-up-right-from-square" />
              <span>文章隧道</span>
            </a>
          </div>
        </div>

        <div class="about-map-and-info">
          {/* 上半部分 (60%)：Mo 记事簿同款地图卡片 */}
          <div
            class="about-item about-item--map"
            style={`--map-bg: url('${profileConfig.mapInfo.lightBg}'); --map-bg-dark: url('${profileConfig.mapInfo.darkBg}');`}
          >
            <div class="about-map__title">
              {profileConfig.mapInfo.prefix} <b>{profileConfig.mapInfo.location}</b>
            </div>
          </div>

          {/* 下半部分 (40%)：小标题上置三列个人信息栏 */}
          <div class="about-item about-item--selfinfo">
            {profileConfig.selfInfo.map((item) => (
              <div class="about-selfinfo-item">
                <span class="about-selfinfo-label">{item.label}</span>
                <span class="about-selfinfo-value" style={`color: ${item.accent}`}>{item.value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ── Row 4：性格 + 喜欢的番 ── */}
      <div class="about-row">
        <div class="about-item about-item--personality">
          <div class="about-card-tips">性格</div>
          <span class="about-item-title">{profileConfig.mbtiTitle}</span>
          <div class="about-mbti" style="color: var(--accent)">{profileConfig.mbti}</div>
          <p class="about-mbti-desc">{profileConfig.mbtiDesc}</p>
          <a
            class="about-personality-link"
            href={profileConfig.mbtiUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            了解逻辑学家人格档案
          </a>
          <div class="about-personality-img">
            <img src={profileConfig.personalityImage} alt="INTP-T 逻辑学家人物" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="about-item about-item--comic">
          <div class="about-card-tips about-comic-tips">爱好番剧</div>
          <span class="about-item-title about-comic-title">追番</span>
          <div class="about-comic-box">
            {profileConfig.favorites.anime.map((a) => (
              <div class="about-comic-item" title={a.name}>
                <div class="about-comic-cover">
                  <img src={a.image} alt={a.name} loading="lazy" decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ── Row 5：喜欢的游戏 + 站点资料 ── */}
      <div class="about-row">
        <div class="about-item about-item--comic about-item--game">
          <div class="about-card-tips about-comic-tips">喜欢的游戏</div>
          <span class="about-item-title about-comic-title">游戏</span>
          <div class="about-comic-box">
            {profileConfig.favorites.games.map((g) => (
              <div class:list={["about-comic-item", { "about-comic-item--landscape": "landscape" in g && g.landscape }]} title={g.name}>
                <div class="about-comic-cover">
                  <img src={g.image} alt={g.name} loading="lazy" decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="about-item about-item--cards">
          {profileConfig.siteCards.map((card) => (
            <div class="about-card-block">
              <h3 class="about-card-block-title">
                <Icon name={card.icon} /> {card.title}
              </h3>
              {card.body && (
                <div class="about-card-block-body">
                  {card.body.split("\n\n").map((para) => <p>{para}</p>)}
                </div>
              )}
              {card.links && (
                <ul class="about-card-block-links">
                  {card.links.map((l) => (
                    <li>
                      {l.href ? (
                        <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>{l.text}</a>
                      ) : (
                        <span>{l.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      {/* ── Row 6：关于我（全宽，打赏上方） ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--aboutme">
          <h2 class="about-card-block-title about-card-block-title--aboutme">
            <Icon name={profileConfig.aboutMe.icon} /> {profileConfig.aboutMe.title}
          </h2>
          <div class="about-card-block-body about-card-block-body--aboutme">
            {profileConfig.aboutMe.body.split("\n\n").map((para) => <p>{para}</p>)}
          </div>
        </div>
      </div>

      {/* ── Row 7：致谢 reward 卡（全宽）+ 打赏 ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--reward" id="about-reward">
          <div class="about-card-tips">感谢</div>
          <span class="about-item-title">打赏名单</span>
          <p class="about-reward-desc">感谢每一位支持者的慷慨解囊，你们的支持是我持续创作最大的动力 ❤️</p>
          <div class="about-reward-list">
            {sortedSponsors.length > 0 ? sortedSponsors.map((s) => (
              <div class="about-reward-item">
                <span class="about-reward-name">{s.name}</span>
                <div class="about-reward-bottom">
                  <span class="about-reward-amount" class:list={parseFloat(s.amount.replace(/[^0-9.]/g, "") || "0") >= 50 ? "about-reward-amount--hl" : undefined}>
                    {s.amount}
                  </span>
                  <span class="about-reward-time">{s.date}</span>
                </div>
              </div>
            )) : (
              <p class="about-reward-empty">还没有赞助记录，第一个支持者就是你~</p>
            )}
          </div>
          <div class="about-reward-actions">
            <button class="about-donate-btn" id="btn-donate">
              <Icon name="fa7-solid:mug-hot" /> 打赏作者
            </button>
          </div>
        </div>
      </div>

      {/* ── 评论区 ── */}
      <div class="about-comments">
        <TwikooComments />
      </div>

    </div>
  </section>

  {/* ── 打赏二维码弹层 ── */}
  <div class="donate-modal" id="donate-modal">
    <div class="donate-modal__backdrop" id="donate-modal-backdrop"></div>
    <div class="donate-modal__card glass-panel">
      <div class="donate-modal__header">
        <span class="donate-modal__title">打赏作者</span>
        <button class="donate-modal__close" id="donate-modal-close" aria-label="关闭">
          <Icon name="fa7-solid:xmark" />
        </button>
      </div>
      <p class="donate-modal__sub">扫描二维码，请小尘喝杯咖啡 ☕</p>
      <div class="donate-modal__qrs">
        <figure class="donate-modal__qr">
          <img src="/sponsors/wechat.svg" alt="微信收款码" loading="lazy" />
          <figcaption>微信</figcaption>
        </figure>
        <figure class="donate-modal__qr">
          <img src="/sponsors/alipay.svg" alt="支付宝收款码" loading="lazy" />
          <figcaption>支付宝</figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  let tipsTimer: number | undefined;
  let activeTipsMask: HTMLElement | null = null;

  /* 关键词轮播动画（aboutsiteTips 遮罩） */
  function initTipsCarousel() {
    const mask = document.getElementById("about-tips-mask");
    if (mask === activeTipsMask && tipsTimer !== undefined) return;

    if (tipsTimer !== undefined) {
      window.clearInterval(tipsTimer);
      tipsTimer = undefined;
    }
    activeTipsMask = mask;
    if (!mask) return;

    const words = Array.from(mask.querySelectorAll(".about-tips-word"));
    if (words.length < 2) return;
    let idx = 0;

    function next() {
      const cur = words[idx % words.length];
      const nxt = words[(idx + 1) % words.length];
      cur?.removeAttribute("data-show");
      cur?.removeAttribute("data-up");
      cur?.setAttribute("data-up", "");
      nxt?.removeAttribute("data-up");
      nxt?.setAttribute("data-show", "");
      idx++;
    }

    tipsTimer = window.setInterval(next, 2000);
  }

  /* 打赏弹层开关 */
  function initDonateModal() {
    const modal = document.getElementById("donate-modal");
    const btn = document.getElementById("btn-donate");
    const close = document.getElementById("donate-modal-close");
    const backdrop = document.getElementById("donate-modal-backdrop");
    if (!modal || !btn || modal.dataset.donateInit === "1") return;
    const donateModal = modal;
    donateModal.dataset.donateInit = "1";

    function open() { donateModal.classList.add("open"); donateModal.classList.add("visible"); }
    function closeModal() {
      donateModal.classList.remove("visible");
      setTimeout(() => donateModal.classList.remove("open"), 200);
    }
    btn.addEventListener("click", open);
    close?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);
  }

  /* 访问统计：页面切换后的新 DOM 会重新请求，单个卡片只初始化一次。 */
  async function initVisitStats() {
    const card = document.querySelector<HTMLElement>(".about-item--statistics");
    if (!card || card.dataset.statisticsInit === "1") return;
    card.dataset.statisticsInit = "1";

    const keys = [
      "today_uv",
      "today_pv",
      "yesterday_uv",
      "yesterday_pv",
      "last_month_pv",
      "total_pv",
    ];

    try {
      const response = await fetch(card.dataset.api ?? "");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();
      if (Number(data.total_pv) === 0) throw new Error("Statistics unavailable");

      keys.forEach((key) => {
        const value = Number(data[key]);
        if (!Number.isFinite(value)) throw new Error(`Invalid statistic: ${key}`);
        const target = card.querySelector<HTMLElement>(`[data-visit-stat="${key}"]`);
        if (target) target.textContent = value.toLocaleString("zh-CN");
      });
      card.dataset.state = "ready";
    } catch {
      card.dataset.state = "error";
      const error = card.querySelector<HTMLElement>(".about-statistics-error");
      if (error) error.hidden = false;
    }
  }

  /* 连续点击 5 下头像唤醒前端调试面板 */
  function initAvatarDebugTrigger() {
    const avatar = document.getElementById("about-avatar-trigger");
    if (!avatar || avatar.dataset.devTriggerInit === "1") return;
    avatar.dataset.devTriggerInit = "1";

    let clicks = 0;
    let resetTimer: number | undefined;

    function triggerClick() {
      clicks++;
      if (resetTimer !== undefined) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => { clicks = 0; }, 1800);

      if (clicks >= 5) {
        clicks = 0;
        if (resetTimer !== undefined) window.clearTimeout(resetTimer);
        window.dispatchEvent(new CustomEvent("dusklight:open-devtools"));
      }
    }

    avatar.addEventListener("click", triggerClick);
    avatar.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        triggerClick();
      }
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const modal = document.getElementById("donate-modal");
    if (!modal?.classList.contains("visible")) return;
    modal.classList.remove("visible");
    window.setTimeout(() => modal.classList.remove("open"), 200);
  });

  document.addEventListener("DOMContentLoaded", initTipsCarousel);
  document.addEventListener("astro:page-load", initTipsCarousel);
  document.addEventListener("DOMContentLoaded", initDonateModal);
  document.addEventListener("astro:page-load", initDonateModal);
  document.addEventListener("DOMContentLoaded", initVisitStats);
  document.addEventListener("astro:page-load", initVisitStats);
  document.addEventListener("DOMContentLoaded", initAvatarDebugTrigger);
  document.addEventListener("astro:page-load", initAvatarDebugTrigger);
</script>

<style>
  /* ── 页面容器 ── */
  .about { padding-bottom: var(--space-16); }

  /* ── author-box：头像 + 两侧漂浮标签 ── */
  .about-author-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-5);
  }

  .about-author-tag-left,
  .about-author-tag-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about-author-tag-left { align-items: flex-end; }
  .about-author-tag-right { align-items: flex-start; }

  .about-author-tag {
    box-sizing: border-box;
    width: 142px;
    transform: translate(0, -4px);
    padding: 1px 8px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--foreground-secondary);
    animation: about-float 6s ease-in-out infinite;
    white-space: nowrap;
  }

  .about-author-tag-left .about-author-tag { text-align: right; }
  .about-author-tag-right .about-author-tag { text-align: left; }

  .about-author-tag-left .about-author-tag:first-child,
  .about-author-tag-left .about-author-tag:last-child { margin-right: -16px; }
  .about-author-tag-right .about-author-tag:first-child,
  .about-author-tag-right .about-author-tag:last-child { margin-left: -16px; }

  @keyframes about-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .about-author-img {
    margin: 0 var(--space-5);
    border-radius: 50%;
    width: 150px;
    height: 150px;
    position: relative;
    background: var(--glass-bg);
    flex-shrink: 0;
    cursor: pointer;
    user-select: none;
    transition: transform var(--duration-normal) var(--ease-material);
  }

  .about-author-img:hover { transform: scale(1.06); }
  .about-author-img:active { transform: scale(0.95); }

  .about-author-img img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
  }

  .about-author-img::before {
    content: "";
    position: absolute;
    bottom: 5px;
    right: 10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--success);
    border: 4px solid var(--surface-0);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .about-author-img { width: 120px; height: 120px; }
    .about-author-tag-left, .about-author-tag-right { display: none; }
  }

  /* ── 行容器（默认 59/39 不等宽，equal 为 50/50，data 为 39/59） ── */
  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-4);
    width: 100%;
    margin-bottom: var(--space-4);
  }

  .about-row--equal {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .about-row--data {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .about-item {
    min-width: 0;
    border-radius: 24px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    position: relative;
    padding: var(--space-5) var(--space-6);
    overflow: hidden;
    min-height: 200px;
    transition:
      border-color var(--duration-fast) var(--ease-material),
      box-shadow var(--duration-fast) var(--ease-material);
  }

  .about-item:hover {
    border-color: var(--accent);
    box-shadow: var(--glass-hover-shadow), var(--glass-highlight);
  }

  .about-item--single { grid-column: 1 / -1; }

  /* ── 通用标题 ── */
  .about-card-tips {
    opacity: 0.8;
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
    color: var(--foreground-muted);
  }

  .about-item-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.05;
    color: var(--foreground);
    display: block;
    margin-bottom: var(--space-3);
  }

  /* ── 问候渐变卡 ── */
  .about-item--hello {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    background: linear-gradient(120deg, oklch(0.55 0.2 290) 0%, oklch(0.7 0.15 200) 100%);
    background-size: 200%;
    animation: about-gradient 15s ease infinite;
  }

  .about-hello-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    margin: var(--space-2) 0;
    color: #fff;
  }

  .about-item--hello .about-card-tips {
    color: oklch(1 0 0 / 0.86);
    opacity: 1;
  }

  .about-inline-word {
    word-break: keep-all;
    white-space: nowrap;
    color: #fff;
  }

  @keyframes about-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ── 关键词轮播（遮罩动画） ── */
  .about-item--tips {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
  }

  .about-tips-heading {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .about-tips-mask {
    height: 36px;
    position: relative;
    overflow: hidden;
    margin-top: 4px;
  }

  .about-tips-word {
    display: block;
    position: absolute;
    top: 36px;
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-repeat: no-repeat;
    font-weight: 700;
  }

  .about-tips-word[data-show] {
    transform: translateY(-100%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word[data-up] {
    transform: translateY(-200%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word:nth-child(1) { background-image: linear-gradient(45deg, oklch(0.7 0.15 200) 50%, oklch(0.6 0.15 220)); }
  .about-tips-word:nth-child(2) { background-image: linear-gradient(45deg, oklch(0.75 0.15 155) 50%, oklch(0.65 0.15 155)); }
  .about-tips-word:nth-child(3) { background-image: linear-gradient(45deg, oklch(0.6 0.2 290) 50%, oklch(0.55 0.2 280)); }
  .about-tips-word:nth-child(4) { background-image: linear-gradient(45deg, oklch(0.7 0.18 25) 50%, oklch(0.65 0.18 25)); }
  .about-tips-word:nth-child(5) { background-image: linear-gradient(45deg, oklch(0.7 0.15 170) 50%, oklch(0.6 0.15 170)); }

  /* ── 动态滚动 Skills 卡（Mo 的记事簿同款） ── */
  .about-item--skills {
    min-height: 420px;
    display: flex;
    flex-direction: column;
  }

  .skills-style-group {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .skills-marquee {
    width: 100%;
    overflow: hidden;
    padding: var(--space-4) 0;
    transition: opacity 0.35s var(--ease-material);
  }

  .skills-marquee__track {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    width: max-content;
    animation: about-skills-rowup 50s linear infinite;
  }

  @keyframes about-skills-rowup {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .skills-marquee__pair {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
  }

  .skills-marquee__pair:nth-child(even) {
    transform: translateY(20px);
  }

  .skills-marquee__icon {
    width: 104px;
    height: 104px;
    border-radius: 28px;
    background: var(--skill-bg, #3b82f6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px oklch(0 0 0 / 0.18);
  }

  .skills-marquee__icon :global(svg) {
    width: 52px;
    height: 52px;
    filter: drop-shadow(0 2px 4px oklch(0 0 0 / 0.16));
  }

  /* 悬停展开完整技能胶囊列表 */
  .skills-hover-list {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 10px;
    padding-top: var(--space-2);
    opacity: 0;
    pointer-events: none;
    overflow-y: auto;
    transition: opacity 0.35s var(--ease-material);
  }

  .about-item--skills:hover .skills-marquee {
    opacity: 0;
  }

  .about-item--skills:hover .skills-hover-list {
    opacity: 1;
    pointer-events: auto;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 7px;
    border-radius: var(--radius-full);
    background: oklch(0.97 0.008 var(--hue) / 0.72);
    border: 1px solid var(--glass-border);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-material),
      border-color var(--duration-fast) var(--ease-material);
  }

  :global(:root.dark) .skill-pill {
    background: oklch(0.16 0.012 var(--hue) / 0.78);
  }

  .skill-pill:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .skill-pill__icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--skill-bg, #3b82f6);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .skill-pill__icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .skill-pill--more {
    padding: 6px 16px;
    background: var(--accent-subtle);
    color: var(--accent);
    border-color: oklch(from var(--accent) l c h / 0.3);
  }

  /* ── 生涯卡（.about-item--careers） ── */
  .about-item--careers {
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .careers-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-3) 0;
  }

  .career-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .career-item__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px oklch(1 0 0 / 0.08);
  }

  .career-item__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .career-item__name {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
  }

  .career-item__desc {
    font-size: var(--text-xs);
    color: var(--foreground-secondary);
    line-height: 1.5;
  }

  .careers-timeline-bar {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .careers-timeline-track {
    height: 10px;
    border-radius: var(--radius-full);
    background: oklch(0.5 0.02 var(--hue) / 0.18);
    overflow: hidden;
  }

  .careers-timeline-track span {
    display: block;
    height: 100%;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, #43a6c6, #18e7ae, #b04fe6);
  }

  .careers-timeline-labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--foreground-muted);
    font-weight: 600;
  }

  /* ── 访问统计数据板 + 右侧上下砍半（地图 + 小标题上置个人信息） ── */
  .about-item--statistics {
    min-height: 380px;
    color: #fff;
    background-image:
      linear-gradient(180deg, rgba(12, 28, 44, 0.32) 0%, rgba(12, 28, 44, 0.68) 100%),
      url("/images/bg/xiowo-bg-dark.webp");
    background-size: cover;
    background-position: center top;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* 将底部暗角放入独立伪元素，防止 .about-item:hover 覆盖 box-shadow 时引起闪烁 */
  .about-item--statistics::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 22%, rgba(12, 28, 44, 0.86) 100%);
    box-shadow: inset 0 -130px 150px -20px #0c1c2c;
    pointer-events: none;
    z-index: 1;
  }

  .about-statistics__content,
  .about-statistics__footer {
    position: relative;
    z-index: 2;
  }

  .about-item--statistics .about-card-tips,
  .about-item--statistics .about-item-title {
    color: #fff;
  }

  .about-statistics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .about-statistics-grid div { min-width: 0; }
  .about-statistics-grid dt {
    font-size: 13px;
    color: oklch(1 0 0 / 0.78);
  }
  .about-statistics-grid dd {
    margin: 4px 0 0;
    font-size: 32px;
    line-height: 1.05;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .about-statistics-error {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: oklch(0.88 0.07 35);
  }

  .about-statistics__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    position: relative;
    z-index: 2;
  }

  .about-statistics__tips {
    font-size: 12px;
    color: oklch(1 0 0 / 0.72);
  }

  .about-statistics__tips a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-statistics__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: oklch(1 0 0 / 0.16);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    border: 1px solid oklch(1 0 0 / 0.24);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition:
      background var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-material);
  }

  .about-statistics__btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .about-statistics__btn :global(svg) {
    width: 12px;
    height: 12px;
  }

  /* 右侧上下砍半容器 (.about-map-and-info) */
  .about-map-and-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 380px;
    min-width: 0;
  }

  /* 上半部分 (60%)：嘉兴地图卡 */
  .about-item--map {
    flex: 6;
    min-height: 215px;
    padding: 0;
    background-image: var(--map-bg);
    background-position: 50% 50%;
    background-size: 105%;
    background-repeat: no-repeat;
    transition:
      background-position 1.2s ease-in-out,
      background-size 1.2s ease-in-out,
      border-color var(--duration-fast) var(--ease-material),
      box-shadow var(--duration-fast) var(--ease-material);
  }

  :global(:root.dark) .about-item--map {
    background-image: var(--map-bg-dark);
  }

  .about-map__title {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 12px 28px;
    background: oklch(0.98 0.006 var(--hue) / 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-top: 1px solid var(--glass-border);
    font-size: 19px;
    color: var(--foreground);
    transition: bottom 0.8s ease-in-out;
  }

  :global(:root.dark) .about-map__title {
    background: rgba(18, 18, 18, 0.72);
  }

  .about-map__title b {
    font-weight: 800;
    color: var(--accent);
  }

  .about-item--map:hover {
    background-position: 0% 36%;
    background-size: 122%;
    transition:
      background-position 3.5s ease-in-out,
      background-size 3.5s ease-in-out;
  }

  .about-item--map:hover .about-map__title {
    bottom: -100%;
  }

  /* 下半部分 (40%)：小标题上置三列个人信息栏 */
  .about-item--selfinfo {
    flex: 4;
    min-height: 145px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
  }

  .about-selfinfo-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    gap: 6px;
  }

  .about-selfinfo-label {
    font-size: 12px;
    color: var(--foreground-muted);
    opacity: 0.85;
    font-weight: 500;
  }

  .about-selfinfo-value {
    font-size: clamp(1.35rem, 1.8vw, 1.95rem);
    line-height: 1.15;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  /* ── 性格卡 ── */
  .about-item--personality {
    min-height: 240px;
    isolation: isolate;
  }

  .about-item--personality > :not(.about-personality-img) {
    position: relative;
    z-index: 2;
  }

  .about-mbti {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 var(--space-2);
  }

  .about-mbti-desc {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
    max-width: 52%;
    line-height: 1.65;
  }

  .about-personality-link {
    position: absolute !important;
    left: var(--space-6);
    bottom: var(--space-5);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .about-personality-link:hover { text-decoration: underline; }

  .about-personality-img {
    position: absolute;
    right: var(--space-4);
    bottom: -98px;
    width: 245px;
    transform-origin: 60% 100%;
    transition: transform 2s cubic-bezier(0.13, 0.45, 0.21, 1.02);
    z-index: 1;
  }

  .about-personality-img img {
    display: block;
    max-width: 100%;
    filter: drop-shadow(0 4px 12px oklch(0 0 0 / 0.15));
  }

  .about-item--personality:hover .about-personality-img {
    transform: rotate(-10deg) scale(0.92) translateY(-28px);
  }

  /* ── 连续斜切封面墙 ── */
  .about-item--comic {
    overflow: hidden;
    min-height: 240px;
    isolation: isolate;
    background: oklch(0.17 0.02 190);
  }

  .about-comic-tips,
  .about-comic-title {
    z-index: 3;
    color: #fff;
    pointer-events: none;
    position: relative;
  }

  .about-comic-title { color: #fff; }

  .about-comic-box {
    display: flex;
    position: absolute;
    inset: 0 -6%;
    overflow: hidden;
    z-index: 0;
  }

  .about-comic-item {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
    margin-inline: -1px;
    clip-path: polygon(12% 0, 100% 0, 88% 100%, 0 100%);
    transition: flex-grow 0.8s var(--ease-material);
  }

  .about-comic-cover {
    position: absolute;
    inset: 0;
  }

  .about-comic-cover img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 0.8s var(--ease-material);
    max-width: none;
    border-radius: 0;
  }

  .about-comic-item--landscape .about-comic-cover img { transform: scale(1.34); }

  @media (hover: hover) and (pointer: fine) {
    .about-comic-box:hover .about-comic-item { flex-grow: 0.75; }
    .about-comic-box .about-comic-item:hover { flex-grow: 2.4; }
    .about-comic-item:hover .about-comic-cover img { transform: scale(1.16); }
    .about-comic-item--landscape:hover .about-comic-cover img { transform: scale(1.44); }
  }

  .about-item--comic::after {
    box-shadow: 0 -48px 203px 11px oklch(0.9 0.05 70 / 0.6) inset;
    position: absolute;
    content: "";
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  :global(.dark) .about-item--comic::after {
    box-shadow: 0 -48px 203px 11px oklch(0.15 0.02 70 / 0.6) inset;
  }

  /* ── 站点资料与关于我 ── */
  .about-item--cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-card-block { padding: 0 0 var(--space-3); border-bottom: 1px solid var(--border-subtle); }
  .about-card-block:last-child { border-bottom: none; }

  .about-card-block-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-2);
  }

  .about-card-block-title svg { width: 16px; height: 16px; opacity: 0.6; }

  .about-card-block-body p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--foreground-secondary);
    margin: 0 0 var(--space-2);
  }
  .about-card-block-body p:last-child { margin-bottom: 0; }

  .about-card-block-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
