---
/**
 * 关于页面 — anheyu 主题布局魔改版
 * 蓝本：github.com/anzhiyu-c/hexo-theme-anzhiyu 的 about.pug + about.styl
 * 结构：author-box(头像+两侧浮动标签) → 不等宽卡片行(59/39) → 斜切封面墙
 *       → aboutCards 信息区 → 致谢 reward 卡 + 打赏 → 评论区
 * 数据全部来自 profileConfig。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config/profile";
import { skillsData } from "@/data/skills";
import { getSortedSponsors } from "@/data/sponsors";

const sponsors = getSortedSponsors();
const sortedSponsors = [...sponsors].sort((a, b) => {
  const na = parseFloat(a.amount.replace(/[^0-9.]/g, "")) || 0;
  const nb = parseFloat(b.amount.replace(/[^0-9.]/g, "")) || 0;
  return nb - na;
});
---

<BaseLayout title="关于" description={`关于 ${profileConfig.name}`}>
  <section class="about section" id="about-page">
    <div class="page-container">

      {/* ── author-box：头像 + 两侧漂浮标签 ── */}
      <div class="about-author-box">
        <div class="about-author-tag-left">
          {profileConfig.authorTagsLeft.map((t, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{t}</span>
          ))}
        </div>
        <div class="about-author-img">
          <img src={profileConfig.avatar} alt={profileConfig.name} loading="lazy" decoding="async" />
        </div>
        <div class="about-author-tag-right">
          {profileConfig.authorTagsRight.map((t, i) => (
            <span class="about-author-tag" style={`animation-delay: ${i * 0.6}s`}>{t}</span>
          ))}
        </div>
      </div>

      {/* ── 问候卡(59%) + 关键词轮播(39%) ── */}
      <div class="about-row">
        <div class="about-item about-item--hello">
          <div class="about-card-tips">你好呀</div>
          <div class="about-hello-title">
            我是 <span class="about-inline-word">{profileConfig.helloName}</span>
          </div>
          <div class="about-card-tips">{profileConfig.intro}</div>
        </div>

        <div class="about-item about-item--tips">
          <div class="about-card-tips">{profileConfig.aboutsiteTips.tips}</div>
          <h2 class="about-tips-heading">
            {profileConfig.aboutsiteTips.title1}
            <br />
            {profileConfig.aboutsiteTips.title2}
            <div class="about-tips-mask" id="about-tips-mask">
              {profileConfig.aboutsiteTips.words.map((w, i) => (
                <span class:list={["about-tips-word", { "first-tips": i === 0 }]} data-show={i === profileConfig.aboutsiteTips.words.length - 1 ? "" : undefined}>
                  {w}
                </span>
              ))}
            </div>
          </h2>
        </div>
      </div>

      {/* ── 技能墙(59%) + selfInfo 数据卡(39%) ── */}
      <div class="about-row">
        <div class="about-item about-item--skills">
          <div class="about-card-tips">{profileConfig.skillsTips}</div>
          <span class="about-item-title">{profileConfig.skillsTitle}</span>
          <div class="about-skill-wall">
            {skillsData.map((s) => (
              <a href="/skills/" class="about-skill-icon" title={s.name}>
                <Icon name={s.icon} />
              </a>
            ))}
          </div>
        </div>

        <div class="about-item about-item--selfinfo">
          {profileConfig.selfInfo.map((item) => (
            <div class="about-selfinfo-row">
              <span class="about-selfinfo-label">{item.label}</span>
              <span class="about-selfinfo-value">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      {/* ── 性格(59%，立绘 hover 旋转) + 喜欢的番(39% 斜切封面墙) ── */}
      <div class="about-row">
        <div class="about-item about-item--personality">
          <div class="about-card-tips">关于我的人格</div>
          <span class="about-item-title">{profileConfig.name}</span>
          <div class="about-mbti" style="color: var(--accent)">{profileConfig.mbti}</div>
          <p class="about-mbti-desc">{profileConfig.mbtiDesc}</p>
          <div class="about-personality-img">
            <img src={profileConfig.personalityImage} alt="INTP" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="about-item about-item--comic">
          <div class="about-card-tips about-comic-tips">爱好番剧</div>
          <span class="about-item-title about-comic-title">追番</span>
          <div class="about-comic-box">
            {profileConfig.favorites.anime.map((a) => (
              <a href="#" class="about-comic-item" title={a.name}>
                <div class="about-comic-cover">
                  <img src={a.image} alt={a.name} loading="lazy" decoding="async" />
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ── 喜欢的游戏（59% 斜切封面墙） + aboutCards 信息区（39%） ── */}
      <div class="about-row">
        <div class="about-item about-item--comic about-item--game">
          <div class="about-card-tips about-comic-tips">喜欢的游戏</div>
          <span class="about-item-title about-comic-title">游戏</span>
          <div class="about-comic-box">
            {profileConfig.favorites.games.map((g) => (
              <a href="#" class="about-comic-item" title={g.name}>
                <div class="about-comic-cover">
                  <img src={g.image} alt={g.name} loading="lazy" decoding="async" />
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="about-item about-item--cards">
          {profileConfig.aboutCards.map((card) => (
            <div class="about-card-block">
              <h3 class="about-card-block-title">
                <Icon name={card.icon} /> {card.title}
              </h3>
              {card.body && (
                <div class="about-card-block-body">
                  {card.body.split("\n\n").map((para) => <p>{para}</p>)}
                </div>
              )}
              {card.links && (
                <ul class="about-card-block-links">
                  {card.links.map((l) => (
                    <li>
                      {l.href ? (
                        <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>{l.text}</a>
                      ) : (
                        <span>{l.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      {/* ── 致谢 reward 卡（全宽）+ 打赏 ── */}
      <div class="about-row">
        <div class="about-item about-item--single about-item--reward" id="about-reward">
          <div class="about-card-tips">感谢</div>
          <span class="about-item-title">打赏名单</span>
          <p class="about-reward-desc">感谢每一位支持者的慷慨解囊，你们的支持是我持续创作最大的动力 ❤️</p>
          <div class="about-reward-list">
            {sortedSponsors.length > 0 ? sortedSponsors.map((s) => (
              <div class="about-reward-item">
                <span class="about-reward-name">{s.name}</span>
                <div class="about-reward-bottom">
                  <span class="about-reward-amount" class:list={parseFloat(s.amount.replace(/[^0-9.]/g, "") || "0") >= 50 && "about-reward-amount--hl"}>
                    {s.amount}
                  </span>
                  <span class="about-reward-time">{s.date}</span>
                </div>
              </div>
            )) : (
              <p class="about-reward-empty">还没有赞助记录，第一个支持者就是你~</p>
            )}
          </div>
          <div class="about-reward-actions">
            <button class="about-donate-btn" id="btn-donate">
              <Icon name="ph:coffee" /> 打赏作者
            </button>
          </div>
        </div>
      </div>

      {/* ── 评论区 ── */}
      <div class="about-comments">
        <TwikooComments />
      </div>

    </div>
  </section>

  {/* ── 打赏二维码弹层 ── */}
  <div class="donate-modal" id="donate-modal">
    <div class="donate-modal__backdrop" id="donate-modal-backdrop"></div>
    <div class="donate-modal__card glass-panel">
      <div class="donate-modal__header">
        <span class="donate-modal__title">打赏作者</span>
        <button class="donate-modal__close" id="donate-modal-close" aria-label="关闭">
          <Icon name="ph:x" />
        </button>
      </div>
      <p class="donate-modal__sub">扫描二维码，请小尘喝杯咖啡 ☕</p>
      <div class="donate-modal__qrs">
        <figure class="donate-modal__qr">
          <img src="/sponsors/wechat.svg" alt="微信收款码" loading="lazy" />
          <figcaption>微信</figcaption>
        </figure>
        <figure class="donate-modal__qr">
          <img src="/sponsors/alipay.svg" alt="支付宝收款码" loading="lazy" />
          <figcaption>支付宝</figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  /* 关键词轮播动画（anheyu aboutsiteTips 遮罩） */
  function initTipsCarousel() {
    const mask = document.getElementById("about-tips-mask");
    if (!mask || mask.dataset.carouselInit === "1") return;
    mask.dataset.carouselInit = "1";

    const words = Array.from(mask.querySelectorAll(".about-tips-word"));
    let idx = 0;

    function next() {
      const cur = words[idx % words.length];
      const nxt = words[(idx + 1) % words.length];
      cur?.removeAttribute("data-show");
      cur?.removeAttribute("data-up");
      cur?.setAttribute("data-up", "");
      nxt?.setAttribute("data-show", "");
      idx++;
    }

    setInterval(next, 2000);
  }

  /* 打赏弹层开关 */
  function initDonateModal() {
    const modal = document.getElementById("donate-modal");
    const btn = document.getElementById("btn-donate");
    const close = document.getElementById("donate-modal-close");
    const backdrop = document.getElementById("donate-modal-backdrop");
    if (!modal || !btn) return;

    function open() { modal.classList.add("open"); modal.classList.add("visible"); }
    function closeModal() {
      modal.classList.remove("visible");
      setTimeout(() => modal.classList.remove("open"), 200);
    }
    btn.addEventListener("click", open);
    close?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);
    document.addEventListener("keydown", function onEsc(e) {
      if (e.key === "Escape" && modal.classList.contains("visible")) closeModal();
    });
  }

  document.addEventListener("DOMContentLoaded", initTipsCarousel);
  document.addEventListener("astro:page-load", initTipsCarousel);
  document.addEventListener("DOMContentLoaded", initDonateModal);
  document.addEventListener("astro:page-load", initDonateModal);
</script>

<style>
  /* ── 页面容器 ── */
  .about { padding-bottom: var(--space-16); }

  /* ── author-box：头像 + 两侧漂浮标签（anheyu） ── */
  .about-author-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-5);
  }

  .about-author-tag-left,
  .about-author-tag-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about-author-tag-left { align-items: flex-end; }
  .about-author-tag-right { align-items: flex-start; }

  .about-author-tag {
    transform: translate(0, -4px);
    padding: 1px 8px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md), var(--glass-highlight);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--foreground-secondary);
    animation: about-float 6s ease-in-out infinite;
    white-space: nowrap;
  }

  .about-author-tag-left .about-author-tag:first-child,
  .about-author-tag-left .about-author-tag:last-child { margin-right: -16px; }
  .about-author-tag-right .about-author-tag:first-child,
  .about-author-tag-right .about-author-tag:last-child { margin-left: -16px; }

  @keyframes about-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .about-author-img {
    margin: 0 var(--space-5);
    border-radius: 50%;
    width: 150px;
    height: 150px;
    position: relative;
    background: var(--glass-bg);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-material);
  }

  .about-author-img:hover { transform: scale(1.1); }

  .about-author-img img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
  }

  .about-author-img::before {
    content: "";
    position: absolute;
    bottom: 5px;
    right: 10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--success);
    border: 4px solid var(--surface-0);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .about-author-img { width: 120px; height: 120px; }
    .about-author-tag-left, .about-author-tag-right { display: none; }
  }

  /* ── 行容器（59/39 不等宽） ── */
  .about-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-bottom: var(--space-4);
  }

  .about-item {
    width: 39%;
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    position: relative;
    padding: var(--space-5) var(--space-6);
    overflow: hidden;
    min-height: 200px;
  }

  .about-item--hello,
  .about-item--skills,
  .about-item--personality,
  .about-item--game {
    width: 59%;
  }

  .about-item--tips,
  .about-item--selfinfo,
  .about-item--comic,
  .about-item--cards {
    width: 39%;
  }

  .about-item--single { width: 100%; }

  /* ── 通用标题 ── */
  .about-card-tips {
    opacity: 0.8;
    font-size: var(--text-xs);
    margin-bottom: var(--space-2);
    color: var(--foreground-muted);
  }

  .about-item-title {
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: var(--foreground);
    display: block;
    margin-bottom: var(--space-3);
  }

  /* ── 问候渐变卡 ── */
  .about-item--hello {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    background: linear-gradient(120deg, oklch(0.55 0.2 290) 0%, oklch(0.7 0.15 200) 100%);
    background-size: 200%;
    animation: about-gradient 15s ease infinite;
  }

  .about-hello-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin: var(--space-2) 0;
  }

  .about-inline-word {
    word-break: keep-all;
    white-space: nowrap;
    color: #fff;
  }

  @keyframes about-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ── 关键词轮播（遮罩动画） ── */
  .about-item--tips {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
  }

  .about-tips-heading {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .about-tips-mask {
    height: 34px;
    position: relative;
    overflow: hidden;
    margin-top: 4px;
  }

  .about-tips-word {
    display: block;
    position: absolute;
    top: 34px;
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-repeat: no-repeat;
    font-weight: 700;
  }

  .about-tips-word[data-show] {
    transform: translateY(-100%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word[data-up] {
    transform: translateY(-200%);
    transition: 0.5s transform ease-in-out;
  }

  .about-tips-word:nth-child(1) { background-image: linear-gradient(45deg, oklch(0.7 0.15 200) 50%, oklch(0.6 0.15 220)); }
  .about-tips-word:nth-child(2) { background-image: linear-gradient(45deg, oklch(0.75 0.15 155) 50%, oklch(0.65 0.15 155)); }
  .about-tips-word:nth-child(3) { background-image: linear-gradient(45deg, oklch(0.6 0.2 290) 50%, oklch(0.55 0.2 280)); }
  .about-tips-word:nth-child(4) { background-image: linear-gradient(45deg, oklch(0.7 0.18 25) 50%, oklch(0.65 0.18 25)); }
  .about-tips-word:nth-child(5) { background-image: linear-gradient(45deg, oklch(0.7 0.15 170) 50%, oklch(0.6 0.15 170)); }

  /* ── 技能墙 ── */
  .about-skill-wall {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about-skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: oklch(1 0 0 / 0.35);
    border: 1px solid var(--glass-border);
    transition: transform var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  :global(.dark) .about-skill-icon { background: oklch(1 0 0 / 0.06); }

  .about-skill-icon:hover {
    transform: translateY(-2px) scale(1.06);
    border-color: var(--accent);
  }

  .about-skill-icon [data-icon] { width: 24px; height: 24px; }

  /* ── selfInfo 数据卡 ── */
  .about-selfinfo-row {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
  }

  .about-selfinfo-label {
    opacity: 0.8;
    font-size: var(--text-xs);
    color: var(--foreground-muted);
    margin-bottom: var(--space-1);
  }

  .about-selfinfo-value {
    font-weight: 700;
    font-size: 28px;
    line-height: 1;
    color: var(--accent);
  }

  /* ── 性格卡 ── */
  .about-mbti {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 var(--space-2);
  }

  .about-mbti-desc {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
    max-width: 55%;
  }

  .about-personality-img {
    position: absolute;
    right: var(--space-6);
    top: var(--space-4);
    width: 130px;
    transition: transform 2s cubic-bezier(0.13, 0.45, 0.21, 1.02);
  }

  .about-personality-img img {
    display: block;
    max-width: 100%;
    filter: drop-shadow(0 4px 12px oklch(0 0 0 / 0.15));
  }

  .about-item--personality:hover .about-personality-img {
    transform: rotate(-10deg);
  }

  /* ── 斜切封面墙（anheyu comic-content） ── */
  .about-item--comic {
    overflow: hidden;
  }

  .about-comic-tips,
  .about-comic-title {
    z-index: 2;
    color: #fff;
    pointer-events: none;
    position: relative;
  }

  .about-comic-title { color: #fff; }

  .about-comic-box {
    display: flex;
    width: 120%;
    height: 100%;
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .about-comic-item {
    height: 100%;
    color: #fff;
    width: 20%;
    transform: skew(-10deg, 0deg);
    transition: width 0.8s var(--ease-material);
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .about-comic-item:hover { width: 46%; }

  .about-comic-item:hover .about-comic-cover {
    left: 16%;
    transform: skew(10deg, 0deg) scale(1.6);
  }

  .about-comic-cover {
    position: absolute;
    top: 0;
    left: -50%;
    height: 100%;
    transform: skew(10deg, 0deg);
    object-fit: cover;
    transition: all 0.8s var(--ease-material);
    width: 100%;
  }

  .about-comic-cover img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: 0.8s;
    max-width: none;
    border-radius: 0;
  }

  .about-item--comic::after {
    box-shadow: 0 -48px 203px 11px oklch(0.9 0.05 70 / 0.6) inset;
    position: absolute;
    content: "";
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  :global(.dark) .about-item--comic::after {
    box-shadow: 0 -48px 203px 11px oklch(0.15 0.02 70 / 0.6) inset;
  }

  /* 游戏斜切墙同样式（class 复用） */

  /* ── aboutCards 信息区 ── */
  .about-item--cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    overflow-y: auto;
    max-height: 420px;
  }

  .about-card-block { padding: 0 0 var(--space-3); border-bottom: 1px solid var(--border-subtle); }
  .about-card-block:last-child { border-bottom: none; }

  .about-card-block-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
