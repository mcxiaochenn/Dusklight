---
/**
 * 关于页面
 * 编辑式排版：Hero 名字 + .prose 内容 + 侧边信息
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";
import { profileConfig } from "../config/profile";
---

<BaseLayout title="关于" description="关于我">
  <section class="about section">
    <div class="page-container">
      <div class="about__hero">
        <h1 class="about__name">{profileConfig.name}</h1>
        <p class="about__bio">{profileConfig.bio}</p>
      </div>

      <div class="about__layout">
        <div class="about__content prose">
          <h2>关于我</h2>
          <p>{profileConfig.description}</p>
        </div>

        <aside class="about__sidebar">
          {profileConfig.avatar && (
            <img src={profileConfig.avatar} alt={profileConfig.name} class="about__avatar" />
          )}
          {profileConfig.skills && profileConfig.skills.length > 0 && (
            <div class="about__skills">
              <h3 class="about__skills-label">技能</h3>
              <div class="about__skill-tags">
                {profileConfig.skills.map((s) => <Tag>{s}</Tag>)}
              </div>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about__hero { padding-bottom: var(--space-12); }

  .about__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 var(--space-3);
  }

  .about__bio {
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--foreground-secondary);
    margin: 0;
  }

  .about__layout {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-10);
    align-items: start;
  }

  .about__sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .about__avatar {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
  }

  .about__skills-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-3);
  }

  .about__skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 768px) {
    .about__layout { grid-template-columns: 1fr; }
    .about__sidebar {
      position: static;
      display: flex;
      align-items: center;
      gap: var(--space-6);
    }
    .about__avatar { width: 120px; height: 120px; margin-bottom: 0; }
  }
</style>
