---
/**
 * 关于页面 — 头像行 + 信息卡片网格 + 玻璃卡片板块 + 致谢 + 评论
 * 借鉴 blog.zhheo.com/about/ 的图片卡片与玻璃面板风格；
 * 原 spec/about.md 内容已结构化进 profileConfig.aboutCards。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config/profile";
import { skillsData } from "@/data/skills";
import { getSortedSponsors } from "@/data/sponsors";

const sponsors = getSortedSponsors();
---

<BaseLayout title="关于" description={`关于 ${profileConfig.name}`}>
  <section class="about section">
    <div class="page-container">

      {/* ── Hero：头像 + 名字 + bio ── */}
      <div class="about__hero">
        <div class="about__avatar-wrap">
          <img src={profileConfig.avatar} alt={profileConfig.name} class="about__avatar" />
        </div>
        <div class="about__hero-text">
          <h1 class="about__name">{profileConfig.name}</h1>
          <p class="about__motto">{profileConfig.bio}</p>
          <div class="about__identities">
            {profileConfig.identities.map((t) => (
              <span class="about__identity">{t}</span>
            ))}
          </div>
        </div>
      </div>

      {/* ── 卡片网格 ── */}
      <div class="about__grid">
        {/* 基础信息 */}
        <div class="about__card about__card--info">
          <h2 class="about__card-title">
            <Icon name="ph:user" /> 基础信息
          </h2>
          <div class="about__info-list">
            <div class="about__info-row">
              <span class="about__info-label">位置</span>
              <span class="about__info-value">{profileConfig.location}</span>
            </div>
            <div class="about__info-row">
              <span class="about__info-label">邮箱</span>
              <span class="about__info-value">{profileConfig.email}</span>
            </div>
          </div>
        </div>

        {/* 性格侧写 */}
        <div class="about__card about__card--personality">
          <h2 class="about__card-title">
            <Icon name="ph:brain" /> 性格侧写
          </h2>
          <p class="about__mbti">{profileConfig.mbti}</p>
          <p class="about__mbti-desc">{profileConfig.mbtiDesc}</p>
        </div>

        {/* 技能墙 — 点击任意图标跳转 /skills/ 详情页 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:code" /> 技能
          </h2>
          <div class="about__skill-wall">
            {skillsData.map((s) => (
              <a href="/skills/" class="about__skill-icon" title={s.name}>
                <Icon name={s.icon} />
              </a>
            ))}
          </div>
        </div>

        {/* 喜欢的番 — 图片卡片横向滚动 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:television-simple" /> 喜欢的番
          </h2>
          <div class="about__fav-scroll">
            {profileConfig.favorites.anime.map((a) => (
              <figure class="about__fav-card">
                {a.image ? (
                  <img src={a.image} alt={a.name} loading="lazy" decoding="async" />
                ) : (
                  <div class="about__fav-placeholder"><Icon name="ph:television-simple" /></div>
                )}
                <figcaption class="about__fav-name">{a.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>

        {/* 喜欢的游戏 — 横版封面（Steam capsule 16:9）横向滚动 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:game-controller" /> 喜欢的游戏
          </h2>
          <div class="about__fav-scroll">
            {profileConfig.favorites.games.map((g) => (
              <figure class:list={["about__fav-card", "about__fav-card--landscape"]}>
                {g.image ? (
                  <img src={g.image} alt={g.name} loading="lazy" decoding="async" />
                ) : (
                  <div class="about__fav-placeholder"><Icon name="ph:game-controller" /></div>
                )}
                <figcaption class="about__fav-name">{g.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>

        {/* 社交平台 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:link" /> 社交平台
          </h2>
          <div class="about__social-links">
            {profileConfig.socials.map((s) => (
              <a
                href={s.url}
                target={s.url.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="about__social-link"
              >
                <Icon name={s.icon} class="about__social-icon" />
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ── 玻璃卡片板块（原 about.md 内容结构化） ── */}
      <div class="about__cards">
        {profileConfig.aboutCards.map((card) => (
          <div class="about__card">
            <h2 class="about__card-title">
              <Icon name={card.icon} /> {card.title}
            </h2>
            {card.body && (
              <div class="about__card-body">
                {card.body.split("\n\n").map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            )}
            {card.links && (
              <ul class="about__card-links">
                {card.links.map((l) => (
                  <li>
                    {l.href ? (
                      <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                        {l.text}
                      </a>
                    ) : (
                      <span>{l.text}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      {/* ── 致谢（赞助名单 + 打赏） ── */}
      <div class="about__card about__card--wide about__thanks">
        <h2 class="about__card-title">
          <Icon name="ph:hand-heart" /> 致谢
        </h2>
        <p class="about__thanks-note">感谢每一位支持者的慷慨解囊，你们的支持是我持续创作最大的动力 ❤️</p>
        <div class="about__thanks-row">
          <ul class="about__thanks-list">
            {sponsors.length > 0 ? sponsors.map((s) => (
              <li class="about__thanks-item">
                {s.avatar ? (
                  <img src={s.avatar} alt={s.name} class="about__thanks-avatar" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                ) : (
                  <span class="about__thanks-avatar about__thanks-avatar--fallback">{s.name.slice(0, 1)}</span>
                )}
                <span class="about__thanks-name">{s.name}</span>
                <span class="about__thanks-date">{s.date}</span>
                <span class="about__thanks-amount">{s.amount}</span>
              </li>
            )) : (
              <li class="about__thanks-empty">还没有赞助记录，第一个支持者就是你~</li>
            )}
          </ul>
          <button class="about__donate-btn" id="btn-donate">
            <Icon name="ph:coffee" /> 打赏作者
          </button>
        </div>
      </div>

      {/* ── 评论区 ── */}
      <div class="about__comments">
        <TwikooComments />
      </div>

    </div>
  </section>

  {/* ── 打赏二维码弹层 ── */}
  <div class="donate-modal" id="donate-modal">
    <div class="donate-modal__backdrop" id="donate-modal-backdrop"></div>
    <div class="donate-modal__card glass-panel">
      <div class="donate-modal__header">
        <span class="donate-modal__title">打赏作者</span>
        <button class="donate-modal__close" id="donate-modal-close" aria-label="关闭">
          <Icon name="ph:x" />
        </button>
      </div>
      <p class="donate-modal__sub">扫描二维码，请小尘喝杯咖啡 ☕</p>
      <div class="donate-modal__qrs">
        <figure class="donate-modal__qr">
          <img src="/sponsors/wechat.svg" alt="微信收款码" loading="lazy" />
          <figcaption>微信</figcaption>
        </figure>
        <figure class="donate-modal__qr">
          <img src="/sponsors/alipay.svg" alt="支付宝收款码" loading="lazy" />
          <figcaption>支付宝</figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  /* 打赏弹层开关 */
  function initDonateModal() {
    const modal = document.getElementById("donate-modal");
    const btn = document.getElementById("btn-donate");
    const close = document.getElementById("donate-modal-close");
    const backdrop = document.getElementById("donate-modal-backdrop");
    if (!modal || !btn) return;

    function open() { modal.classList.add("open"); modal.classList.add("visible"); }
    function closeModal() {
      modal.classList.remove("visible");
      setTimeout(() => modal.classList.remove("open"), 200);
    }
    btn.addEventListener("click", open);
    close?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);
    document.addEventListener("keydown", function onEsc(e) {
      if (e.key === "Escape" && modal.classList.contains("visible")) closeModal();
    });
  }
  document.addEventListener("DOMContentLoaded", initDonateModal);
  document.addEventListener("astro:page-load", initDonateModal);
</script>

<style>
  /* ── Hero ── */
  .about__hero {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-16) 0 var(--space-10);
  }

  .about__avatar-wrap {
    flex-shrink: 0;
    padding: 3px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, oklch(0.7 0.18 var(--hue)), oklch(0.7 0.15 calc(var(--hue) + 60)));
  }

  .about__avatar {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: var(--radius-full);
    border: 3px solid var(--surface-0);
    display: block;
  }

  .about__hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .about__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0;
  }

  .about__motto {
    font-size: var(--text-base);
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── 卡片网格 ── */
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .about__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  /* 直接在元素上做液态玻璃 */
  .about__card {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition: box-shadow var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .about__card:hover {
    box-shadow: var(--shadow-md), var(--glass-highlight);
  }

  .about__card--wide {
    grid-column: 1 / -1;
  }

  .about__card-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-3);
  }

  .about__card-title svg {
    width: 16px;
    height: 16px;
    opacity: 0.6;
  }

  /* ── 基础信息 ── */
  .about__info-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about__info-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .about__info-label {
    color: var(--foreground-muted);
  }

  .about__info-value {
    color: var(--foreground);
    font-weight: 500;
  }

  /* ── 性格 ── */
  .about__mbti {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 var(--space-1);
  }

  .about__mbti-desc {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── Hero 身份标签 ── */
  .about__identities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .about__identity {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    background: oklch(from var(--accent) l c h / 0.12);
    border: 1px solid oklch(from var(--accent) l c h / 0.2);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  /* ── 技能图标墙（整块可点跳 /skills/） ── */
  .about__skill-wall {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about__skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: oklch(1 0 0 / 0.35);
    border: 1px solid var(--glass-border);
    transition: transform var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  :global(.dark) .about__skill-icon {
    background: oklch(1 0 0 / 0.06);
  }

  .about__skill-icon:hover {
    transform: translateY(-2px) scale(1.06);
    border-color: oklch(from var(--accent) l c h / 0.35);
  }

  .about__skill-icon [data-icon] {
    width: 24px;
    height: 24px;
  }

  /* ── 番 / 游戏 — 图片卡片横向滚动 ── */
  .about__fav-scroll {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-2);
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .about__fav-scroll::-webkit-scrollbar { height: 6px; }
  .about__fav-scroll::-webkit-scrollbar-track { background: transparent; }
  .about__fav-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-sm); }

  /* 竖版卡片（番剧，MAL 封面 3:4） */
  .about__fav-card {
    flex: 0 0 150px;
    margin: 0;
    scroll-snap-align: start;
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    background: var(--surface-2);
    border: 1px solid var(--glass-border);
  }

  .about__fav-card img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center;
  }

  /* 横版卡片（游戏，Steam capsule 16:9） */
  .about__fav-card--landscape {
    flex-basis: 220px;
  }

  .about__fav-card--landscape img {
    aspect-ratio: 16 / 9;
  }

  .about__fav-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    color: var(--foreground-muted);
    background: linear-gradient(160deg, var(--surface-2), var(--surface-3));
  }

  .about__fav-card--landscape .about__fav-placeholder {
    aspect-ratio: 16 / 9;
  }

  .about__fav-placeholder [data-icon] { width: 32px; height: 32px; }

  .about__fav-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-2) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    color: #fff;
    text-align: center;
    background: linear-gradient(transparent, oklch(0 0 0 / 0.75));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── 社交 ── */
  .about__social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid oklch(from var(--accent) l c h / 0.25);
    transition: all var(--duration-fast) var(--ease-material);
  }

  .about__social-link:hover {
    background: oklch(from var(--accent) l c h / 0.1);
    border-color: oklch(from var(--accent) l c h / 0.4);
  }

  .about__social-icon {
    width: 14px;
    height: 14px;
  }

  /* ── 玻璃卡片板块 ── */
  .about__card-body p {
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--foreground-secondary);
    margin: 0 0 var(--space-2);
  }
  .about__card-body p:last-child { margin-bottom: 0; }

  .about__card-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about__card-links li {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    line-height: 1.6;
  }
  .about__card-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .about__card-links a:hover {
    text-decoration: underline;
  }

  /* ── 致谢 ── */
  .about__thanks {
    margin-bottom: var(--space-10);
  }
  .about__thanks-note {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0 0 var(--space-4);
    line-height: 1.7;
  }
  .about__thanks-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .about__thanks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }
  .about__thanks-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: oklch(1 0 0 / 0.35);
    border: 1px solid var(--glass-border);
  }
  :global(.dark) .about__thanks-item {
    background: oklch(1 0 0 / 0.06);
  }
  .about__thanks-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--glass-border);
    background: var(--surface-2);
  }
  .about__thanks-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .about__thanks-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
  }
  .about__thanks-date {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }
  .about__thanks-amount {
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .about__thanks-empty {
    font-size: var(--text-sm);
    color: var(--foreground-muted);
  }
  .about__donate-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-material),
                opacity var(--duration-fast) var(--ease-material);
  }
  .about__donate-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }
  .about__donate-btn [data-icon] {
    width: 16px;
    height: 16px;
  }

  /* ── 评论区（加宽后限宽保证评论列表可读） ── */
  .about__comments {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  /* ── 打赏弹层 ── */
  .donate-modal {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-material);
  }
  .donate-modal.open { pointer-events: auto; }
  .donate-modal.visible { opacity: 1; }
  .donate-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .donate-modal__card {
    position: relative;
    z-index: 1;
    padding: var(--space-5);
    min-width: 320px;
    max-width: 480px;
    text-align: center;
    transform: scale(0.92) translateY(8px);
    transition: transform 0.2s var(--ease-material);
  }
  .donate-modal.visible .donate-modal__card {
    transform: scale(1) translateY(0);
  }
  .donate-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .donate-modal__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
  }
