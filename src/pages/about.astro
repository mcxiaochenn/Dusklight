---
/**
 * 关于页面
 */
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import { profileConfig } from "../config/profile";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead title="关于 - Dusklight Blog" description="关于我" />
  </head>

  <body>
    <Header />

    <main class="about">
      <div class="about__header">
        <h1 class="about__title">关于我</h1>
      </div>

      <div class="about__content glass">
        <div class="about__profile">
          <img
            src={profileConfig.avatar}
            alt={profileConfig.name}
            class="about__avatar"
          />
          <h2 class="about__name">{profileConfig.name}</h2>
          <p class="about__bio">{profileConfig.bio}</p>
        </div>

        <div class="about__description">
          <p>{profileConfig.description}</p>
        </div>

        {profileConfig.skills && profileConfig.skills.length > 0 && (
          <div class="about__skills">
            <h3>技能标签</h3>
            <div class="about__skill-tags">
              {profileConfig.skills.map((skill) => (
                <span class="about__skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .about {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .about__header {
    margin-bottom: var(--space-6);
  }

  .about__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }

  .about__content {
    padding: var(--space-6);
  }

  .about__profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .about__avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  .about__name {
    margin: 0 0 var(--space-2) 0;
    font-size: 1.5rem;
  }

  .about__bio {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .about__description {
    margin-bottom: var(--space-6);
    line-height: 1.8;
  }

  .about__skills h3 {
    margin: 0 0 var(--space-3) 0;
    font-size: 1.125rem;
  }

  .about__skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about__skill-tag {
    padding: 4px 12px;
    border-radius: 6px;
    background: rgba(35, 55, 255, 0.08);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
