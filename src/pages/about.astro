---
/**
 * 关于页面 — liushen 风格：头像行 + 信息卡片网格 + Markdown
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/ui/Tag.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config/profile";
import { skillsData } from "@/data/skills";
import { getEntry, render } from "astro:content";

const aboutEntry = await getEntry("spec", "about");
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<BaseLayout title="关于" description={`关于 ${profileConfig.name}`}>
  <section class="about section">
    <div class="page-container">

      {/* ── Hero：头像 + 名字 + bio ── */}
      <div class="about__hero">
        <div class="about__avatar-wrap">
          <img src={profileConfig.avatar} alt={profileConfig.name} class="about__avatar" />
        </div>
        <div class="about__hero-text">
          <h1 class="about__name">{profileConfig.name}</h1>
          <p class="about__motto">{profileConfig.bio}</p>
          <div class="about__identities">
            {profileConfig.identities.map((t) => (
              <span class="about__identity">{t}</span>
            ))}
          </div>
        </div>
      </div>

      {/* ── 卡片网格 ── */}
      <div class="about__grid">
        {/* 基础信息 */}
        <div class="about__card about__card--info">
          <h2 class="about__card-title">
            <Icon name="ph:user" /> 基础信息
          </h2>
          <div class="about__info-list">
            <div class="about__info-row">
              <span class="about__info-label">位置</span>
              <span class="about__info-value">{profileConfig.location}</span>
            </div>
            <div class="about__info-row">
              <span class="about__info-label">邮箱</span>
              <span class="about__info-value">{profileConfig.email}</span>
            </div>
          </div>
        </div>

        {/* 性格侧写 */}
        <div class="about__card about__card--personality">
          <h2 class="about__card-title">
            <Icon name="ph:brain" /> 性格侧写
          </h2>
          <p class="about__mbti">{profileConfig.mbti}</p>
          <p class="about__mbti-desc">{profileConfig.mbtiDesc}</p>
        </div>

        {/* 技能墙 — 与 /skills/ 页同源数据 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:code" /> 技能
          </h2>
          <div class="about__skill-wall">
            {skillsData.map((s) => (
              <span class="about__skill-icon" title={s.name}>
                <Icon name={s.icon} />
              </span>
            ))}
          </div>
        </div>

        {/* 喜欢的番 */}
        <div class="about__card">
          <h2 class="about__card-title">
            <Icon name="ph:television-simple" /> 喜欢的番
          </h2>
          <div class="about__fav-tags">
            {profileConfig.favorites.anime.map((a) => <Tag>{a}</Tag>)}
          </div>
        </div>

        {/* 喜欢的游戏 */}
        <div class="about__card">
          <h2 class="about__card-title">
            <Icon name="ph:game-controller" /> 喜欢的游戏
          </h2>
          <div class="about__fav-tags">
            {profileConfig.favorites.games.map((g) => <Tag>{g}</Tag>)}
          </div>
        </div>

        {/* 社交平台 */}
        <div class="about__card about__card--wide">
          <h2 class="about__card-title">
            <Icon name="ph:link" /> 社交平台
          </h2>
          <div class="about__social-links">
            {profileConfig.socials.map((s) => (
              <a
                href={s.url}
                target={s.url.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="about__social-link"
              >
                <Icon name={s.icon} class="about__social-icon" />
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* ── Markdown 内容区 ── */}
      {Content && (
        <div class="about__md prose">
          <Content />
        </div>
      )}

      {!Content && (
        <div class="about__sections">
          {profileConfig.sections.map((sec) => (
            <article class="about__section">
              <h2 class="about__section-title">{sec.title}</h2>
              <p class="about__section-content">{sec.content}</p>
            </article>
          ))}
        </div>
      )}

    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .about__hero {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-16) 0 var(--space-10);
  }

  .about__avatar-wrap {
    flex-shrink: 0;
    padding: 3px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, oklch(0.7 0.18 var(--hue)), oklch(0.7 0.15 calc(var(--hue) + 60)));
  }

  .about__avatar {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: var(--radius-full);
    border: 3px solid var(--surface-0);
    display: block;
  }

  .about__hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .about__name {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0;
  }

  .about__motto {
    font-size: var(--text-base);
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── 卡片网格 ── */
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  /* 直接在元素上做液态玻璃 */
  .about__card {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition: box-shadow var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .about__card:hover {
    box-shadow: var(--shadow-md), var(--glass-highlight);
  }

  .about__card--wide {
    grid-column: 1 / -1;
  }

  .about__card-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-3);
  }

  .about__card-title svg {
    width: 16px;
    height: 16px;
    opacity: 0.6;
  }

  /* ── 基础信息 ── */
  .about__info-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .about__info-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .about__info-label {
    color: var(--foreground-muted);
  }

  .about__info-value {
    color: var(--foreground);
    font-weight: 500;
  }

  /* ── 性格 ── */
  .about__mbti {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 var(--space-1);
  }

  .about__mbti-desc {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── Hero 身份标签 ── */
  .about__identities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .about__identity {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    background: oklch(from var(--accent) l c h / 0.12);
    border: 1px solid oklch(from var(--accent) l c h / 0.2);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  /* ── 技能图标墙 ── */
  .about__skill-wall {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about__skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: oklch(1 0 0 / 0.35);
    border: 1px solid var(--glass-border);
    transition: transform var(--duration-fast) var(--ease-material);
  }

  :global(.dark) .about__skill-icon {
    background: oklch(1 0 0 / 0.06);
  }

  .about__skill-icon:hover {
    transform: translateY(-2px) scale(1.06);
  }

  .about__skill-icon [data-icon] {
    width: 24px;
    height: 24px;
  }

  /* ── 番 / 游戏 ── */
  .about__fav-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ── 社交 ── */
  .about__social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid oklch(from var(--accent) l c h / 0.25);
    transition: all var(--duration-fast) var(--ease-material);
  }

  .about__social-link:hover {
    background: oklch(from var(--accent) l c h / 0.1);
    border-color: oklch(from var(--accent) l c h / 0.4);
  }

  .about__social-icon {
    width: 14px;
    height: 14px;
  }

  /* ── 简介 ── */
  .about__intro-text {
    font-size: var(--text-base);
    color: var(--foreground-secondary);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Markdown ── */
  .about__md {
    max-width: var(--content-width);
    margin: 0 auto var(--space-16);
  }

  /* ── Fallback ── */
  .about__sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .about__section-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }

  .about__section-content {
    font-size: var(--text-base);
    color: var(--foreground-secondary);
    line-height: 1.8;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .about__hero {
      padding: var(--space-10) 0 var(--space-6);
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__avatar {
      width: 72px;
      height: 72px;
    }
  }
</style>
