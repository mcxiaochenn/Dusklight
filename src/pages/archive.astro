---
/**
 * 归档页面
 * 按年份分组展示所有文章
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getPostUrl } from "@/utils/abbrlink";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="归档" description="所有文章归档">
  <section class="archive section">
    <div class="content-container">
      <h1 class="archive__title">文章归档</h1>
      <p class="archive__count">共 {posts.length} 篇文章</p>

      {years.map((year) => (
        <section class="archive__year">
          <h2 class="archive__year-title">{year}</h2>
          <ul class="archive__list">
            {postsByYear[year].map((post) => (
              <li class="archive__item">
                <a href={getPostUrl(post)} class="archive__link">
                  <span class="archive__date"><FormattedDate date={post.data.date} /></span>
                  <span class="archive__post-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .archive__title { font-size: var(--text-xl); font-weight: 700; margin: 0 0 var(--space-2); }
  .archive__count { color: var(--foreground-muted); margin: 0 0 var(--space-10); }
  .archive__year { margin-bottom: var(--space-8); }
  .archive__year-title {
    font-size: var(--text-lg); font-weight: 600;
    margin: 0 0 var(--space-4); padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--accent); display: inline-block;
  }
  .archive__list { display: flex; flex-direction: column; gap: var(--space-1); }
  .archive__link {
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-md);
    text-decoration: none; color: var(--foreground);
    transition: background var(--duration-fast) var(--ease-material);
  }
  .archive__link:hover { background: var(--glass-bg); }
  .archive__date { color: var(--foreground-muted); font-size: var(--text-sm); min-width: 100px; }
  .archive__post-title { font-weight: 500; font-size: var(--text-sm); }
  @media (max-width: 768px) {
    .archive__link { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  }
</style>
