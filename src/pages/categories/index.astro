---
/**
 * 分类索引页 — 展示所有分类及文章数量
 * 与标签索引页同构；分类来自 frontmatter 的 category 字段
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TaxonomyBar from "../../components/blog/TaxonomyBar.astro";

const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
const catMap = new Map<string, number>();
posts.forEach((post) => {
  const cat = post.data.category?.trim();
  if (cat) catMap.set(cat, (catMap.get(cat) || 0) + 1);
});
const sortedCats = [...catMap.entries()].sort((a, b) => b[1] - a[1]);
const categoryItems = sortedCats.map(([name, count]) => ({ name, count }));
---

<BaseLayout title="分类" description="所有文章分类">
  <section class="categories-index section">
    <div class="content-container">
      <div class="categories-index__header">
        <h1 class="categories-index__title">分类</h1>
        <p class="categories-index__count">共 {sortedCats.length} 个分类</p>
      </div>
      <div class="categories-index__bar">
        <TaxonomyBar kind="categories" items={categoryItems} indexActive />
      </div>
      <div class="categories-index__cloud">
        {sortedCats.map(([cat, count]) => (
          <a href={`/categories/${encodeURIComponent(cat)}/`} class="categories-index__item">
            <span class="categories-index__name">{cat}</span>
            <span class="categories-index__num">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .categories-index__header {
    margin-bottom: var(--space-5);
  }

  .categories-index__bar {
    margin-bottom: var(--space-8);
  }

  .categories-index__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  .categories-index__count {
    color: var(--foreground-muted);
    margin: 0;
  }

  .categories-index__cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .categories-index__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    color: var(--foreground);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .categories-index__item:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }

  .categories-index__name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .categories-index__num {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 700;
    background: oklch(from var(--accent) l c h / 0.12);
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
  }
</style>
