---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrowsePostList from "../../components/blog/BrowsePostList.astro";
import TaxonomyBar from "../../components/blog/TaxonomyBar.astro";
import { groupTopics } from "@/utils/browse";
import "../../styles/browse.css";
export const getStaticPaths = (async () => {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  const topics = groupTopics(posts, "categories");
  return topics.map((topic) => {
    const items = topics.slice(0, 12).map(({ name, count }) => ({ name, count }));
    if (!items.some(({ name }) => name === topic.name)) items.push({ name: topic.name, count: topic.count });
    return { params: { category: topic.name }, props: { topic, items } };
  });
}) satisfies GetStaticPaths;
const { topic, items } = Astro.props;
---
<BaseLayout title={`分类: ${topic.name}`} description={`分类 ${topic.name} 下的 ${topic.count} 篇文章`}>
  <section class="section"><div class="content-container">
    <a class="browse-back" href="/categories/">‹ 返回全部分类</a>
    <header class="browse-header"><h1>{topic.name}</h1><p>分类 / 共 {topic.count} 篇文章</p></header>
    <div class="browse-topics"><TaxonomyBar kind="categories" items={items} current={topic.name} /></div>
    <BrowsePostList posts={topic.posts} />
  </div></section>
</BaseLayout>
