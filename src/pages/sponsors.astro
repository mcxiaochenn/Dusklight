---
/**
 * 赞助页 — spec/sponsors.md 文案 + 赞助名单 + Twikoo 评论
 * URL /sponsors/ 与生产站一致，评论线程按路径延续
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { getEntry, render } from "astro:content";
import { getSortedSponsors } from "@/data/sponsors";

const entry = await getEntry("spec", "sponsors");
const { Content } = entry ? await render(entry) : { Content: null };
const sponsors = getSortedSponsors();
---

<BaseLayout title="赞助" description="感谢每一位支持者">
  <section class="section">
    <div class="content-container">
      {Content && (
        <div class="prose sponsors__intro">
          <Content />
        </div>
      )}

      <div class="sponsors__list">
        {sponsors.map((s) => (
          <div class="sponsor-card">
            {s.avatar ? (
              <img
                src={s.avatar}
                alt={s.name}
                class="sponsor-card__avatar"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            ) : (
              <span class="sponsor-card__avatar sponsor-card__avatar--fallback">
                {s.name.slice(0, 1)}
              </span>
            )}
            <div class="sponsor-card__body">
              {s.link ? (
                <a href={s.link} target="_blank" rel="noopener noreferrer" class="sponsor-card__name">
                  {s.name}
                </a>
              ) : (
                <span class="sponsor-card__name">{s.name}</span>
              )}
              <span class="sponsor-card__date">{s.date}</span>
            </div>
            <span class="sponsor-card__amount">{s.amount}</span>
          </div>
        ))}
      </div>

      <TwikooComments />
    </div>
  </section>
</BaseLayout>

<style>
  .sponsors__intro {
    margin-bottom: var(--space-6);
  }

  .sponsors__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sponsor-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  .sponsor-card__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--glass-border);
    background: var(--surface-2);
  }

  .sponsor-card__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    font-weight: 700;
  }

  .sponsor-card__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .sponsor-card__name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
    text-decoration: none;
  }

  a.sponsor-card__name:hover {
    color: var(--accent);
  }

  .sponsor-card__date {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }

  .sponsor-card__amount {
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
