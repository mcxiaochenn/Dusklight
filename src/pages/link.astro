---
/**
 * 友链页 — v4
 * 结构：标题 → 信息+须知(左右双栏) → 朋友圈摘要 → 分组卡片墙 → Twikoo
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import { friendsData, siteInfo } from "@/data/friends";
import { siteConfig } from "@/config";

const groupOrder = ["技术", "生活", "企业"] as const;

const groups = new Map<string, typeof friendsData>();
for (const f of friendsData) {
  const cat = f.tags[0] ?? "其他";
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(f);
}
---

<BaseLayout title="友链" description={`${friendsData.length} 位朋友的博客`}>
  <section class="section">
    <div class="page-container">

      {/* ── 页面标题 ── */}
      <header class="links-header">
        <h1 class="links-header__title">友情链接</h1>
        <p class="links-header__sub">共 {friendsData.length} 位朋友 · 排名不分先后</p>
      </header>

      {/* ── 信息卡 + 申请须知（左右双栏，底部免责声明横跨） ── */}
      <div class="info-card glass-card">
        <div class="info-card__columns">
          {/* 左栏：我的信息 */}
          <div class="info-card__left">
            <div class="info-card__identity">
              <img
                src={siteInfo.avatar}
                alt={siteInfo.name}
                class="info-card__avatar"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
              <div>
                <span class="info-card__name">{siteInfo.name}</span>
                <p class="info-card__motto">{siteInfo.motto}</p>
              </div>
            </div>
            <div class="info-card__fields">
              <div class="info-field" data-copy={siteInfo.avatar}>
                <span class="info-field__label">头像</span>
                <span class="info-field__value">{siteInfo.avatar}</span>
                <button class="info-field__copy" aria-label="复制头像链接">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </div>
              <div class="info-field" data-copy={siteInfo.url}>
                <span class="info-field__label">链接</span>
                <span class="info-field__value">{siteInfo.url}</span>
                <button class="info-field__copy" aria-label="复制链接">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </div>
              <div class="info-field" data-copy={siteInfo.motto}>
                <span class="info-field__label">描述</span>
                <span class="info-field__value">{siteInfo.motto}</span>
                <button class="info-field__copy" aria-label="复制描述">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </div>
              <div class="info-field">
                <span class="info-field__label">标签</span>
                <span class="info-field__value info-field__tags">
                  {siteInfo.tags.map((t) => (
                    <span class="info-tag">{t}</span>
                  ))}
                </span>
              </div>
            </div>
          </div>

          {/* 右栏：友链申请须知 */}
          <div class="info-card__right">
            <h2 class="info-card__section-title">友链申请须知</h2>
            <ol class="rules-list">
              <li><span class="rule-num">1</span>请先添加本站友链，确保站点可正常访问</li>
              <li><span class="rule-num">2</span>需有清晰的名称、描述和头像，建站满 1 个月</li>
              <li><span class="rule-num">3</span>拥有原创内容，符合相关法律法规</li>
              <li><span class="rule-num">4</span>保持一定的更新频率，热爱分享</li>
              <li><span class="rule-num">5</span>申请时请注明博客类型（技术 / 生活 / 个人 / 企业）</li>
            </ol>
            <p class="rules-hint">在下方评论区留言即可申请，格式参考：名称 · 链接 · 头像 · 描述 · 标签</p>
          </div>

          {/* 右栏：操作按钮 */}
          <div class="info-card__buttons">
            <button class="links-btn links-btn--glass" id="btn-random-visit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              随机访问
            </button>
            <button class="links-btn" id="btn-apply-friend">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
              申请友链
            </button>
          </div>
        </div>

        {/* 底部免责声明（横跨全宽） */}
        <hr class="info-card__divider" />
        <details class="disclaimer">
          <summary>友情链接页免责声明</summary>
          <div class="disclaimer__body">
            <p>本博客遵守中华人民共和国相关法律。本页内容仅作为方便学习而产生的快速链接的链接方式，对与友情链接中存在的链接、好文推荐链接等均为其他网站。我本人能力有限无法逐个甄别每篇文章的每个字，并无法获知是否在收录后原作者是否对链接增加了违反法律甚至其他破坏用户计算机等行为。</p>
            <p>所以在我力所能及的情况下，我会包括但不限于：</p>
            <ul>
              <li>针对收录的博客中的绝大多数内容通过标题来鉴别是否存在有风险的内容</li>
              <li>在收录的友链好文推荐中检查是否存在风险内容</li>
            </ul>
            <p>但是你在访问的时候，仍然无法避免，包括但不限于：</p>
            <ul>
              <li>作者更换了超链接的指向，替换成了其他内容</li>
              <li>作者的服务器被恶意攻击、劫持、被注入恶意内容</li>
              <li>作者的域名到期，被不法分子用作他用</li>
              <li>作者修改了文章内容，增加钓鱼网站、广告等无效信息</li>
            </ul>
            <p>如果因为从本页跳转给你造成了损失，深表歉意，并且建议用户如果发现存在问题在本页面进行回复。通常会很快处理。</p>
          </div>
        </details>
      </div>

      {/* ── 朋友圈摘要 ── */}
      <section class="fcl-summary" id="fcl-summary">
        <div class="fcl-summary__header">
          <h2 class="fcl-summary__title">朋友圈动态</h2>
          <a href="/Friend-Circle-Lite/" class="fcl-summary__more">查看全部 →</a>
        </div>
        <div class="fcl-summary__grid" id="fcl-summary-grid">
          <div class="fcl-skeleton glass-card"></div>
          <div class="fcl-skeleton glass-card"></div>
          <div class="fcl-skeleton glass-card"></div>
          <div class="fcl-skeleton glass-card"></div>
          <div class="fcl-skeleton glass-card"></div>
          <div class="fcl-skeleton glass-card"></div>
        </div>
      </section>

      {/* ── 分组友链卡片墙 ── */}
      {groupOrder.map((cat) => {
        const list = groups.get(cat);
        if (!list?.length) return null;
        return (
          <section class="friend-group">
            <h2 class="friend-group__title">
              <span class="friend-group__name">{cat}</span>
              <span class="friend-group__count">{list.length}</span>
            </h2>
            <div class="friend-grid">
              {list.map((f) => (
                <a
                  href={f.siteurl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-card glass-card"
                >
                  <div class="friend-card__head">
                    <div class="friend-card__avatar-wrap">
                      <img
                        src={f.imgurl}
                        alt={f.title}
                        class="friend-card__avatar"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.src='/images/avatar-fallback.svg';this.onerror=null"
                      />
                    </div>
                    <div class="friend-card__info">
                      <span class="friend-card__name">{f.title}</span>
                      <span class="friend-card__url">{new URL(f.siteurl).hostname}</span>
                    </div>
                  </div>
                  <p class="friend-card__desc">{f.desc}</p>
                </a>
              ))}
            </div>
          </section>
        );
      })}

    </div>

    <div class="link-comments">
      <TwikooComments />
    </div>
  </section>
</BaseLayout>

{/* ── 朋友圈摘要客户端 fetch ── */}
<script is:inline define:vars={{ fcliteApiUrl: siteConfig.fcliteApiUrl }}>
  (function () {
    var API = fcliteApiUrl + "all.json";
    var COUNT = 6;
    var grid = document.getElementById("fcl-summary-grid");
    if (!grid) return;

    function escapeHtml(s) {
      var d = document.createElement("div");
      d.appendChild(document.createTextNode(s));
      return d.innerHTML;
    }

    function render(articles) {
      grid.innerHTML = "";
      for (var i = 0; i < Math.min(articles.length, COUNT); i++) {
        var a = articles[i];
        var el = document.createElement("a");
        el.href = a.link;
        el.target = "_blank";
        el.rel = "noopener noreferrer";
        el.className = "fcl-card glass-card";
        el.innerHTML =
          '<img class="fcl-card__avatar" src="' + escapeHtml(a.avatar) + '" alt="' + escapeHtml(a.author) + '" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.src=\'/images/avatar-fallback.svg\';this.onerror=null">' +
          '<div class="fcl-card__body">' +
            '<span class="fcl-card__title">' + escapeHtml(a.title) + '</span>' +
            '<span class="fcl-card__meta">' + escapeHtml(a.author) + ' · ' + escapeHtml(a.created) + '</span>' +
          '</div>';
        grid.appendChild(el);
      }
    }

    fetch(API)
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d.article_data && d.article_data.length) render(d.article_data); })
      .catch(function () {
        grid.innerHTML = '<p class="fcl-summary__error">朋友圈动态加载失败，<a href="/Friend-Circle-Lite/">前往查看 →</a></p>';
      });
  })();
</script>

{/* ── 随机访问确认模态框 ── */}
<div class="random-modal" id="random-modal">
  <div class="random-modal__backdrop" id="random-modal-backdrop"></div>
  <div class="random-modal__card glass-card">
    <p class="random-modal__heading">随机访问</p>
    <div class="random-modal__info">
      <img class="random-modal__avatar" id="random-modal-avatar" src="" alt="" />
      <div class="random-modal__text">
        <span class="random-modal__name" id="random-modal-name"></span>
        <span class="random-modal__url" id="random-modal-url"></span>
      </div>
    </div>
    <p class="random-modal__desc" id="random-modal-desc"></p>
    <div class="random-modal__actions">
      <button class="random-modal__btn random-modal__btn--cancel" id="random-modal-cancel">取消</button>
      <button class="random-modal__btn random-modal__btn--confirm" id="random-modal-confirm">访问</button>
    </div>
  </div>
</div>

{/* ── 按钮功能 + 信息卡点击复制 ── */}
<script is:inline>
  document.addEventListener("click", function (e) {
    var btn = e.target.closest(".info-field__copy");
    if (!btn) return;
    var field = btn.closest(".info-field");
    if (!field) return;
    var text = field.dataset.copy;
    if (!text) return;
    navigator.clipboard.writeText(text).then(function () {
      btn.classList.add("copied");
      setTimeout(function () { btn.classList.remove("copied"); }, 1500);
    });
  });
</script>

{/* ── 随机访问 + 申请友链按钮 ── */}
<script is:inline define:vars={{ friendsJson: JSON.stringify(friendsData.map(f => ({ title: f.title, url: f.siteurl, avatar: f.imgurl, desc: f.desc }))) }}>
  (function () {
    var friends = JSON.parse(friendsJson);
    var modal = document.getElementById("random-modal");
    var pending = null;

    var avatarEl = document.getElementById("random-modal-avatar");
    var nameEl = document.getElementById("random-modal-name");
    var urlEl = document.getElementById("random-modal-url");
    var descEl = document.getElementById("random-modal-desc");

    function showModal(friend) {
      pending = friend;
      avatarEl.src = friend.avatar;
      avatarEl.alt = friend.title;
      nameEl.textContent = friend.title;
      urlEl.textContent = new URL(friend.url).hostname;
      descEl.textContent = friend.desc;
      modal.classList.add("open");
      requestAnimationFrame(function () { modal.classList.add("visible"); });
    }
    function hideModal() {
      modal.classList.remove("visible");
      setTimeout(function () { modal.classList.remove("open"); pending = null; }, 200);
    }

    document.getElementById("btn-random-visit").addEventListener("click", function () {
      var f = friends[Math.floor(Math.random() * friends.length)];
      showModal(f);
    });
    document.getElementById("random-modal-confirm").addEventListener("click", function () {
      if (pending) window.open(pending.url, "_blank", "noopener");
      hideModal();
    });
    document.getElementById("random-modal-cancel").addEventListener("click", hideModal);
    document.getElementById("random-modal-backdrop").addEventListener("click", hideModal);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("open")) hideModal();
    });

    document.getElementById("btn-apply-friend").addEventListener("click", function () {
      var el = document.getElementById("twikoo");
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>

<style>
  /* ── 评论区：与友链卡墙同宽容器，但限宽 900px 保持评论列表可读 ── */
  .link-comments {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* ── 页面标题 ── */
  .links-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .links-header__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }
  .links-header__sub {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── 毛玻璃卡片基类（scoped + global） ── */
  .glass-card {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }
  :global(.glass-card) {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  /* ── 信息卡（左右双栏） ── */
  .info-card {
    padding: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .info-card__columns {
    display: flex;
    gap: var(--space-5);
  }
  @media (max-width: 768px) {
    .info-card__columns {
      flex-direction: column;
      gap: var(--space-5);
    }
  }

  /* 左栏 */
  .info-card__left {
    flex: 1;
    min-width: 0;
  }
  .info-card__identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .info-card__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
    background: var(--surface-2);
    flex-shrink: 0;
  }
  .info-card__name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--foreground);
    display: block;
  }
  .info-card__motto {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
    margin: 2px 0 0;
  }

  /* 可复制字段（玻璃效果） */
  .info-card__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .info-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    font-size: var(--text-xs);
    min-height: 36px;
  }
  .info-field__label {
    flex-shrink: 0;
    width: 36px;
    font-weight: 600;
    color: var(--foreground-muted);
    text-align: right;
  }
  .info-field__value {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--foreground-secondary);
    user-select: all;
  }
  .info-field__tags {
    display: flex;
    gap: var(--space-1);
    white-space: normal;
  }
  .info-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: color-mix(in oklch, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  /* 复制按钮 */
  .info-field__copy {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--foreground-muted);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-material),
                color var(--duration-fast) var(--ease-material);
    padding: 0;
  }
  .info-field__copy:hover {
    background: var(--surface-2);
    color: var(--foreground);
  }
  .info-field__copy svg {
    width: 14px;
    height: 14px;
  }
  .info-field__copy .check-icon {
    display: none;
    color: var(--accent);
  }
  .info-field__copy.copied .copy-icon {
    display: none;
  }
  .info-field__copy.copied .check-icon {
    display: inline-flex;
  }

  /* 右栏 */
  .info-card__right {
    flex: 1;
    min-width: 0;
  }
  .info-card__section-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
    margin: 0 0 var(--space-4);
  }

  /* ── 申请须知 ── */
  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .rules-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    line-height: 1.6;
  }
  .rule-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: color-mix(in oklch, var(--accent) 15%, transparent);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .rules-hint {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
    margin: 0;
    line-height: 1.6;
