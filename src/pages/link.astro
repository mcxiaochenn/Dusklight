---
/**
 * 友链页 — src/data/friends.ts 卡片墙 + Twikoo 评论
 * URL /link/ 与生产站一致（单数），评论线程按路径延续
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TwikooComments from "../components/blog/TwikooComments.astro";
import Tag from "../components/ui/Tag.astro";
import { friendsData } from "@/data/friends";
---

<BaseLayout title="友链" description={`${friendsData.length} 位朋友的博客`}>
  <section class="section">
    <div class="page-container">
      <header class="links__header">
        <h1 class="links__title">友情链接</h1>
        <p class="links__subtitle">共 {friendsData.length} 位朋友 · 排名不分先后</p>
        <a href="/Friend-Circle-Lite/" class="links__fcl">友链朋友圈 →</a>
      </header>

      <div class="links__grid">
        {friendsData.map((f) => (
          <a
            href={f.siteurl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-card"
          >
            <img
              src={f.imgurl}
              alt={f.title}
              class="link-card__avatar"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.src='/images/avatar-fallback.svg';this.onerror=null"
            />
            <div class="link-card__body">
              <span class="link-card__title">{f.title}</span>
              <span class="link-card__desc">{f.desc}</span>
              {f.tags.length > 0 && (
                <span class="link-card__tags">
                  {f.tags.map((t) => <Tag>{t}</Tag>)}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="content-container">
      <TwikooComments />
    </div>
  </section>
</BaseLayout>

<style>
  .links__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .links__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }

  .links__subtitle {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    margin: 0;
  }

  .links__fcl {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .links__fcl:hover {
    text-decoration: underline;
  }

  .links__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .link-card {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    text-decoration: none;
    transition: box-shadow var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material),
                transform var(--duration-fast) var(--ease-material);
  }

  .link-card:hover {
    box-shadow: var(--shadow-md), var(--glass-highlight);
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .link-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--glass-border);
    background: var(--surface-2);
  }

  .link-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .link-card__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-card__desc {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--foreground-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .link-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  @media (max-width: 640px) {
    .links__grid {
      grid-template-columns: 1fr 1fr;
    }

    .link-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .link-card__title,
    .link-card__desc {
      text-align: center;
    }

    .link-card__tags {
      justify-content: center;
    }
  }
</style>
