---
/**
 * 标签索引页 — 展示所有标签及文章数量
 * 与分类索引页同构：玻璃圆形 pill 样式
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TaxonomyBar from "../../components/blog/TaxonomyBar.astro";

// 与首页/归档/RSS 保持一致地排除草稿 —— Astro 5+ 的 content layer 对
// draft 无内置语义，不过滤的话草稿会被计入标签云与各标签的文章数
const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
const tagMap = new Map<string, number>();
posts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    const name = tag.trim();
    if (name) tagMap.set(name, (tagMap.get(name) || 0) + 1);
  });
});
const sortedTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
const tagItems = sortedTags.slice(0, 12).map(([name, count]) => ({ name, count }));
---

<BaseLayout title="标签" description="所有文章标签">
  <section class="tags-index section">
    <div class="content-container">
      <div class="tags-index__header">
        <h1 class="tags-index__title">标签</h1>
        <p class="tags-index__count">共 {sortedTags.length} 个标签</p>
      </div>
      <div class="tags-index__bar">
        <TaxonomyBar kind="tags" items={tagItems} indexActive />
      </div>
      <div class="tags-index__cloud">
        {sortedTags.map(([tag, count]) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`} class="tags-index__item">
            <span class="tags-index__name">{tag}</span>
            <span class="tags-index__num">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tags-index__header {
    margin-bottom: var(--space-5);
  }

  .tags-index__bar {
    margin-bottom: var(--space-8);
  }

  .tags-index__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  .tags-index__count {
    color: var(--foreground-muted);
    margin: 0;
  }

  .tags-index__cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .tags-index__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    color: var(--foreground);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .tags-index__item:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }

  .tags-index__name {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .tags-index__num {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 700;
    background: oklch(from var(--accent) l c h / 0.12);
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
  }
</style>
