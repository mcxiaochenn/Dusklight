---
/**
 * 版权声明页 — 框架 MIT + 内容 CC BY-NC-ND 4.0
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config/site";
---

<BaseLayout title="版权声明" description={`${siteConfig.title} 版权声明与使用协议`}>
  <section class="cc section">
    <div class="page-container">

      <div class="cc__hero">
        <h1 class="cc__title">版权声明</h1>
        <p class="cc__subtitle">Copyright &amp; Licensing</p>
      </div>

      <!-- 框架协议 -->
      <div class="cc__card">
        <h2 class="cc__card-title"><Icon name="ph:wrench" /> 博客主题框架</h2>
        <p class="cc__desc">
          本站使用的博客主题框架 <strong>Dusklight</strong> 基于 <strong>MIT License</strong> 开源。
        </p>
        <p class="cc__text">
          MIT 协议赋予您极大的自由：您可以将框架代码用于任何目的，包括商业项目；可以修改、分发、私用；只需在副本中保留原始版权声明和许可证文本即可。
        </p>
        <p class="cc__text">
          <strong>这意味着：</strong>您完全可以基于 Dusklight 搭建自己的博客，修改代码，甚至用于商业用途，无需额外授权。
        </p>
        <div class="cc__links">
          <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer" class="cc__link">
            <Icon name="ph:book-open" /> MIT License 全文
          </a>
          <a href={siteConfig.repoUrl} target="_blank" rel="noopener noreferrer" class="cc__link">
            <Icon name="ph:link" /> Dusklight 源码仓库
          </a>
        </div>
      </div>

      <!-- 内容协议 -->
      <div class="cc__card">
        <h2 class="cc__card-title"><Icon name="ph:article" /> 站点内容与文章</h2>
        <div class="cc__badge">
          <img src="/images/cc-by-nc-nd.png" alt="CC BY-NC-ND 4.0" loading="lazy" />
        </div>
        <p class="cc__desc">
          本站发布的所有<strong>文章正文、插图、封面图、原创图片素材</strong>等原创内容，采用
          <strong>知识共享 署名-非商业性使用-禁止演绎 4.0 国际许可协议</strong>（CC BY-NC-ND 4.0）进行授权。
        </p>

        <div class="cc__section">
          <h3 class="cc__section-title"><Icon name="ph:check-circle" /> 您可以</h3>
          <ul class="cc__list">
            <li><strong>共享</strong> — 在任何媒介以任何形式复制、发行本作品内容</li>
            <li>惟须遵守以下许可条款</li>
          </ul>
        </div>

        <div class="cc__section">
          <h3 class="cc__section-title"><Icon name="ph:x-circle" /> 您不可以</h3>
          <ul class="cc__list">
            <li><strong>商业使用</strong> — 不得将本作品内容用于商业目的</li>
            <li><strong>演绎创作</strong> — 不得修改、转换或以本作品内容为基础进行二次创作</li>
          </ul>
        </div>

        <div class="cc__section">
          <h3 class="cc__section-title"><Icon name="ph:list-checks" /> 惟须遵守下列条件</h3>
          <ul class="cc__list">
            <li><strong>署名</strong> — 您必须给出适当的署名，提供指向本许可协议的链接，同时标明是否对原始作品作了修改。您可以用任何合理的方式来署名，但不得以任何方式暗示许可人为您或您的使用背书</li>
            <li><strong>非商业性使用</strong> — 您不得将本作品用于商业目的</li>
            <li><strong>禁止演绎</strong> — 如果您修改、转换或以本作品为基础进行创作，您不得分发修改后的作品</li>
            <li><strong>没有附加限制</strong> — 您不得适用法律术语或技术措施来限制其他人做许可协议允许的事情</li>
          </ul>
        </div>

        <div class="cc__section">
          <h3 class="cc__section-title"><Icon name="ph:warning" /> 声明</h3>
          <p class="cc__text">
            当您使用本作品的方式符合许可协议规定，或版权法允许的使用方式时，您不必征得许可。
            本许可协议不能替代著作权法的合理使用或其他版权法允许的使用。
          </p>
          <p class="cc__text">
            本站文章中的引用内容、图片素材等版权归原作者所有，本站仅作整理展示。
            如有侵权，请联系站长处理。
          </p>
        </div>

        <div class="cc__links">
          <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer" class="cc__link">
            <Icon name="ph:book-open" /> CC BY-NC-ND 4.0 协议全文
          </a>
          <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode.zh-hans" target="_blank" rel="noopener noreferrer" class="cc__link">
            <Icon name="ph:scroll" /> 法律文本 (Legal Code)
          </a>
          <a href="https://creativecommons.org" target="_blank" rel="noopener noreferrer" class="cc__link">
            <Icon name="ph:globe" /> Creative Commons 官网
          </a>
        </div>
      </div>

      <!-- 总结 -->
      <div class="cc__card cc__card--summary">
        <h2 class="cc__card-title"><Icon name="ph:push-pin" /> 简要总结</h2>
        <div class="cc__summary-grid">
          <div class="cc__summary-item">
            <span class="cc__summary-label">博客框架代码</span>
            <span class="cc__summary-value">MIT License — 自由使用</span>
          </div>
          <div class="cc__summary-item">
            <span class="cc__summary-label">文章正文与图片</span>
            <span class="cc__summary-value">CC BY-NC-ND 4.0 — 需署名，禁止商用和演绎</span>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .cc__hero {
    text-align: center;
    padding: var(--space-16) 0 var(--space-10);
  }

  .cc__title {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 var(--space-2);
  }

  .cc__subtitle {
    font-size: var(--text-base);
    color: var(--foreground-muted);
    margin: 0;
  }

  .cc__card {
    max-width: 720px;
    margin: 0 auto var(--space-6);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  .cc__card:last-of-type {
    margin-bottom: var(--space-16);
  }

  .cc__card-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--foreground);
    margin: 0 0 var(--space-4);
  }

  .cc__card-title :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .cc__badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .cc__badge img {
    height: 31px;
    width: auto;
  }

  .cc__desc {
    font-size: var(--text-base);
    color: var(--foreground-secondary);
    line-height: 1.8;
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cc__section {
    margin-bottom: var(--space-6);
  }

  .cc__section-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--foreground);
    margin: 0 0 var(--space-3);
  }

  .cc__section-title :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .cc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cc__list li {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    line-height: 1.7;
    padding-left: var(--space-4);
    position: relative;
  }

  .cc__list li::before {
    content: "·";
    position: absolute;
    left: var(--space-1);
    color: var(--accent);
    font-weight: 700;
  }

  .cc__text {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-2);
  }

  .cc__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .cc__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    background: var(--surface-1);
    transition: all var(--duration-fast) var(--ease-material);
    width: fit-content;
  }

  .cc__link:hover {
    background: var(--surface-2);
    border-color: var(--accent);
  }

  .cc__link :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* 总结卡片 */
  .cc__card--summary {
    border-left: 3px solid var(--accent);
  }

  .cc__summary-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cc__summary-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cc__summary-item:last-child {
    border-bottom: none;
  }

  .cc__summary-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground);
  }

  .cc__summary-value {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
  }

  @media (max-width: 640px) {
    .cc__hero {
      padding: var(--space-10) 0 var(--space-6);
    }

    .cc__card {
      padding: var(--space-5);
    }

    .cc__summary-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
