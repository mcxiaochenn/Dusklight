---
/**
 * 首页 — 分页文章流
 * / (第1页), /page/2/, /page/3/ ...
 */
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import Pagination from "../components/ui/Pagination.astro";
import { siteConfig } from "../config/site";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  // 预渲染获取 remark-content 插件注入的自动摘录
  const excerpts: Record<string, string> = {};
  await Promise.all(
    allPosts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      excerpts[post.id] = remarkPluginFrontmatter?.excerpt || "";
    })
  );

  return paginate(allPosts, {
    pageSize: siteConfig.postsPerPage,
    props: { excerpts },
  });
};

const { page, excerpts } = Astro.props;
const baseUrl = "/";
---

<BaseLayout>
  {/* Hero */}
  <section class="hero section">
    <div class="page-container">
      <h1 class="hero__title">{siteConfig.title}</h1>
      <p class="hero__subtitle">{siteConfig.description}</p>
    </div>
  </section>

  {/* 文章流 */}
  <section class="posts">
    <div class="content-container">
      <div class="posts__list">
        {page.data.map((post) => (
          <div class="posts__item">
            <PostCard post={post} excerpt={excerpts[post.id]} />
          </div>
        ))}
      </div>

      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl={baseUrl}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-12);
  }

  .hero__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 var(--space-3);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--foreground-secondary);
    margin: 0;
  }

  .posts__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .posts__item {
    /* reveal 动画由 IntersectionObserver 驱动 */
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-12);
      padding-bottom: var(--space-8);
    }
  }
</style>
