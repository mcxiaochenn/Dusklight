---
/**
 * 首页 — 分页文章流
 * / (第1页), /page/2/, /page/3/ ...
 * Hero 左文右卡（xiowo 风）：左标题+渐变分类按钮+随便逛逛，右精选推荐大图卡
 */
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import TaxonomyBar from "../components/blog/TaxonomyBar.astro";
import type { TaxonomyItem } from "../components/blog/TaxonomyBar.astro";
import Pagination from "../components/ui/Pagination.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import type { SidebarStats } from "../components/sidebar/Sidebar.astro";
import { siteConfig } from "../config/site";
import { getPostUrl } from "../utils/abbrlink";
import HomeHero from "../components/home/HomeHero.svelte";

type BlogPost = CollectionEntry<"blog">;

interface HomeProps {
  page: Page<BlogPost>;
  excerpts: Record<string, string>;
  stats: SidebarStats;
  categories: TaxonomyItem[];
  heroPosts: Array<{
    title: string;
    url: string;
    cover: string;
    fullBleed: boolean;
  }>;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // 置顶优先，其余按时间倒序
  const allPosts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort(
      (a, b) =>
        (b.data.pinned ? 1 : 0) - (a.data.pinned ? 1 : 0) ||
        b.data.date.valueOf() - a.data.date.valueOf()
    );

  // 分类计数（category-bar 用）
  const catMap = new Map<string, number>();
  allPosts.forEach((p) => {
    const cat = p.data.category?.trim();
    if (cat) catMap.set(cat, (catMap.get(cat) || 0) + 1);
  });
  const categories = [...catMap.entries()]
    .sort((a, b) => b[1] - a[1])
    .map(([name, count]) => ({ name, count }));

  // Hero 推荐与文章流置顶是两套独立语义。没有显式推荐时，回退到
  // 最近 5 篇有封面的文章；文章无论是否出现在 Hero 都保留在文章流。
  const byDateDesc = (a: BlogPost, b: BlogPost) =>
    b.data.date.valueOf() - a.data.date.valueOf();
  const explicitFeatured = allPosts
    .filter((post) => post.data.featured)
    .sort(byDateDesc);
  const heroSource = (explicitFeatured.length
    ? explicitFeatured
    : allPosts.filter((post) => post.data.cover).sort(byDateDesc)
  ).slice(0, 5);
  const heroPosts = heroSource.map((post) => ({
    title: post.data.title,
    url: getPostUrl(post),
    cover: post.data.bannerCover || post.data.cover || "/images/cover-fallback.svg",
    fullBleed: !!post.data.bannerCover,
  }));

  // 预渲染获取 remark-content 插件注入的自动摘录 + 全站字数
  const excerpts: Record<string, string> = {};
  let totalWords = 0;
  await Promise.all(
    allPosts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      excerpts[post.id] = remarkPluginFrontmatter?.excerpt || "";
      totalWords += remarkPluginFrontmatter?.words || 0;
    })
  );

  // 侧栏统计（全量口径）。日期串按 UTC 读取 —— YAML 无引号日期按 UTC
  // 解析，UTC 读回即 frontmatter 面值（与 FormattedDate 同一语义）
  const pad = (n: number) => String(n).padStart(2, "0");
  const utcDay = (d: Date) =>
    `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
  const latest = allPosts.reduce((m, p) => (p.data.date > m ? p.data.date : m), new Date(0));
  const stats: SidebarStats = {
    postCount: allPosts.length,
    categoryCount: new Set(allPosts.map((p) => p.data.category).filter(Boolean)).size,
    tagCount: new Set(allPosts.flatMap((p) => p.data.tags)).size,
    totalWords,
    latestDay: utcDay(latest),
  };

  return paginate(allPosts, {
    pageSize: siteConfig.postsPerPage,
    props: {
      excerpts,
      stats,
      categories,
      heroPosts,
    },
  });
};

const { page, excerpts, stats, categories, heroPosts } = Astro.props as unknown as HomeProps;
const baseUrl = "/";
const isFirstPage = page.currentPage === 1;
---

<BaseLayout>
  {/* 文章流 + 右侧栏 */}
  <section class="posts">
    <div class="home-grid">
      <div class="home-grid__main">
        {isFirstPage && heroPosts.length > 0 && (
          <div class="hero-section">
            <HomeHero posts={heroPosts} client:idle />
          </div>
        )}

        {/* 分类快速跳转：与右侧 ProfileCard 顶部对齐 */}
        <div class="category-section">
          <TaxonomyBar kind="categories" items={categories} />
        </div>

        <div class="posts__list">
          {page.data.map((post) => (
            <div class="posts__item">
              <PostCard post={post} excerpt={excerpts[post.id]} />
            </div>
          ))}
        </div>

        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          prevUrl={page.url.prev}
          nextUrl={page.url.next}
          baseUrl={baseUrl}
        />
      </div>

      <Sidebar stats={stats} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: var(--space-5);
  }

  /* 分类栏区 */
  .category-section {
    margin-bottom: var(--space-5);
  }

  /* 双栏：文章流居左，侧栏固定宽度居右 */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-8);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
    align-items: start;
  }

  /* flex-wrap 双列布局，配合 PostCard 的响应式断点 */
  .posts__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  /* 默认单列；≥1300px 时双列，与 PostCard 垂直布局断点对齐 */
  .posts__item {
    flex: 0 0 100%;
  }

  @media (min-width: 1300px) {
    .posts__item {
      flex: 0 0 calc(50% - var(--space-5) / 2);
    }
  }

  @media (max-width: 960px) {
    /* 窄屏：侧栏堆到文章流下方 */
    .home-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
