---
/**
 * 博客列表页面
 * 使用新组件：Header, Footer, PostCard, SEOHead
 */
import { getCollection } from "astro:content";
import Header from "../../components/common/Header.astro";
import Footer from "../../components/common/Footer.astro";
import PostCard from "../../components/blog/PostCard.astro";
import SEOHead from "../../components/seo/SEOHead.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead title="博客 - Dusklight Blog" description="所有文章列表" />
  </head>

  <body>
    <Header />

    <main class="blog-list">
      <h1 class="blog-list__title">博客文章</h1>
      <p class="blog-list__count">共 {posts.length} 篇文章</p>

      <div class="blog-list__grid">
        {posts.map((post, index) => (
          <PostCard post={post} variant={index === 0 ? "featured" : "default"} />
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-list {
    max-width: calc(var(--content-width) + var(--space-8));
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .blog-list__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 var(--space-2) 0;
  }

  .blog-list__count {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6) 0;
  }

  .blog-list__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  /* 第一篇文章占满宽度 */
  .blog-list__grid > :first-child {
    grid-column: 1 / -1;
  }

  @media (max-width: 768px) {
    .blog-list__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
