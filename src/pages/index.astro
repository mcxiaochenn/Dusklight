---
/**
 * 首页
 * 单列文章流 + 交错入场动画 + 分页
 */
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import Button from "../components/ui/Button.astro";
import { siteConfig } from "../config/site";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 预渲染获取 remark-content 插件注入的自动摘录
const postsWithExcerpt = await Promise.all(
  allPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      post,
      excerpt: remarkPluginFrontmatter?.excerpt || "",
    };
  })
);

const perPage = siteConfig.postsPerPage;
const posts = postsWithExcerpt.slice(0, perPage);
const showPagination = allPosts.length > perPage;
---

<BaseLayout>
  {/* Hero */}
  <section class="hero section">
    <div class="page-container">
      <h1 class="hero__title">{siteConfig.title}</h1>
      <p class="hero__subtitle">{siteConfig.description}</p>
    </div>
  </section>

  {/* 文章流 — 单列，每张卡片独立液态玻璃 */}
  <section class="posts">
    <div class="content-container">
      <div class="posts__list">
        {posts.map(({ post, excerpt }, i) => (
          <div class="posts__item" style={`--i: ${i}`}>
            <PostCard post={post} excerpt={excerpt} />
          </div>
        ))}
      </div>

      {showPagination && (
        <div class="posts__more">
          <Button href="/archive/" variant="secondary">查看全部文章 →</Button>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding-top: var(--space-20);
    padding-bottom: var(--space-12);
  }

  .hero__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0 0 var(--space-3);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--foreground-secondary);
    margin: 0;
  }

  /* ── 单列文章流 ── */
  .posts__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* ── 交错入场动画（使用全局动画系统） ── */
  .posts__item {
    opacity: 0;
    animation: fade-in-up var(--duration-slow) var(--ease-decelerate) forwards;
    animation-delay: calc(var(--i) * 60ms);
  }

  /* ── 翻页区域 ── */
  .posts__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
    padding-bottom: var(--space-16);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-12);
      padding-bottom: var(--space-8);
    }
  }
</style>
