---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getPostSlug } from "@/utils/abbrlink";

export async function getStaticPaths() {
  // 排除草稿：这里决定「是否生成 HTML 页面」。首页/归档/RSS 都已过滤，
  // 唯独这里不过滤的话，草稿正文仍会产出 dist/posts/<slug>/index.html
  // 并被 sitemap 收录（sitemap() 无 filter，默认收录全部构建产物页面）
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    // 有 abbrlink 用 abbrlink，没有回退文件路径 —— 与线上老博客规则一致
    params: { slug: getPostSlug(post) },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);

// remark-content 插件注入的字数和阅读时间
const remarkFrontmatter = (post as any).rendered?.metadata?.frontmatter || {};
const readingTime = remarkFrontmatter.minutes || Math.max(1, Math.ceil((post.body?.length || 0) / 400));
const wordCount = remarkFrontmatter.words || post.body?.length || 0;
---

<BlogPost {...post.data} headings={headings} readingTime={readingTime} wordCount={wordCount} slug={post.id}>
  <Content />
</BlogPost>
