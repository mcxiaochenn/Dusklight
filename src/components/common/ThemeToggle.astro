---
/**
 * 主题切换组件
 * ─────────────────────────────────────────────────
 * 支持 light / dark / auto 三档切换。
 * 无闪烁主题恢复（内联脚本）。
 * View Transitions 兼容。
 */
---

<script is:inline>
  (function() {
    const theme = localStorage.getItem("theme") || "auto";
    const root = document.documentElement;
    root.classList.remove("light", "dark", "auto");
    root.classList.add(theme);
    if (theme === "auto") {
      const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      root.classList.toggle("dark", isDark);
      root.style.colorScheme = isDark ? "dark" : "light";
    } else {
      root.style.colorScheme = theme;
    }
  })();
</script>

<button
  id="theme-toggle"
  type="button"
  aria-label="切换主题"
  class="theme-toggle"
  title="切换主题"
>
  <svg aria-hidden="true" class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <svg aria-hidden="true" class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>

  <svg aria-hidden="true" class="theme-toggle__icon theme-toggle__icon--auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    color: var(--foreground-secondary);
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .theme-toggle:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .theme-toggle__icon {
    position: absolute;
    transition:
      opacity var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-decelerate);
  }

  .theme-toggle__icon--sun   { opacity: 1; transform: rotate(0); }
  .theme-toggle__icon--moon  { opacity: 0; transform: rotate(-90deg); }
  .theme-toggle__icon--auto  { opacity: 0; transform: rotate(90deg); }

  :root.dark .theme-toggle__icon--sun   { opacity: 0; transform: rotate(90deg); }
  :root.dark .theme-toggle__icon--moon  { opacity: 1; transform: rotate(0); }
  :root.dark .theme-toggle__icon--auto  { opacity: 0; transform: rotate(-90deg); }

  :root.auto .theme-toggle__icon--sun   { opacity: 0; transform: rotate(-90deg); }
  :root.auto .theme-toggle__icon--moon  { opacity: 0; transform: rotate(90deg); }
  :root.auto .theme-toggle__icon--auto  { opacity: 1; transform: rotate(0); }
</style>

<style is:global>
  /*
   * 主题切换 —— 圆形揭示
   * ─────────────────────────────────────────────────
   * 新主题从按钮位置擦出来，全程可见真实页面内容，没有纯色遮罩阶段。
   *
   * 必须 is:global：::view-transition-* 是挂在文档根上的伪元素树，
   * Astro 的 scoped 样式会给选择器追加 data-astro-cid-* 属性，
   * 那样永远匹配不上。
   *
   * 必须用 [data-theme-switching] 收窄：站点在 BaseLayout 里开了
   * <ClientRouter />，每次页面导航同样会生成 ::view-transition-*。
   * 不收窄的话翻页也会套用这套圆形动画，而且用的是上一次残留的坐标。
   */

  /* 关掉默认的 plus-lighter 混合，否则新旧两层颜色会相加 */
  :root[data-theme-switching]::view-transition-image-pair(root) {
    isolation: auto;
  }

  :root[data-theme-switching]::view-transition-old(root),
  :root[data-theme-switching]::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* 旧主题整幅留在底层不动，新主题在上层用 clip-path 揭示 */
  :root[data-theme-switching]::view-transition-old(root) {
    z-index: 0;
  }

  :root[data-theme-switching]::view-transition-new(root) {
    z-index: 1;
    animation: theme-reveal var(--duration-slow) var(--ease-material) forwards;
  }

  @keyframes theme-reveal {
    from {
      clip-path: circle(0 at var(--theme-switch-x) var(--theme-switch-y));
    }
    to {
      clip-path: circle(var(--theme-switch-r) at var(--theme-switch-x) var(--theme-switch-y));
    }
  }
</style>

<script>
  // 切换动画进行中的标记 —— 防止连点导致遮罩与主题错位
  let animating = false;

  const ThemeManager = {
    getStored(): string {
      if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
        return localStorage.getItem("theme")!;
      }
      return "auto";
    },

    getSystemTheme(): "light" | "dark" {
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    },

    /** 返回实际生效的主题（auto 解析为 light/dark） */
    getEffective(): "light" | "dark" {
      const stored = this.getStored();
      if (stored === "light" || stored === "dark") return stored;
      return this.getSystemTheme();
    },

    applyTheme(theme: string) {
      const root = document.documentElement;
      root.classList.remove("light", "dark", "auto");

      if (theme === "auto") {
        root.classList.add("auto");
        const systemTheme = this.getSystemTheme();
        root.classList.toggle("dark", systemTheme === "dark");
        root.style.colorScheme = systemTheme;
      } else {
        root.classList.add(theme);
        root.classList.toggle("dark", theme === "dark");
        root.style.colorScheme = theme;
      }

      localStorage.setItem("theme", theme);
    },

    init() {
      this.applyTheme(this.getStored());
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (this.getStored() === "auto") {
          this.applyTheme("auto");
        }
      });
    },

    toggleWithAnimation(originX: number, originY: number) {
      if (animating) return;

      const stored = this.getStored();
      const next = stored === "light" ? "dark" : stored === "dark" ? "auto" : "light";

      const root = document.documentElement;
      const startViewTransition = (
        document as Document & {
          startViewTransition?: (cb: () => void) => { finished: Promise<void> };
        }
      ).startViewTransition?.bind(document);

      /*
       * 两种情况直接切换，不做动画：
       *   1. 浏览器不支持 View Transitions（Firefox 等）
       *   2. 用户开了「减少动效」
       * 第 2 点必须在 JS 里短路：CSS 的 reduced-motion 规则只压 transition
       * 时长，管不到 ::view-transition-new(root) 上的 animation。
       */
      if (!startViewTransition || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.applyTheme(next);
        return;
      }

      animating = true;

      // 覆盖到最远屏幕角所需的半径
      const radius = Math.hypot(
        Math.max(originX, window.innerWidth - originX),
        Math.max(originY, window.innerHeight - originY)
      );
      root.style.setProperty("--theme-switch-x", `${originX}px`);
      root.style.setProperty("--theme-switch-y", `${originY}px`);
      root.style.setProperty("--theme-switch-r", `${radius}px`);
      // 这个属性把下面的圆形揭示动画限定在主题切换，不波及 ClientRouter 的页面切换
      root.dataset.themeSwitching = "";

      const cleanup = () => {
        delete root.dataset.themeSwitching;
        root.style.removeProperty("--theme-switch-x");
        root.style.removeProperty("--theme-switch-y");
        root.style.removeProperty("--theme-switch-r");
        animating = false;
      };

      // 主题在回调里同步切换，浏览器负责把切换前后的两帧做成快照
      startViewTransition(() => {
        this.applyTheme(next);
      }).finished.then(cleanup, cleanup);
    },
  };

  ThemeManager.init();

  let bound = false;
  function bindToggle() {
    if (bound) return;
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;
    bound = true;
    toggle.addEventListener("click", (e) => {
      const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
      ThemeManager.toggleWithAnimation(rect.left + rect.width / 2, rect.top + rect.height / 2);
    });
  }

  bindToggle();

  document.addEventListener("astro:after-swap", () => {
    ThemeManager.applyTheme(ThemeManager.getStored());
    bound = false;
    bindToggle();
  });
</script>
