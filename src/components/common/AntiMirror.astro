---
/**
 * 防镜像站组件
 * ─────────────────────────────────────────────────
 * 源码始终可读。构建后 postbuild 脚本 scripts/obfuscate-anti-mirror.js
 * 扫描 dist/*.html，将 <!-- __ANTI_MIRROR__ --> 标记替换为高度混淆的
 * 版本（随机变量名 + XOR 编码 + 死代码）。
 * 关闭 siteConfig.antiMirror.enabled 时不输出标记，脚本自然无处可替换。
 */
import { siteConfig } from "../../config/site";
const enabled = siteConfig.antiMirror.enabled;
---

{enabled && <Fragment set:html="<!-- __ANTI_MIRROR__ -->" />}
