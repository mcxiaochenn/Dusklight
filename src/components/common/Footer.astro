---
/**
 * 全局页脚 — 参考 blog.zhheo.com 风格
 * 分栏布局 + 渐变装饰 + 站点信息
 */
import { siteConfig } from "../../config/site";
import { navConfig } from "../../config/nav";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();

const socialIcons: Record<string, string> = {
  github: "simple-icons:github",
  rss: "ph:rss",
  twitter: "simple-icons:x",
  bilibili: "simple-icons:bilibili",
  email: "ph:envelope",
};
---

<footer class="footer">
  <div class="footer__wave" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path d="M0,30 C200,60 400,0 600,30 C800,60 1000,0 1200,30 L1200,60 L0,60 Z" fill="var(--glass-bg)" />
    </svg>
  </div>

  <div class="footer__body">
    <div class="footer__inner">
      <!-- 左：站点信息 -->
      <div class="footer__brand">
        <div class="footer__logo">
          <img src="/favicon/favicon.ico" alt="" aria-hidden="true" class="footer__logo-img" />
          <span class="footer__logo-text">{siteConfig.title}</span>
        </div>
        <p class="footer__slogan">{siteConfig.description}</p>
      </div>

      <!-- 中：导航 -->
      <nav class="footer__nav" aria-label="页脚导航">
        <h3 class="footer__nav-title">导航</h3>
        <div class="footer__nav-links">
          {navConfig.main.filter((item) => !item.children).map((item) => (
            <a href={item.href} class="footer__nav-link">{item.label}</a>
          ))}
        </div>
      </nav>

      <!-- 右：社交 -->
      <div class="footer__social">
        <h3 class="footer__nav-title">社交</h3>
        <div class="footer__social-links">
          {navConfig.social.map((item) => (
            <a
              href={item.href}
              class="footer__social-link"
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
              title={item.label}
            >
              <Icon name={socialIcons[item.icon] || "ph:link"} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {year} {siteConfig.author}. Powered by
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="footer__powered">Astro</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--space-16);
  }

  /* 波浪装饰 */
  .footer__wave {
    position: relative;
    height: 40px;
    overflow: hidden;
    background: transparent;
  }

  .footer__wave svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* 主体 */
  .footer__body {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-10) var(--space-4) var(--space-6);
  }

  .footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-10);
  }

  /* 品牌区 */
  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .footer__logo-img {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
  }

  .footer__logo-text {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
    letter-spacing: -0.02em;
  }

  .footer__slogan {
    font-size: var(--text-sm);
    color: var(--foreground-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  /* 导航 */
  .footer__nav-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-3);
  }

  .footer__nav-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__nav-link {
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-material);
    width: fit-content;
  }

  .footer__nav-link:hover {
    color: var(--accent);
  }

  /* 社交链接 */
  .footer__social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-material);
    width: fit-content;
  }

  .footer__social-link:hover {
    color: var(--accent);
  }

  .footer__social-link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* 底部版权 */
  .footer__bottom {
    max-width: var(--page-width);
    margin: var(--space-8) auto 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
    margin: 0;
  }

  .footer__powered {
    color: var(--accent);
    text-decoration: none;
  }

  .footer__powered:hover {
    text-decoration: underline;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      text-align: center;
    }

    .footer__slogan {
      max-width: none;
    }

    .footer__nav-links,
    .footer__social-links {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
