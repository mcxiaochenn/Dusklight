---
/**
 * 站点背景装饰
 * ─────────────────────────────────────────────────
 * 缓加载背景图 + 静态遮罩。
 * 背景图在页面加载完成后才开始下载，不阻断首屏渲染。
 */
import { siteConfig } from "../../config/site";
---

<div class="site-backdrop" aria-hidden="true" transition:persist data-bg-light={siteConfig.backgroundImages.light} data-bg-dark={siteConfig.backgroundImages.dark}>
  <div class="site-backdrop__image" id="backdrop-image"></div>
  <div class="site-backdrop__overlay"></div>
</div>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background: var(--surface-0);
  }

  .site-backdrop__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, oklch(from var(--surface-0) l c h / 0.48), oklch(from var(--surface-0) l c h / 0.78));
  }

  /* ── 背景图 — 默认隐藏，JS 加载后淡入 ── */
  .site-backdrop__image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-material);
  }

  .site-backdrop__image--loaded {
    opacity: 1;
  }
</style>

<script>
  let backdropRequest = 0;

  function isDarkMode(): boolean {
    const root = document.documentElement;
    if (root.classList.contains("dark")) return true;
    if (root.classList.contains("light")) return false;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function getBackdropSource() {
    const backdrop = document.querySelector(".site-backdrop");
    const light = backdrop?.getAttribute("data-bg-light") || "/images/bg/xiowo-bg-light.webp";
    const dark = backdrop?.getAttribute("data-bg-dark") || "/images/bg/xiowo-bg-dark.webp";
    return isDarkMode() ? dark : light;
  }

  function loadBackdropImage() {
    const el = document.getElementById("backdrop-image");
    if (!el) return;

    const src = getBackdropSource();
    const request = ++backdropRequest;

    const img = new Image();
    img.onload = () => {
      // Image requests complete out of order when the theme is toggled quickly.
      // Only the latest request for the currently selected theme may update DOM.
      if (request !== backdropRequest || !el.isConnected || src !== getBackdropSource()) return;
      el.style.backgroundImage = `url(${img.src})`;
      el.classList.add("site-backdrop__image--loaded");
    };
    img.src = src;
  }

  // 主题切换时更换背景图
  function switchBackdropImage() {
    loadBackdropImage();
  }

  // 首次加载 + View Transitions 页面切换后重新初始化
  function initBackdrop() {
    const el = document.getElementById("backdrop-image");
    if (!el) return;
    if (el.classList.contains("site-backdrop__image--loaded") && el.style.backgroundImage) return;
    loadBackdropImage();
  }

  if (document.readyState === "complete") {
    initBackdrop();
  } else {
    window.addEventListener("load", initBackdrop);
  }
  document.addEventListener("astro:page-load", initBackdrop);

  // 用 MutationObserver 监听 <html> class 变化（持久存在，不随页面切换销毁）
  let lastDark = isDarkMode();
  new MutationObserver(() => {
    const nowDark = isDarkMode();
    if (nowDark !== lastDark) {
      lastDark = nowDark;
      switchBackdropImage();
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  // 监听系统主题变化（auto 模式下跟随系统）
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (!document.documentElement.classList.contains("light") &&
        !document.documentElement.classList.contains("dark")) {
      switchBackdropImage();
    }
  });
</script>
