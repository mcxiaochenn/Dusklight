---
/**
 * 站点背景装饰
 * ─────────────────────────────────────────────────
 * 网格纹理 + 噪点 + 缓加载背景图。
 * 背景图在页面加载完成后才开始下载，不阻断首屏渲染。
 */
---

<div class="site-backdrop" aria-hidden="true">
  <div class="site-backdrop__image" id="backdrop-image"></div>
  <div class="site-backdrop__grid"></div>
  <div class="site-backdrop__grain"></div>
</div>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .site-backdrop__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.4;
    mix-blend-mode: overlay;
  }

  :root.dark .site-backdrop__grid {
    opacity: 0.15;
  }

  .site-backdrop__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    opacity: 0.5;
    mix-blend-mode: overlay;
  }

  /* ── 背景图 — 默认隐藏，JS 加载后淡入 ── */
  .site-backdrop__image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .site-backdrop__image--loaded {
    opacity: 1;
    filter: blur(8px) brightness(0.75);
  }

  :root.dark .site-backdrop__image--loaded {
    filter: blur(8px);
  }

  /* 背景图加载后隐藏网格和噪点 */
  .site-backdrop--has-image .site-backdrop__grid,
  .site-backdrop--has-image .site-backdrop__grain {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
</style>

<script>
  let backdropRequest = 0;

  function isDarkMode(): boolean {
    const root = document.documentElement;
    if (root.classList.contains("dark")) return true;
    if (root.classList.contains("light")) return false;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function getBackdropSource() {
    return isDarkMode()
      ? "/images/bg/xiowo-bg-dark.webp"
      : "/images/bg/xiowo-bg-light.webp";
  }

  function loadBackdropImage() {
    const el = document.getElementById("backdrop-image");
    if (!el) return;

    const src = getBackdropSource();
    const request = ++backdropRequest;

    const img = new Image();
    img.onload = () => {
      // Image requests complete out of order when the theme is toggled quickly.
      // Only the latest request for the currently selected theme may update DOM.
      if (request !== backdropRequest || !el.isConnected || src !== getBackdropSource()) return;
      el.style.backgroundImage = `url(${img.src})`;
      el.classList.add("site-backdrop__image--loaded");
      el.parentElement?.classList.add("site-backdrop--has-image");
    };
    img.src = src;
  }

  // 主题切换时更换背景图
  function switchBackdropImage() {
    loadBackdropImage();
  }

  // 首次加载 + View Transitions 页面切换后重新初始化
  function initBackdrop() {
    const el = document.getElementById("backdrop-image");
    if (!el) return;
    if (el.classList.contains("site-backdrop__image--loaded") && el.style.backgroundImage) return;
    loadBackdropImage();
  }

  if (document.readyState === "complete") {
    initBackdrop();
  } else {
    window.addEventListener("load", initBackdrop);
  }
  document.addEventListener("astro:page-load", initBackdrop);

  // 用 MutationObserver 监听 <html> class 变化（持久存在，不随页面切换销毁）
  let lastDark = isDarkMode();
  new MutationObserver(() => {
    const nowDark = isDarkMode();
    if (nowDark !== lastDark) {
      lastDark = nowDark;
      switchBackdropImage();
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  // 监听系统主题变化（auto 模式下跟随系统）
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (!document.documentElement.classList.contains("light") &&
        !document.documentElement.classList.contains("dark")) {
      switchBackdropImage();
    }
  });
</script>
