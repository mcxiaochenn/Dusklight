---
/**
 * 回到顶部按钮 — 全局可用
 * 玻璃效果内联，避免 .glass 类冲突。
 * 逻辑在 GlobalScripts.astro 中统一管理。
 */
import { Icon } from "astro-icon/components";
---

<button
  id="back-to-top"
  class="back-to-top"
  aria-label="回到顶部"
  title="回到顶部"
>
  <Icon name="ph:arrow-up" />
</button>

<style>
  .back-to-top {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-10) + 20px);
    z-index: 80;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border);

    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    box-shadow: var(--shadow-md), var(--glass-highlight);

    color: var(--foreground-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity var(--duration-normal) var(--ease-material),
      visibility var(--duration-normal) var(--ease-material),
      transform var(--duration-normal) var(--ease-decelerate),
      color var(--duration-fast) var(--ease-material);
  }

  :global(.back-to-top--visible) {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }

  .back-to-top:hover {
    color: var(--foreground);
    background: var(--glass-bg);
  }

  .back-to-top svg {
    width: 18px;
    height: 18px;
  }
</style>
