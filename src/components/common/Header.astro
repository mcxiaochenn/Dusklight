---
/**
 * 全局导航栏 — 浮动药丸设计 + 二级下拉菜单
 */
import { siteConfig } from "../../config/site";
import { navConfig } from "../../config/nav";
import type { NavItem } from "../../config/nav";
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath === href.slice(0, -1);
}

function isParentActive(item: NavItem): boolean {
  if (isActive(item.href)) return true;
  return item.children?.some((c) => isActive(c.href)) ?? false;
}

const navIcons: Record<string, string> = {
  "首页": "ph:house",
  "博客": "ph:notebook",
  "归档": "ph:archive",
  "关于": "ph:user",
};
---

<header id="main-header" class="main-header">
  <div class="header__inner">
    <div class="header__pill header__pill--left">
      <a href="/" class="header__logo">
        {siteConfig.title}
      </a>
    </div>

    <nav class="header__pill header__pill--right" aria-label="主导航">
      <div class="header__links hide-mobile">
        {navConfig.main.map((item) => (
          item.children ? (
            <div class="header__dropdown">
              <a
                href={item.href}
                class:list={["header__link header__dropdown-trigger", { "header__link--active": isParentActive(item) }]}
              >
                {navIcons[item.label] && (
                  <Icon name={navIcons[item.label]} class="header__link-icon" />
                )}
                {item.label}
                <Icon name="ph:caret-down" class="header__caret" />
              </a>
              <div class="header__dropdown-menu">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={["header__dropdown-item", { "header__dropdown-item--active": isActive(child.href) }]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={["header__link", { "header__link--active": isActive(item.href) }]}
            >
              {navIcons[item.label] && (
                <Icon name={navIcons[item.label]} class="header__link-icon" />
              )}
              {item.label}
            </a>
          )
        ))}
      </div>

      <div class="header__actions">
        <ThemeToggle />
        <button
          id="mobile-menu-toggle"
          class="header__menu-btn hide-desktop"
          aria-label="打开菜单"
          aria-expanded="false"
        >
          <Icon name="ph:list" class="header__menu-icon" />
        </button>
      </div>
    </nav>
  </div>

  {/* 移动端菜单 */}
  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-menu__backdrop"></div>
    <div class="mobile-menu__panel">
      <div class="mobile-menu__header">
        <span class="mobile-menu__title">菜单</span>
        <button id="mobile-menu-close" class="mobile-menu__close" aria-label="关闭菜单">
          <Icon name="ph:x" />
        </button>
      </div>
      {navConfig.main.map((item) => (
        item.children ? (
          <div class="mobile-menu__group">
            <span class="mobile-menu__group-label">
              {navIcons[item.label] && (
                <Icon name={navIcons[item.label]} class="mobile-menu__link-icon" />
              )}
              {item.label}
            </span>
            {item.children.map((child) => (
              <a
                href={child.href}
                class:list={["mobile-menu__link mobile-menu__link--sub", { "mobile-menu__link--active": isActive(child.href) }]}
              >
                {child.label}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={item.href}
            class:list={["mobile-menu__link", { "mobile-menu__link--active": isActive(item.href) }]}
          >
            {navIcons[item.label] && (
              <Icon name={navIcons[item.label]} class="mobile-menu__link-icon" />
            )}
            {item.label}
          </a>
        )
      ))}
    </div>
  </div>
</header>

<style>
  /* ── Header container ── */
  .main-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    transition: background-color var(--duration-normal) var(--ease-standard);
  }

  .header__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* ── Floating pill — 液态玻璃（统一 token） ── */
  .header__pill {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    background: transparent;
    transition: all var(--duration-normal) var(--ease-standard);
  }

  .header__pill::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    box-shadow: var(--glass-highlight);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-standard);
    z-index: -1;
  }

  /* 边缘折射光 */
  .header__pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-standard);
    z-index: -1;
    background:
      linear-gradient(135deg, oklch(1 0 0 / 0.12) 0%, transparent 40%),
      linear-gradient(315deg, oklch(1 0 0 / 0.08) 0%, transparent 30%);
    mask-image: radial-gradient(ellipse at center, transparent 60%, black 100%);
    -webkit-mask-image: radial-gradient(ellipse at center, transparent 60%, black 100%);
  }

  :root.dark .header__pill::before {
    background: oklch(0.2 0.01 var(--hue) / 0.15);
  }

  :global(.header-scrolled) .header__pill {
    border-color: var(--glass-border);
    box-shadow: var(--shadow-lg), var(--glass-highlight);
    transform: translateY(6px);
  }

  :global(.header-scrolled) .header__pill::before,
  :global(.header-scrolled) .header__pill::after {
    opacity: 1;
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    letter-spacing: -0.02em;
    padding: 0 var(--space-2);
  }

  /* ── Nav links ── */
  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .header__link:hover {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: oklch(from var(--accent) l c h / 0.24);
  }

  .header__link--active {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: oklch(from var(--accent) l c h / 0.24);
  }

  .header__link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .header__caret {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  /* ── Dropdown ── */
  .header__dropdown {
    position: relative;
  }

  .header__dropdown-trigger {
    cursor: pointer;
  }

  /* 桥接 pseudo-element：填补 trigger 和 menu 之间的间隙，避免 hover 丢失 */
  .header__dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: var(--space-3);
  }

  .header__dropdown.open .header__caret {
    transform: rotate(180deg);
  }

  .header__dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    min-width: 140px;
    padding: var(--space-1);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility var(--duration-fast) var(--ease-standard);
  }

  .header__dropdown.open .header__dropdown-menu,
  .header__dropdown:hover .header__dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown.open .header__caret,
  .header__dropdown:hover .header__caret {
    transform: rotate(180deg);
  }

  .header__dropdown-item {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .header__dropdown-item:hover {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .header__dropdown-item--active {
    color: var(--accent);
  }

  /* ── Actions ── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-1);
  }

  .header__menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .header__menu-btn:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .header__menu-icon {
    width: 18px;
    height: 18px;
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: oklch(0 0 0 / 0.5);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(82vw, 22rem);
    background: var(--surface-0);
    border-left: 1px solid var(--border-subtle);
    padding: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--duration-normal) var(--ease-physical);
  }

  .mobile-menu[data-open="true"] .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .mobile-menu__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    color: var(--foreground-muted);
    transition: color var(--duration-fast) var(--ease-standard),
                background var(--duration-fast) var(--ease-standard);
  }

  .mobile-menu__close:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .mobile-menu__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-menu__group-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .mobile-menu__link--sub {
    padding-left: calc(var(--space-4) + var(--space-6));
    font-size: var(--text-sm);
  }

  .mobile-menu__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .mobile-menu__link--active {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .mobile-menu__link-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--foreground-muted);
  }

  .mobile-menu__link--active .mobile-menu__link-icon {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .main-header {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById("main-header");
    if (!header) return;

    // ── 滚动检测 ──
    function updateScrollState() {
      header.classList.toggle("header-scrolled", window.scrollY > 20);
    }
    window.addEventListener("scroll", updateScrollState, { passive: true });
    updateScrollState();

    // ── 桌面端下拉菜单（点击切换，点外部关闭） ──
    const dropdowns = header.querySelectorAll<HTMLElement>(".header__dropdown");
    dropdowns.forEach((dd) => {
      const trigger = dd.querySelector<HTMLElement>(".header__dropdown-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", (e) => {
        e.preventDefault(); // 阻止 <a> 跳转
        const isOpen = dd.classList.contains("open");
        // 先关闭所有其他下拉
        dropdowns.forEach((d) => d.classList.remove("open"));
        if (!isOpen) dd.classList.add("open");
      });
    });

    // 点击页面空白处关闭所有下拉
    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Element)) return;
      if (!e.target.closest(".header__dropdown")) {
        dropdowns.forEach((d) => d.classList.remove("open"));
      }
    });

    // ── 移动端菜单 ──
    const toggle = document.getElementById("mobile-menu-toggle");
    const closeBtn = document.getElementById("mobile-menu-close");
    const menu = document.getElementById("mobile-menu");
    if (toggle && menu) {
      function openMenu() {
        menu.setAttribute("data-open", "true");
        toggle.setAttribute("aria-expanded", "true");
      }
      function closeMenu() {
        menu.setAttribute("data-open", "false");
        toggle.setAttribute("aria-expanded", "false");
      }

      toggle.addEventListener("click", () => {
        const isOpen = menu.getAttribute("data-open") === "true";
        isOpen ? closeMenu() : openMenu();
      });

      closeBtn?.addEventListener("click", closeMenu);
      menu.querySelector(".mobile-menu__backdrop")?.addEventListener("click", closeMenu);
      menu.querySelectorAll(".mobile-menu__link").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initHeader);
  document.addEventListener("astro:page-load", initHeader);
</script>
