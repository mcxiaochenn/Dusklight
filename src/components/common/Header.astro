---
/**
 * 全局导航栏 — 浮动药丸设计 + 二级下拉菜单
 */
import { siteConfig } from "../../config/site";
import { navConfig } from "../../config/nav";
import type { NavItem } from "../../config/nav";
import ThemeToggle from "./ThemeToggle.astro";
import SearchDialog from "../search/SearchDialog.svelte";
import { resourceConfig } from "../../config/resources";
import { toExternalRedirect } from "../../utils/external-links";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath === href.slice(0, -1);
}

function isParentActive(item: NavItem): boolean {
  if (isActive(item.href)) return true;
  return item.children?.some((c) => isActive(c.href)) ?? false;
}

const navIcons: Record<string, string> = {
  "首页": "fa7-solid:house",
  "文库": "fa7-solid:book-open",
  "留言板": "fa7-solid:envelope",
  "友链": "fa7-solid:user-group",
  "关于": "fa7-regular:user",
  "外链": "fa7-solid:arrow-up-right-from-square",
};
---

<header id="main-header" class="main-header">
  <div class="header__inner">
    <div class="header__pill header__pill--left">
      <a href="/" class="header__logo">
        {siteConfig.title}
      </a>
    </div>

    <nav class="header__pill header__pill--right" aria-label="主导航">
      <div class="header__links">
        {navConfig.main.map((item) => (
          item.children ? (
            <div class="header__dropdown">
              <a
                href={item.href}
                class:list={["header__link header__dropdown-trigger", { "header__link--active": isParentActive(item) }]}
              >
                {navIcons[item.label] && (
                  <Icon name={navIcons[item.label]} class="header__link-icon" />
                )}
                {item.label}
                <Icon name="fa7-solid:caret-down" class="header__caret" />
              </a>
              <div class="header__dropdown-menu">
                {item.children.map((child) => (
                  <a
                    href={child.external ? toExternalRedirect(child.href) : child.href}
                    class:list={["header__dropdown-item", { "header__dropdown-item--active": isActive(child.href) }]}
                  >
                    {child.icon && (
                      <Icon name={child.icon} class="header__dropdown-icon" />
                    )}
                    {child.label}
                    {child.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="header__external-icon" />}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={["header__link", { "header__link--active": isActive(item.href) }]}
            >
              {navIcons[item.label] && (
                <Icon name={navIcons[item.label]} class="header__link-icon" />
              )}
              {item.label}
            </a>
          )
        ))}
      </div>

      <div class="header__actions">
        {siteConfig.features.search && <SearchDialog client:load pagefindUrl={resourceConfig.scripts.pagefind} />}
        <ThemeToggle />
        <button
          id="mobile-menu-toggle"
          class="header__menu-btn"
          aria-label="打开菜单"
          aria-expanded="false"
        >
          <Icon name="fa7-solid:bars" class="header__menu-icon" />
        </button>
      </div>
    </nav>
  </div>

  {/* 移动端菜单 */}
  {/* 关闭态由 CSS 的 visibility 控制，不能用 HTML hidden 属性 —— 见样式块说明 */}
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu__backdrop"></div>
    <div class="mobile-menu__panel">
      <div class="mobile-menu__header">
        <span class="mobile-menu__title">菜单</span>
        <button id="mobile-menu-close" class="mobile-menu__close" aria-label="关闭菜单">
          <Icon name="fa7-solid:xmark" />
        </button>
      </div>
      {navConfig.main.map((item) => (
        item.children ? (
          <div class="mobile-menu__group">
            <span class="mobile-menu__group-label">
              {navIcons[item.label] && (
                <Icon name={navIcons[item.label]} class="mobile-menu__link-icon" />
              )}
              {item.label}
            </span>
            {item.children.map((child) => (
              <a
                href={child.external ? toExternalRedirect(child.href) : child.href}
                class:list={["mobile-menu__link mobile-menu__link--sub", { "mobile-menu__link--active": isActive(child.href) }]}
              >
                {child.label}
                {child.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="header__external-icon" />}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={item.href}
            class:list={["mobile-menu__link", { "mobile-menu__link--active": isActive(item.href) }]}
          >
            {navIcons[item.label] && (
              <Icon name={navIcons[item.label]} class="mobile-menu__link-icon" />
            )}
            {item.label}
          </a>
        )
      ))}
    </div>
  </div>
</header>

<style>
  /* ── Header container ── */
  .main-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    transition: background-color var(--duration-normal) var(--ease-material);
  }

  .header__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* ── Floating pill — 液态玻璃（统一 token） ── */
  .header__pill {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    background: transparent;
    transition: all var(--duration-normal) var(--ease-material);
  }

  .header__pill::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    /* Edge 会把带 backdrop-filter 的伪元素回退计算为 round，导致它与
       外层 squircle 的裁切边界错位；显式继承可让玻璃模糊完整覆盖。 */
    corner-shape: inherit;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    box-shadow: var(--glass-highlight);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-material);
    z-index: -1;
  }

  /* Apple-style edge refraction — light catching the glass edge */
  .header__pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-material);
    z-index: -1;
    background:
      linear-gradient(135deg, oklch(1 0 0 / 0.12) 0%, transparent 40%),
      linear-gradient(315deg, oklch(1 0 0 / 0.08) 0%, transparent 30%);
    mask-image: radial-gradient(ellipse at center, transparent 60%, black 100%);
    -webkit-mask-image: radial-gradient(ellipse at center, transparent 60%, black 100%);
  }

  :root.dark .header__pill::before {
    background: oklch(0.2 0.01 var(--hue) / 0.15);
  }

  :global(.header-scrolled) .header__pill {
    border-color: var(--glass-border);
    box-shadow: var(--shadow-lg), var(--glass-highlight);
    transform: translateY(6px);
  }

  :global(.header-scrolled) .header__pill::before,
  :global(.header-scrolled) .header__pill::after {
    opacity: 1;
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    letter-spacing: -0.02em;
    padding: 0 var(--space-2);
  }

  /* ── Nav links ── */
  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material),
      border-color var(--duration-fast) var(--ease-material);
  }

  .header__link:hover {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: oklch(from var(--accent) l c h / 0.24);
  }

  .header__link--active {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: oklch(from var(--accent) l c h / 0.24);
  }

  .header__link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .header__caret {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-material);
  }

  /* ── Dropdown ── */
  .header__dropdown {
    position: relative;
  }

  .header__dropdown-trigger {
    cursor: pointer;
  }

  /* 桥接 pseudo-element：填补 trigger 和 menu 之间的间隙，避免 hover 丢失 */
  .header__dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: var(--space-3);
  }

  .header__dropdown.open .header__caret {
    transform: rotate(180deg);
  }

  .header__dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    min-width: 140px;
    padding: var(--space-1);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-decelerate),
      transform var(--duration-fast) var(--ease-decelerate),
      visibility var(--duration-fast) var(--ease-decelerate);
  }

  .header__dropdown.open .header__dropdown-menu,
  .header__dropdown:hover .header__dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown.open .header__caret,
  .header__dropdown:hover .header__caret {
    transform: rotate(180deg);
  }

  .header__dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .header__dropdown-icon {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  .header__external-icon { width: 11px; height: 11px; margin-left: auto; opacity: .65; }

  .header__dropdown-item:hover {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .header__dropdown-item--active {
    color: var(--accent);
  }

  /* ── Actions ── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-1);
  }

  .header__menu-btn {
    /* 桌面隐藏，≤768px 显示。显隐断点写在组件内 —— 之前依赖
       utilities 的 .hide-mobile/.hide-desktop，与本组件 display
       声明特异性相同、打包顺序不定，构建后曾出现移动端导航
       竖排 + 桌面汉堡常驻。 */
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    color: var(--foreground-secondary);
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .header__menu-btn:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .header__menu-icon {
    width: 18px;
    height: 18px;
  }

  /* ── Mobile menu ── */
  /* 关闭态必须用 visibility，不能用 HTML 的 hidden 属性。抽屉的滑入/滑出靠下面
     .mobile-menu[data-open="true"] .mobile-menu__panel 的 transform 过渡实现，
     容器本身需要一直保持 fixed 布局；而 hidden 会命中 UA 样式表的
     [hidden]{display:none}，本组件又从未给 .mobile-menu 声明过 display，没有
     作者样式与之竞争，于是整个抽屉连遮罩一起不进渲染树 —— 移动端实测（390×844）
     点击汉堡按钮后 data-open/aria-expanded 都正常翻到 true，但 display 恒为 none、
     盒子恒为 0×0，导航完全不可用。visibility 既在关闭态移出无障碍树与 Tab 序，
     又不打断 transform 过渡；隐藏延迟到过渡结束，滑出动画才播得完。

     z-index 用 110 而非 100：utilities.css 的 .scroll-progress 同为 100，且
     BaseLayout 里 <ScrollProgress /> 排在 <Header /> 之后，同层级下后来者居上，
     会让进度条压在遮罩顶部露出一条彩色线。110 仍低于 skip-link 与灯箱的 200。 */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 110;
    visibility: hidden;
    transition: visibility 0s linear var(--duration-normal);
  }

  .mobile-menu[data-open="true"] {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: oklch(0 0 0 / 0.5);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(82vw, 22rem);
    /* 液态玻璃抽屉：面板底下是 backdrop 深色遮罩，背景图只在边缘透出，
       用更高不透明度的玻璃保证内容可读（普通 --glass-bg 在深色遮罩上会糊成一片） */
    background: oklch(0.98 0.006 var(--hue) / 0.85);
    -webkit-backdrop-filter: blur(calc(var(--glass-blur) * 1.5)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(calc(var(--glass-blur) * 1.5)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border-left: 1px solid var(--glass-border);
    box-shadow: var(--glass-highlight), var(--shadow-lg);
    padding: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform var(--duration-normal) var(--ease-material);
  }

  :root.dark .mobile-menu__panel {
    background: oklch(0.18 0.012 var(--hue) / 0.85);
  }

  .mobile-menu[data-open="true"] .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .mobile-menu__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    color: var(--foreground-muted);
    transition: color var(--duration-fast) var(--ease-material),
                background var(--duration-fast) var(--ease-material);
  }

  .mobile-menu__close:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .mobile-menu__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-menu__group-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--foreground-secondary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .mobile-menu__link--sub {
    padding-left: calc(var(--space-4) + var(--space-6));
    font-size: var(--text-sm);
  }

  .mobile-menu__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .mobile-menu__link--active {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .mobile-menu__link-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--foreground-muted);
  }

  .mobile-menu__link--active .mobile-menu__link-icon {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .main-header {
      padding: var(--space-2) var(--space-3);
    }

    .header__links {
      display: none;
    }

    .header__menu-btn {
      display: flex;
    }
  }
</style>

<script>
  /*
   * window / document 上的监听器只在模块顶层绑定一次。
   * 它们不随 View Transitions 换页销毁：若放进 initHeader，
   * 每导航一次就会多挂一个，且闭包会捕获已被换走的旧 header 节点，
   * 导致游离 DOM 无法回收。因此这里改为每次触发时重新查询元素。
   */
  function updateScrollState() {
    const header = document.getElementById("main-header");
    if (!header) return;
    header.classList.toggle("header-scrolled", window.scrollY > 20);
  }

  function closeAllDropdowns() {
    document
      .querySelectorAll<HTMLElement>(".header__dropdown")
      .forEach((d) => d.classList.remove("open"));
  }

  window.addEventListener("scroll", updateScrollState, { passive: true });

  // 点击页面空白处关闭所有下拉
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    if (!e.target.closest(".header__dropdown")) closeAllDropdowns();
  });

  function initHeader() {
    const header = document.getElementById("main-header");
    if (!header) return;

    updateScrollState();

    /*
     * DOMContentLoaded 与 astro:page-load 在首次加载时都会触发，
     * 没有守卫的话元素级监听器会被绑定两次 —— 下拉菜单的 toggle
     * 逻辑因此会自我抵消（开→关），表现为首屏点不开下拉。
     * header 每次换页都是全新节点，所以这个标记会自然重置。
     */
    if (header.dataset.headerInit === "1") return;
    header.dataset.headerInit = "1";

    // ── 桌面端下拉菜单（点击切换，点外部关闭见顶层监听器） ──
    const dropdowns = header.querySelectorAll<HTMLElement>(".header__dropdown");
    dropdowns.forEach((dd) => {
      const trigger = dd.querySelector<HTMLElement>(".header__dropdown-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", (e) => {
        e.preventDefault(); // 阻止 <a> 跳转
        const isOpen = dd.classList.contains("open");
        // 先关闭所有其他下拉
        closeAllDropdowns();
        if (!isOpen) dd.classList.add("open");
      });
    });

    // ── 移动端菜单 ──
    const toggle = document.getElementById("mobile-menu-toggle");
    const closeBtn = document.getElementById("mobile-menu-close");
    const menu = document.getElementById("mobile-menu");
    if (toggle && menu) {
      function openMenu() {
        menu.setAttribute("data-open", "true");
        toggle.setAttribute("aria-expanded", "true");
      }
      function closeMenu() {
        menu.setAttribute("data-open", "false");
        toggle.setAttribute("aria-expanded", "false");
      }

      toggle.addEventListener("click", () => {
        const isOpen = menu.getAttribute("data-open") === "true";
        isOpen ? closeMenu() : openMenu();
      });

      closeBtn?.addEventListener("click", closeMenu);
      menu.querySelector(".mobile-menu__backdrop")?.addEventListener("click", closeMenu);
      menu.querySelectorAll(".mobile-menu__link").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initHeader);
  document.addEventListener("astro:page-load", initHeader);
</script>
