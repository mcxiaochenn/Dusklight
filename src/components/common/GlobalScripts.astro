---
/**
 * 全局脚本
 * 图片灯箱 + 全局 Shell 滚动状态
 * 代码块复制已迁移到 expressive-code 的 custom-copy-button 插件
 */
---

<dialog id="lightbox" class="lightbox" aria-label="图片预览">
  <img id="lightbox-img" class="lightbox__img" alt="" />
</dialog>

<style>
  /* 原生 dialog：自带焦点隔离、Esc（cancel 事件）与背景 inert */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-material);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: oklch(0 0 0 / 0.8);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .lightbox--open { opacity: 1; }

  .lightbox__img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    transform: scale(0.95);
    transition: transform var(--duration-normal) var(--ease-decelerate);
  }

  .lightbox--open .lightbox__img { transform: scale(1); }

  :global(.prose img[data-lb]) { cursor: zoom-in; }
  :global(.prose img[data-lb]:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

<script>
  /* ── 图片灯箱 ──
     点击 / 键盘均走 document 级事件委托（模块顶层只绑定一次），
     解密后插入的正文图片同样可用。链接内的图片保持原有跳转行为。 */
  const LIGHTBOX_SELECTOR = ".prose img:not(a img)";
  let lightboxTrigger: HTMLImageElement | null = null;
  let lightboxCloseTimer = 0;

  function openLightbox(img: HTMLImageElement) {
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img");
    if (!(lb instanceof HTMLDialogElement) || !(lbImg instanceof HTMLImageElement)) return;
    window.clearTimeout(lightboxCloseTimer);
    lightboxTrigger = img;
    lbImg.src = img.currentSrc || img.src;
    lbImg.alt = img.alt;
    if (!lb.open) lb.showModal();
    requestAnimationFrame(() => lb.classList.add("lightbox--open"));
  }

  function closeLightbox() {
    const lb = document.getElementById("lightbox");
    if (!(lb instanceof HTMLDialogElement) || !lb.open) return;
    lb.classList.remove("lightbox--open");
    window.clearTimeout(lightboxCloseTimer);
    lightboxCloseTimer = window.setTimeout(() => {
      lb.close();
      if (lightboxTrigger?.isConnected) lightboxTrigger.focus({ preventScroll: true });
      lightboxTrigger = null;
    }, 250);
  }

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest("#lightbox")) {
      closeLightbox();
      return;
    }
    const img = e.target.closest(LIGHTBOX_SELECTOR);
    if (img instanceof HTMLImageElement) openLightbox(img);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const img = e.target instanceof Element ? e.target.closest(LIGHTBOX_SELECTOR) : null;
    if (!(img instanceof HTMLImageElement)) return;
    e.preventDefault();
    openLightbox(img);
  });

  // Esc 触发 dialog 的 cancel：拦截默认的瞬间关闭，改走淡出动画
  document.addEventListener("cancel", (e) => {
    if (e.target instanceof HTMLElement && e.target.id === "lightbox") {
      e.preventDefault();
      closeLightbox();
    }
  }, true);

  /** 每次换页给正文图片补上键盘可达性 */
  function initLightbox() {
    document.querySelectorAll<HTMLImageElement>(LIGHTBOX_SELECTOR).forEach((img) => {
      if (img.dataset.lb) return;
      img.dataset.lb = "1";
      img.tabIndex = 0;
      img.setAttribute("role", "button");
      img.setAttribute("aria-label", img.alt ? `查看大图：${img.alt}` : "查看大图");
    });
  }

  /* ── 全局 Shell 滚动状态 ──
     Header、返回顶部和进度条共享单个被动监听器；所有读写合并到下一帧，
     避免滚动期间多次同步布局。事件内始终查询当前页面节点，兼容 ClientRouter。 */
  let scrollFrame = 0;
  let lastScrollY = 0;
  // 移动端悬浮按钮紧贴正文右缘：向下阅读时收起，向上滚动或接近底部时再出现。
  const mobileFabMedia = window.matchMedia("(max-width: 768px)");
  function updateShellScrollState() {
    scrollFrame = 0;
    const scrollTop = window.scrollY;
    const delta = scrollTop - lastScrollY;
    lastScrollY = scrollTop;
    const viewportHeight = window.innerHeight;

    const header = document.getElementById("main-header");
    header?.classList.toggle("header-scrolled", scrollTop > 20);

    const btn = document.getElementById("back-to-top");
    btn?.classList.toggle("fab--visible", scrollTop > viewportHeight * 0.5);

    const scrollable = document.documentElement.scrollHeight - viewportHeight;
    const root = document.documentElement;
    if (!mobileFabMedia.matches || scrollTop >= scrollable - 80) {
      root.classList.remove("fab-retracted");
    } else if (Math.abs(delta) > 4) {
      root.classList.toggle("fab-retracted", delta > 0);
    }

    const bar = document.getElementById("scroll-progress");
    if (bar) {
      const progress = scrollable > 0 ? Math.min(scrollTop / scrollable, 1) : 0;
      bar.style.transform = `scaleX(${progress})`;
    }
  }

  function scheduleShellScrollState() {
    if (scrollFrame) return;
    scrollFrame = requestAnimationFrame(updateShellScrollState);
  }

  window.addEventListener("scroll", scheduleShellScrollState, { passive: true });
  document.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("#back-to-top")) {
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  function initAll() {
    initLightbox();
    scheduleShellScrollState();
  }
  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  // Vite HMR: re-init scripts when component modules update
  if (import.meta.hot) {
    import.meta.hot.on("vite:afterUpdate", () => initAll());
  }
</script>
