---
/**
 * 全局脚本
 * 图片灯箱 + 全局 Shell 滚动状态
 * 代码块复制已迁移到 expressive-code 的 custom-copy-button 插件
 */
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="图片预览" hidden>
  <img id="lightbox-img" class="lightbox__img" alt="" />
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(0 0 0 / 0.8);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-material);
  }

  .lightbox[hidden] { display: none; }
  .lightbox--open { opacity: 1; }

  .lightbox__img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    transform: scale(0.95);
    transition: transform var(--duration-normal) var(--ease-decelerate);
  }

  .lightbox--open .lightbox__img { transform: scale(1); }
</style>

<script>
  function initLightbox() {
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img") as HTMLImageElement;
    if (!lb || !lbImg) return;
    document.querySelectorAll(".prose img").forEach((img) => {
      if ((img as HTMLElement).dataset.lbInit) return;
      (img as HTMLElement).dataset.lbInit = "1";
      (img as HTMLElement).style.cursor = "zoom-in";
      img.addEventListener("click", () => {
        lbImg.src = (img as HTMLImageElement).src;
        lbImg.alt = (img as HTMLImageElement).alt;
        lb.hidden = false;
        requestAnimationFrame(() => lb.classList.add("lightbox--open"));
      });
    });
    if (lb.dataset.lbCloseInit) return;
    lb.dataset.lbCloseInit = "1";
    lb.addEventListener("click", () => {
      lb.classList.remove("lightbox--open");
      setTimeout(() => { lb.hidden = true; }, 300);
    });
  }

  /* ── 全局 Shell 滚动状态 ──
     Header、返回顶部和进度条共享单个被动监听器；所有读写合并到下一帧，
     避免滚动期间多次同步布局。事件内始终查询当前页面节点，兼容 ClientRouter。 */
  let scrollFrame = 0;
  function updateShellScrollState() {
    scrollFrame = 0;
    const scrollTop = window.scrollY;

    const header = document.getElementById("main-header");
    header?.classList.toggle("header-scrolled", scrollTop > 20);

    const btn = document.getElementById("back-to-top");
    btn?.classList.toggle("fab--visible", scrollTop > 1);

    const bar = document.getElementById("scroll-progress");
    if (bar) {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(scrollTop / scrollable, 1) : 0;
      bar.style.transform = `scaleX(${progress})`;
    }
  }

  function scheduleShellScrollState() {
    if (scrollFrame) return;
    scrollFrame = requestAnimationFrame(updateShellScrollState);
  }

  window.addEventListener("scroll", scheduleShellScrollState, { passive: true });
  document.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("#back-to-top")) {
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  function initAll() {
    initLightbox();
    scheduleShellScrollState();
  }
  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  // Vite HMR: re-init scripts when component modules update
  if (import.meta.hot) {
    import.meta.hot.on("vite:afterUpdate", () => initAll());
  }
</script>
