---
/**
 * 全局脚本
 * 图片灯箱 + 返回顶部
 * 代码块复制已迁移到 expressive-code 的 custom-copy-button 插件
 */
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="图片预览" hidden>
  <img id="lightbox-img" class="lightbox__img" alt="" />
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: oklch(0 0 0 / 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-material);
  }

  .lightbox[hidden] { display: none; }
  .lightbox--open { opacity: 1; }

  .lightbox__img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    transform: scale(0.95);
    transition: transform var(--duration-normal) var(--ease-decelerate);
  }

  .lightbox--open .lightbox__img { transform: scale(1); }
</style>

<script>
  function initLightbox() {
    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lightbox-img") as HTMLImageElement;
    if (!lb || !lbImg) return;
    document.querySelectorAll(".prose img").forEach((img) => {
      (img as HTMLElement).style.cursor = "zoom-in";
      img.addEventListener("click", () => {
        lbImg.src = (img as HTMLImageElement).src;
        lbImg.alt = (img as HTMLImageElement).alt;
        lb.hidden = false;
        requestAnimationFrame(() => lb.classList.add("lightbox--open"));
      });
    });
    lb.addEventListener("click", () => {
      lb.classList.remove("lightbox--open");
      setTimeout(() => { lb.hidden = true; }, 300);
    });
  }

  let backToTopBound = false;
  function initBackToTop() {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;
    function toggle() {
      btn.classList.toggle("back-to-top--visible", window.scrollY > 1);
    }
    if (!backToTopBound) {
      window.addEventListener("scroll", toggle, { passive: true });
      btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      backToTopBound = true;
    }
    toggle();
  }

  /* ── 滚动渐显 ── */
  function initReveal() {
    const els = document.querySelectorAll(".reveal");
    if (!els.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("reveal--visible");
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  }

  function initAll() { initLightbox(); initBackToTop(); initReveal(); }
  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  // Vite HMR: re-init scripts when component modules update
  if (import.meta.hot) {
    import.meta.hot.on("vite:afterUpdate", () => initAll());
  }
</script>
