---
/**
 * 侧栏站点统计 — 静态 4 项构建期计算；
 * 运行天数 / 最后活动随时间变化，由内联脚本在客户端计算
 * （is:inline + data-astro-rerun：View Transitions 换页后重新执行）
 */
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";

interface Props {
  postCount: number;
  categoryCount: number;
  tagCount: number;
  totalWords: number;
  /** 最新文章面值日 YYYY-MM-DD */
  latestDay: string;
}

const { postCount, categoryCount, tagCount, totalWords, latestDay } = Astro.props;
---

<div class="site-stats" data-start={siteConfig.siteStartDate} data-latest={latestDay}>
  <div class="site-stats__header">
    <Icon name="ph:chart-bar" class="site-stats__icon" />
    <span class="site-stats__title">站点统计</span>
  </div>
  <dl class="site-stats__grid">
    <div class="site-stats__item">
      <dt>文章</dt>
      <dd>{postCount}</dd>
    </div>
    <div class="site-stats__item">
      <dt>分类</dt>
      <dd>{categoryCount}</dd>
    </div>
    <div class="site-stats__item">
      <dt>标签</dt>
      <dd>{tagCount}</dd>
    </div>
    <div class="site-stats__item">
      <dt>总字数</dt>
      <dd>{totalWords.toLocaleString("zh-CN")}</dd>
    </div>
    <div class="site-stats__item">
      <dt>运行天数</dt>
      <dd data-stat="days">—</dd>
    </div>
    <div class="site-stats__item">
      <dt>最后活动</dt>
      <dd data-stat="active">—</dd>
    </div>
    <div class="site-stats__item" data-stat-row="total-pv" style="display:none">
      <dt>总访问</dt>
      <dd data-stat="total-pv">—</dd>
    </div>
    <div class="site-stats__item" data-stat-row="total-uv" style="display:none">
      <dt>总访客</dt>
      <dd data-stat="total-uv">—</dd>
    </div>
  </dl>
</div>

<script is:inline data-astro-rerun define:vars={{ analyticsApiUrl: siteConfig.analytics.apiUrl }}>
  (() => {
    const root = document.querySelector(".site-stats");
    if (!root) return;
    const DAY = 86400000;
    const days = root.querySelector('[data-stat="days"]');
    if (days) days.textContent = String(Math.ceil((Date.now() - new Date(root.dataset.start).getTime()) / DAY));
    const active = root.querySelector('[data-stat="active"]');
    if (active) {
      const diff = Math.floor((Date.now() - new Date(root.dataset.latest).getTime()) / DAY);
      active.textContent = diff <= 0 ? "今天" : `${diff} 天前`;
    }

    // Umami 站点统计
    fetch(analyticsApiUrl)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var pvRow = root.querySelector('[data-stat-row="total-pv"]');
        var uvRow = root.querySelector('[data-stat-row="total-uv"]');
        if (data.total_pv && pvRow) {
          pvRow.style.display = "";
          root.querySelector('[data-stat="total-pv"]').textContent = data.total_pv.toLocaleString("zh-CN");
        }
        if (data.total_uv && uvRow) {
          uvRow.style.display = "";
          root.querySelector('[data-stat="total-uv"]').textContent = data.total_uv.toLocaleString("zh-CN");
        }
      })
      .catch(function() {});
  })();
</script>

<style>
  .site-stats {
    padding: var(--space-4) var(--space-5);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  .site-stats__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--foreground);
  }

  .site-stats__icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .site-stats__title {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .site-stats__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-3) 0 0;
  }

  .site-stats__item dt {
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }

  .site-stats__item dd {
    margin: 2px 0 0;
    font-size: var(--text-md);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
  }
</style>
