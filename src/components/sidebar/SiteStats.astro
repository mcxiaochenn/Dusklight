---
/**
 * 侧栏站点统计与时间倒计时合并卡片（Mo 的记事簿风格）
 * 上部：春节倒计时 + 今日/本周/本月/本年进度条（Calendar.astro）
 * 分割：虚线分隔
 * 下部：站点统计列表（静态 4 项构建期计算 + 运行天数 / 最后活动 / Umami 总访问客户端计算）
 */
import { Icon } from "astro-icon/components";
import Calendar from "./Calendar.astro";
import { siteConfig } from "@/config";

interface Props {
  postCount: number;
  categoryCount: number;
  tagCount: number;
  totalWords: number;
  /** 最新文章面值日 YYYY-MM-DD */
  latestDay: string;
}

const { postCount, categoryCount, tagCount, totalWords, latestDay } = Astro.props;
---

<div class="site-stats" data-start={siteConfig.siteStartDate} data-latest={latestDay} data-api={siteConfig.analytics.apiUrl}>
  {/* 上部：春节倒计时 & 时间进度条 */}
  <Calendar />

  <hr class="site-stats__divider" />

  {/* 下部：站点统计 */}
  <div class="site-stats__header">
    <Icon name="fa7-solid:chart-simple" class="site-stats__icon" />
    <span class="site-stats__title">站点统计</span>
  </div>

  <dl class="site-stats__list">
    <div class="site-stats__row">
      <dt>文章总数</dt>
      <dd>{postCount} 篇</dd>
    </div>
    <div class="site-stats__row">
      <dt>全站字数</dt>
      <dd>{totalWords.toLocaleString("zh-CN")}</dd>
    </div>
    <div class="site-stats__row">
      <dt>分类 / 标签</dt>
      <dd>{categoryCount} / {tagCount}</dd>
    </div>
    <div class="site-stats__row">
      <dt>运行天数</dt>
      <dd data-stat="days">—</dd>
    </div>
    <div class="site-stats__row">
      <dt>最后活动</dt>
      <dd data-stat="active">—</dd>
    </div>
    <div class="site-stats__row" data-stat-row="total-uv" style="display:none">
      <dt>总访客数</dt>
      <dd data-stat="total-uv">—</dd>
    </div>
    <div class="site-stats__row" data-stat-row="total-pv" style="display:none">
      <dt>总访问量</dt>
      <dd data-stat="total-pv">—</dd>
    </div>
  </dl>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector(".site-stats");
    if (!root) return;
    const DAY = 86400000;
    const START_SUFFIX = "T00:00:00+08:00";
    const days = root.querySelector('[data-stat="days"]');
    if (days) days.textContent = `${Math.floor((Date.now() - new Date(root.dataset.start + START_SUFFIX).getTime()) / DAY)} 天`;
    const active = root.querySelector('[data-stat="active"]');
    if (active) {
      const diff = Math.floor((Date.now() - new Date(root.dataset.latest + START_SUFFIX).getTime()) / DAY);
      active.textContent = diff <= 0 ? "今天" : `${diff} 天前`;
    }

    var apiUrl = root.dataset.api;
    if (!apiUrl) return;
    var CACHE_KEY = "dusklight:site-stats";
    var CACHE_TTL = 5 * 60 * 1000;

    function renderVisits(data) {
      var pvRow = root.querySelector('[data-stat-row="total-pv"]');
      var uvRow = root.querySelector('[data-stat-row="total-uv"]');
      if (data.total_pv && pvRow) {
        pvRow.style.display = "";
        root.querySelector('[data-stat="total-pv"]').textContent = data.total_pv.toLocaleString("zh-CN");
      }
      if (data.total_uv && uvRow) {
        uvRow.style.display = "";
        root.querySelector('[data-stat="total-uv"]').textContent = data.total_uv.toLocaleString("zh-CN");
      }
    }

    function readCachedVisits() {
      try {
        var cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || "null");
        return cached && Date.now() - cached.savedAt < CACHE_TTL ? cached.data : null;
      } catch (_) {
        return null;
      }
    }

    function loadVisits() {
      var cached = readCachedVisits();
      if (cached) {
        renderVisits(cached);
        return;
      }

      fetch(apiUrl)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          try {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify({ savedAt: Date.now(), data: data }));
          } catch (_) {}
          renderVisits(data);
        })
        .catch(function() {});
    }

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(loadVisits, { timeout: 1200 });
    } else {
      window.setTimeout(loadVisits, 400);
    }
  })();
</script>

<style>
  .site-stats {
    padding: var(--space-4) var(--space-5);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition:
      border-color var(--duration-fast) var(--ease-material),
      box-shadow var(--duration-fast) var(--ease-material);
  }

  .site-stats:hover {
    border-color: var(--accent);
    box-shadow: var(--glass-hover-shadow), var(--glass-highlight);
  }

  .site-stats__divider {
    height: 0;
    margin: var(--space-4) 0;
    border: none;
    border-top: 1px dashed var(--glass-border);
    background: none;
  }

  .site-stats__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--foreground);
    margin-bottom: var(--space-3);
  }

  .site-stats__icon {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .site-stats__title {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .site-stats__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .site-stats__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    line-height: 1.5;
  }

  .site-stats__row dt {
    color: var(--foreground-secondary);
  }

  .site-stats__row dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
  }
</style>
