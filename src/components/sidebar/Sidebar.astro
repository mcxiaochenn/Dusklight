---
/**
 * 全站公用右侧栏
 * 顺序：个人介绍卡 → 公告 → [文章页在此插入粘性 TOC 插槽] → 无聊湾 → 站点统计（合并倒计时进度条） → 最新评论
 */
import ProfileCard from "./ProfileCard.astro";
import Announcement from "./Announcement.astro";
import BoringBay from "./BoringBay.astro";
import SiteStats from "./SiteStats.astro";
import RecentComments from "./RecentComments.svelte";
import { commentConfig } from "../../config/comment";
import { siteConfig } from "../../config/site";

export interface SidebarStats {
  postCount: number;
  categoryCount: number;
  tagCount: number;
  totalWords: number;
  /** 最新文章的面值日 YYYY-MM-DD（UTC 读取） */
  latestDay: string;
}

interface Props {
  stats: SidebarStats;
}

const { stats } = Astro.props;
---

<aside class="sidebar" data-pagefind-ignore>
  <ProfileCard />
  <Announcement />

  <div class="sticky_layout">
    {/* 文章页在公告下方插入目录，并与下方卡片作为一个整体随屏粘性滚动 */}
    <slot name="after-announcement" />

    <BoringBay />
    <SiteStats
      postCount={stats.postCount}
      categoryCount={stats.categoryCount}
      tagCount={stats.tagCount}
      totalWords={stats.totalWords}
      latestDay={stats.latestDay}
    />
    {commentConfig.enabled && commentConfig.recentComments.enabled && (
      <RecentComments
        client:visible
        envId={commentConfig.twikoo.envId}
        siteUrl={siteConfig.site}
        limit={commentConfig.recentComments.limit}
        includeReply={commentConfig.recentComments.includeReply}
      />
    )}
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    height: 100%;
  }

  .sticky_layout {
    position: sticky;
    top: calc(var(--header-height) + 20px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
</style>
