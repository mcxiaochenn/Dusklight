---
/**
 * 侧栏个人介绍卡片 — 头像、昵称、签名、社交图标
 */
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
---

<div class="profile-card">
  <a href="/about/" class="profile-card__avatar-link" aria-label="关于我">
    <img
      src={profileConfig.avatar}
      alt={profileConfig.name}
      class="profile-card__avatar"
      width="88"
      height="88"
      loading="lazy"
      decoding="async"
    />
  </a>
  <h2 class="profile-card__name">{profileConfig.name}</h2>
  <p class="profile-card__bio">{profileConfig.bio}</p>
  <div class="profile-card__socials">
    {profileConfig.socials.map((s) => (
      <a
        href={s.url}
        class="profile-card__social"
        target={s.url.startsWith("mailto:") ? undefined : "_blank"}
        rel="noopener noreferrer"
        aria-label={s.label}
        title={s.label}
      >
        <Icon name={s.icon} />
      </a>
    ))}
  </div>
</div>

<style>
  .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-6) var(--space-5);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  .profile-card__avatar-link {
    display: block;
    border-radius: 50%;
    line-height: 0;
  }

  .profile-card__avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-slow) var(--ease-material);
  }

  .profile-card__avatar-link:hover .profile-card__avatar {
    transform: rotate(360deg);
  }

  .profile-card__name {
    margin: var(--space-3) 0 0;
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .profile-card__bio {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--foreground-secondary);
  }

  .profile-card__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .profile-card__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    color: var(--foreground-secondary);
    transition: color var(--duration-fast) var(--ease-material),
                background var(--duration-fast) var(--ease-material);
  }

  .profile-card__social:hover {
    color: var(--accent);
    background: oklch(from var(--accent) l c h / 0.12);
  }

  .profile-card__social [data-icon] {
    width: 18px;
    height: 18px;
  }
</style>
