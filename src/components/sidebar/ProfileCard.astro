---
/**
 * 侧栏个人介绍卡片 — 竖版（上下比左右长）
 * 深浅实体表面；问候语胶囊在头像上方，点击随机更换语录；
 * 加载时先显示时间感知问候。蓝本：blog.zhheo.com 的 card-content
 */
import { Icon } from "astro-icon/components";
import { profileConfig, mottosConfig } from "@/config";
---

<div class="profile-card">
  <button
    type="button"
    class="profile-card__greet"
    id="profile-card-greet"
    aria-label="点击随机更换语录"
    data-mottos={JSON.stringify(mottosConfig.mottos)}
    data-greetings={JSON.stringify(mottosConfig.timeGreetings)}
  >
    {mottosConfig.mottos[0]}
  </button>

  <a href="/about/" class="profile-card__avatar-link" aria-label="关于我">
    <img
      src={profileConfig.avatar}
      alt={profileConfig.name}
      class="profile-card__avatar"
      width="120"
      height="120"
      loading="eager"
      decoding="async"
      onerror="this.src='/images/avatar-fallback.svg';this.onerror=null"
    />
  </a>

  <div class="profile-card__bottom">
    <a href="/about/" class="profile-card__identity" aria-label="关于我">
      <span class="profile-card__name">{profileConfig.name}</span>
      <span class="profile-card__bio">{profileConfig.bio}</span>
    </a>
    <div class="profile-card__socials">
      {profileConfig.socials.map((s) => (
        <a
          href={s.url}
          class="profile-card__social"
          target={s.url.startsWith("mailto:") ? undefined : "_blank"}
          rel="noopener noreferrer"
          aria-label={s.label}
          title={s.label}
        >
          <Icon name={s.icon} />
        </a>
      ))}
    </div>
  </div>
</div>

<script data-astro-rerun>
  (() => {
    const greet = document.getElementById("profile-card-greet");
    if (!greet || greet.dataset.init === "1") return;
    greet.dataset.init = "1";

    const MOTTOS = JSON.parse(greet.dataset.mottos);
    const TIME_GREETINGS = JSON.parse(greet.dataset.greetings);

    // 加载时先显示时间感知问候
    const hour = new Date().getHours();
    const greeting = TIME_GREETINGS.find((g) => hour >= g.from && hour < g.to);
    if (greeting) greet.textContent = greeting.text;

    // 点击随机换语录，排除上一条
    let last = -1;
    greet.addEventListener("click", () => {
      let i = Math.floor(Math.random() * MOTTOS.length);
      if (MOTTOS.length > 1 && i === last) i = (i + 1) % MOTTOS.length;
      last = i;
      greet.textContent = MOTTOS[i];
    });
  })();
</script>

<style>
  .profile-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 344px;
    padding: var(--space-5);
    gap: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--surface-1);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    color: var(--foreground);
  }

  /* 只保留局部主题色辉光，让 Hero 和文章流保持第一视觉层级。 */
  .profile-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(145deg, oklch(from var(--accent) l c h / 0.13), transparent 58%);
  }

  .profile-card__greet {
    cursor: pointer;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid oklch(from var(--accent) l c h / 0.22);
    background: var(--accent-subtle);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-weight: 500;
    max-width: 100%;
    min-height: 40px;
    text-align: center;
    line-height: 1.45;
    flex-shrink: 0;
    user-select: none;
    transition:
      background var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-material);
  }

  .profile-card__greet:hover {
    background: oklch(from var(--accent) l c h / 0.18);
    transform: translateY(-1px);
  }

  .profile-card__avatar-link {
    --corner-shape: var(--corner-shape-round);
    display: block;
    border-radius: 50%;
    line-height: 0;
    margin: 0;
    flex-shrink: 0;
  }

  .profile-card__avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid oklch(from var(--accent) l c h / 0.28);
    box-shadow: var(--shadow-md);
    transition: transform var(--duration-slow) var(--ease-material);
  }

  .profile-card__avatar-link:hover .profile-card__avatar {
    transform: rotate(360deg);
  }

  .profile-card__bottom {
    /* 6 个社交图标 + 名字签名一行放不下（space-between 会溢出卡片，
       被 overflow:hidden 裁掉），改为上下居中排列，社交区 wrap */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    margin-top: 0;
  }

  .profile-card__identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .profile-card__name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .profile-card__bio {
    font-size: var(--text-xs);
    color: var(--foreground-secondary);
  }

  .profile-card__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    min-height: 32px;
  }

  .profile-card__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    color: var(--foreground-secondary);
    transition:
      background var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-material);
  }

  .profile-card__social:hover {
    background: var(--accent-subtle);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .profile-card__social [data-icon] {
    width: 18px;
    height: 18px;
  }
</style>
