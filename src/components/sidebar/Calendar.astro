---
/**
 * 倒计时与时间进度条 — 仿 Mo 的记事簿 #card-countdown
 * 嵌入站点统计卡片内：左侧展示下一个目标节日（春节）倒计时，
 * 右侧展示今日/本周/本月/本年进度条，悬停可切换查看剩余小时/天数。
 */
---

<div class="countdown" id="card-countdown">
  <div class="countdown__left">
    <span class="countdown__text">距离</span>
    <span class="countdown__name" id="cd-event-name">春节</span>
    <span class="countdown__days" id="cd-days">—</span>
    <span class="countdown__date" id="cd-event-date">—</span>
  </div>

  <div class="countdown__right">
    <div class="countdown__item" data-cd="day">
      <span class="countdown__label">今日</span>
      <div class="countdown__track">
        <div class="countdown__bar" style="width: 0%"></div>
        <span class="countdown__pct">—</span>
        <span class="countdown__rem">—</span>
      </div>
    </div>
    <div class="countdown__item" data-cd="week">
      <span class="countdown__label">本周</span>
      <div class="countdown__track">
        <div class="countdown__bar" style="width: 0%"></div>
        <span class="countdown__pct">—</span>
        <span class="countdown__rem">—</span>
      </div>
    </div>
    <div class="countdown__item" data-cd="month">
      <span class="countdown__label">本月</span>
      <div class="countdown__track">
        <div class="countdown__bar" style="width: 0%"></div>
        <span class="countdown__pct">—</span>
        <span class="countdown__rem">—</span>
      </div>
    </div>
    <div class="countdown__item" data-cd="year">
      <span class="countdown__label">本年</span>
      <div class="countdown__track">
        <div class="countdown__bar" style="width: 0%"></div>
        <span class="countdown__pct">—</span>
        <span class="countdown__rem">—</span>
      </div>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.getElementById("card-countdown");
    if (!root || root.dataset.cdInit === "1") return;
    root.dataset.cdInit = "1";

    // 近几年春节公历日期表（按 +08:00 计算）
    const SPRING_FESTIVALS = [
      { name: "春节", date: "2026-02-17" },
      { name: "春节", date: "2027-02-06" },
      { name: "春节", date: "2028-01-26" },
      { name: "春节", date: "2029-02-13" },
      { name: "春节", date: "2030-02-03" },
    ];

    function updateCountdown() {
      const now = new Date();
      // 换算北京时间 (+08:00) 年月日时分秒
      const bjMs = now.getTime() + 8 * 3600000;
      const bj = new Date(bjMs);
      const year = bj.getUTCFullYear();
      const month = bj.getUTCMonth();
      const day = bj.getUTCDate();
      const hour = bj.getUTCHours();
      const minute = bj.getUTCMinutes();
      const second = bj.getUTCSeconds();

      // 寻找下一个未来节日
      const todayMidnight = Date.UTC(year, month, day) - 8 * 3600000;
      let target = SPRING_FESTIVALS.find((f) => new Date(`${f.date}T00:00:00+08:00`).getTime() >= todayMidnight);
      if (!target) target = { name: "元旦", date: `${year + 1}-01-01` };

      const targetMs = new Date(`${target.date}T00:00:00+08:00`).getTime();
      const daysUntil = Math.max(0, Math.ceil((targetMs - todayMidnight) / 86400000));

      const nameEl = root.querySelector("#cd-event-name");
      const daysEl = root.querySelector("#cd-days");
      const dateEl = root.querySelector("#cd-event-date");
      if (nameEl) nameEl.textContent = target.name;
      if (daysEl) daysEl.textContent = String(daysUntil);
      if (dateEl) dateEl.textContent = target.date;

      // 1. 今日进度（精确到秒）
      const passedDaySec = hour * 3600 + minute * 60 + second;
      const dayPct = (passedDaySec / 86400) * 100;
      const dayRemH = Math.max(0, 24 - passedDaySec / 3600);

      // 2. 本周进度（周一为第 1 天）
      const weekday = (bj.getUTCDay() + 6) % 7; // 0=Mon .. 6=Sun
      const passedWeekDays = weekday + passedDaySec / 86400;
      const weekPct = (passedWeekDays / 7) * 100;
      const weekRemD = Math.max(0, 7 - weekday);

      // 3. 本月进度
      const totalDaysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
      const passedMonthDays = (day - 1) + passedDaySec / 86400;
      const monthPct = (passedMonthDays / totalDaysInMonth) * 100;
      const monthRemD = Math.max(0, totalDaysInMonth - day + 1);

      // 4. 本年进度
      const yearStart = Date.UTC(year, 0, 1) - 8 * 3600000;
      const nextYearStart = Date.UTC(year + 1, 0, 1) - 8 * 3600000;
      const totalYearMs = nextYearStart - yearStart;
      const passedYearMs = now.getTime() - yearStart;
      const yearPct = (passedYearMs / totalYearMs) * 100;
      const yearRemD = Math.max(0, Math.ceil((nextYearStart - now.getTime()) / 86400000));

      const map = {
        day: { pct: dayPct, rem: `还剩${dayRemH.toFixed(1)}时` },
        week: { pct: weekPct, rem: `还剩${weekRemD}天` },
        month: { pct: monthPct, rem: `还剩${monthRemD}天` },
        year: { pct: yearPct, rem: `还剩${yearRemD}天` },
      };

      Object.entries(map).forEach(([key, val]) => {
        const row = root.querySelector(`[data-cd="${key}"]`);
        if (!row) return;
        const bar = row.querySelector(".countdown__bar");
        const pctEl = row.querySelector(".countdown__pct");
        const remEl = row.querySelector(".countdown__rem");
        const clamped = Math.max(0, Math.min(100, val.pct));
        if (bar) {
          bar.style.width = `${clamped.toFixed(2)}%`;
          bar.style.opacity = String(Math.max(0.28, clamped / 100));
        }
        if (pctEl) pctEl.textContent = `${clamped.toFixed(1)}%`;
        if (remEl) remEl.textContent = val.rem;
      });
    }

    updateCountdown();
  })();
</script>

<style>
  .countdown {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
  }

  .countdown__left {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-right: var(--space-3);
    line-height: 1.35;
    min-width: 78px;
    flex-shrink: 0;
  }

  .countdown__left::after {
    content: "";
    position: absolute;
    right: 0;
    top: 10%;
    height: 80%;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.45;
  }

  .countdown__text {
    font-size: 12px;
    color: var(--foreground-muted);
  }

  .countdown__name {
    font-size: 17px;
    font-weight: 800;
    color: var(--foreground);
  }

  .countdown__days {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin: 2px 0;
  }

  .countdown__date {
    font-size: 11px;
    color: var(--foreground-muted);
    font-variant-numeric: tabular-nums;
  }

  .countdown__right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .countdown__item {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 23px;
  }

  .countdown__label {
    font-size: 12px;
    font-weight: 600;
    color: var(--foreground-secondary);
    flex-shrink: 0;
  }

  .countdown__track {
    position: relative;
    flex: 1;
    height: 100%;
    border-radius: var(--radius-xs);
    background: oklch(0.5 0.015 var(--hue) / 0.14);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  :global(:root.dark) .countdown__track {
    background: oklch(0.14 0.01 var(--hue) / 0.65);
  }

  .countdown__bar {
    height: 100%;
    border-radius: var(--radius-xs);
    background: var(--accent);
    transition: width 0.4s var(--ease-material);
  }

  .countdown__pct,
  .countdown__rem {
    position: absolute;
    left: 8px;
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--foreground);
    text-shadow: 0 1px 2px oklch(0 0 0 / 0.25);
    transition:
      opacity 0.24s var(--ease-material),
      transform 0.24s var(--ease-material);
    pointer-events: none;
  }

  .countdown__rem {
    opacity: 0;
    transform: translateX(8px);
  }

  .countdown:hover .countdown__pct {
    opacity: 0;
    transform: translateX(-8px);
  }

  .countdown:hover .countdown__rem {
    opacity: 1;
    transform: translateX(0);
  }
</style>
