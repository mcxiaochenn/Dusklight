---
/**
 * 侧栏日历 — 原版 Mizuki Svelte 实现迁移
 * 三层视图（日/月/年）、点击标题切换、当前文章高亮、60s 跨午夜刷新
 * 玻璃卡片外壳 + client:load Svelte 岛
 */
import CalendarWidget from "./calendar/Calendar.svelte";

const monthNames = [
	"1月",
	"2月",
	"3月",
	"4月",
	"5月",
	"6月",
	"7月",
	"8月",
	"9月",
	"10月",
	"11月",
	"12月",
];
// 周一开头：getFirstDayOfMonth 以周一为 0
const weekDays = ["一", "二", "三", "四", "五", "六", "日"];
const yearSuffix = "年";
---

<div class="calendar">
	<CalendarWidget client:load {monthNames} {weekDays} {yearSuffix} />
</div>

<style>
	.calendar {
		padding: var(--space-4) var(--space-5);
		background: var(--glass-bg);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
		backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm), var(--glass-highlight);
	}
</style>
