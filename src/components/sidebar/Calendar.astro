---
/**
 * 侧栏日历 — 纯 Astro + vanilla JS（蓝本：Firefly 主题 Calendar.astro）
 * 日视图 + 月/年选择器 + 年度活跃热力图（月度 12×4，5 档透明度）
 * 数据源 /api/calendar-data.json（{id, title, date: YYYY-MM-DD}）
 * 星期周一起始，与原 Mizuki 日历一致。
 *
 * 脚本用普通 <script data-astro-rerun> 而非 is:inline：
 * 脚本内大量 JS 对象字面量会被 Astro 的 {} 表达式解析破坏。
 * data-astro-rerun 让 View Transitions 换页后重新执行，dataset 防重入。
 */
import { Icon } from "astro-icon/components";
---

<div class="calendar" id="site-calendar">
  <div class="calendar__header">
    <button type="button" class="calendar__nav" id="cal-prev" aria-label="上个月">
      <Icon name="ph:caret-left" />
    </button>
    <button type="button" class="calendar__title" id="cal-title" aria-label="选择月份或年份">
      <span id="cal-title-text">—</span>
    </button>
    <div class="calendar__actions">
      <button type="button" class="calendar__nav calendar__nav--today" id="cal-reset" aria-label="回到今天" hidden>
        <Icon name="ph:arrow-counter-clockwise" />
      </button>
      <button type="button" class="calendar__nav" id="cal-next" aria-label="下个月">
        <Icon name="ph:caret-right" />
      </button>
    </div>
  </div>

  <!-- 日视图 -->
  <div class="calendar__day-view" id="cal-day-view">
    <div class="calendar__weekdays">
      <span>一</span><span>二</span><span>三</span><span>四</span>
      <span>五</span><span>六</span><span>日</span>
    </div>
    <div class="calendar__grid" id="cal-grid"></div>

    <!-- 年度活跃热力图（月度 12×4） -->
    <div class="calendar__heatmap" id="cal-heatmap">
      <div class="calendar__heatmap-months" id="cal-heatmap-months"></div>
      <div class="calendar__heatmap-grid" id="cal-heatmap-grid"></div>
    </div>

    <!-- 文章列表 -->
    <div class="calendar__posts" id="cal-posts">
      <div class="calendar__divider"></div>
      <div class="calendar__post-list" id="cal-post-list"></div>
    </div>
  </div>

  <!-- 月视图 -->
  <div class="calendar__pick-view" id="cal-month-view" hidden></div>
  <!-- 年视图 -->
  <div class="calendar__pick-view" id="cal-year-view" hidden></div>
</div>

<script data-astro-rerun>
  (() => {
    const root = document.getElementById("site-calendar");
    if (!root || root.dataset.init === "1") return;
    root.dataset.init = "1";

    const MONTH_NAMES = ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"];

    // 站点时区（+08:00）的"今天" —— 与 SiteStats/Footer 统一口径
    const siteToday = () => {
      const t = new Date(Date.now() + 8 * 3600 * 1000);
      return { year: t.getUTCFullYear(), month: t.getUTCMonth(), day: t.getUTCDate() };
    };

    // ── 状态 ──
    let displayYear = siteToday().year;
    let displayMonth = siteToday().month;
    let view = "day"; // day | month | year
    let postDateMap = {};
    let availableYears = [];
    let selectedDay = null; // "YYYY-MM-DD"

    const $ = (id) => document.getElementById(id);
    const pad = (n) => String(n).padStart(2, "0");
    const dateKey = (y, m, d) => `${y}-${pad(m + 1)}-${pad(d)}`;
    const todayKey = dateKey(displayYear, displayMonth, siteToday().day);

    function mk(tag, cls, text) {
      const el = document.createElement(tag);
      if (cls) el.className = cls;
      if (text !== undefined) el.textContent = text;
      return el;
    }

    // ── 数据 ──
    async function fetchData() {
      try {
        const res = await fetch("/api/calendar-data.json");
        const data = await res.json();
        if (!Array.isArray(data)) return;
        postDateMap = {};
        const years = new Set();
        for (const p of data) {
          if (!p.date) continue;
          if (!postDateMap[p.date]) postDateMap[p.date] = [];
          postDateMap[p.date].push(p);
          years.add(p.date.slice(0, 4));
        }
        availableYears = [...years].sort((a, b) => Number(b) - Number(a));
        render();
      } catch (err) {
        console.error("Failed to fetch calendar data:", err);
      }
    }

    // ── 视图路由 ──
    function render() {
      // hidden 是三个视图唯一的显隐源，避免 style.display 与初始
      // [hidden] 属性互相打架（之前月/年标题变化但面板始终不可见）。
      $("cal-day-view").hidden = view !== "day";
      $("cal-month-view").hidden = view !== "month";
      $("cal-year-view").hidden = view !== "year";
      updateHeader();
      if (view === "day") renderDay();
      else if (view === "month") renderMonths();
      else renderYears();
      renderHeatmap();
    }

    function updateHeader() {
      const title = $("cal-title-text");
      if (view === "day") title.textContent = `${displayYear}年${MONTH_NAMES[displayMonth]}`;
      else if (view === "month") title.textContent = `${displayYear}年`;
      else title.textContent = "选择年份";

      // displayYear 是 number，todayKey.slice 返回 string —— 必须显式转 number，
      // 否则严格比较恒 false，reset 按钮永远不隐藏
      const isCurrent =
        displayYear === Number(todayKey.slice(0, 4)) && displayMonth === Number(todayKey.slice(5, 7)) - 1;
      $("cal-reset").hidden = view === "day" && isCurrent && !selectedDay;
      const hide = view === "year" ? "hidden" : "";
      $("cal-prev").style.visibility = hide;
      $("cal-next").style.visibility = hide;
    }

    function monthPosts(y, m) {
      const prefix = `${y}-${pad(m + 1)}-`;
      return Object.keys(postDateMap)
        .filter((k) => k.startsWith(prefix))
        .sort()
        .map((k) => postDateMap[k])
        .flat();
    }

    function renderDay() {
      const grid = $("cal-grid");
      grid.innerHTML = "";
      const total = new Date(displayYear, displayMonth + 1, 0).getDate();
      // 周一起始：offset = (getDay() + 6) % 7
      const start = (new Date(displayYear, displayMonth, 1).getDay() + 6) % 7;

      for (let i = 0; i < start; i++) {
        grid.appendChild(mk("div", "calendar__day calendar__day--empty"));
      }
      for (let d = 1; d <= total; d++) {
        const key = dateKey(displayYear, displayMonth, d);
        const posts = postDateMap[key] || [];
        const cell = mk("div", "calendar__day");
        cell.dataset.day = key;
        if (posts.length > 0) {
          cell.classList.add("calendar__day--has-post");
          cell.appendChild(mk("span", "calendar__day-dot"));
          if (posts.length > 1) cell.appendChild(mk("span", "calendar__day-count", String(posts.length)));
        }
        if (key === todayKey) cell.classList.add("calendar__day--today");
        if (key === selectedDay) cell.classList.add("calendar__day--selected");
        cell.appendChild(mk("span", "calendar__day-num", String(d)));
        grid.appendChild(cell);
      }

      renderPosts(selectedDay ? postDateMap[selectedDay] || [] : monthPosts(displayYear, displayMonth));
    }

    function renderPosts(posts) {
      const wrap = $("cal-posts");
      const list = $("cal-post-list");
      list.innerHTML = "";
      if (!posts.length) {
        wrap.style.display = "none";
        return;
      }
      wrap.style.display = "";
      for (const p of posts) {
        const [, m, d] = p.date.split("-");
        const a = mk("a", "calendar__post-link");
        a.href = `/posts/${p.id}/`;
        a.appendChild(mk("span", "calendar__post-title", p.title));
        a.appendChild(mk("span", "calendar__post-date", `${Number(m)}-${Number(d)}`));
        list.appendChild(a);
      }
    }

    function renderHeatmap() {
      const wrap = $("cal-heatmap");
      wrap.style.display = view === "day" ? "" : "none";
      if (view !== "day") return;

      const monthsEl = $("cal-heatmap-months");
      monthsEl.innerHTML = "";
      for (let m = 1; m <= 12; m++) monthsEl.appendChild(mk("span", "calendar__heat-month", String(m)));

      // 聚合 heat[m][week]：week = min(floor((day-1)/7), 3)，29-31 日并入第 4 周
      const heat = {};
      for (const key of Object.keys(postDateMap)) {
        if (!key.startsWith(`${displayYear}-`)) continue;
        const parts = key.split("-");
        const m = Number(parts[1]);
        const d = Number(parts[2]);
        const week = Math.min(Math.floor((d - 1) / 7), 3);
        if (!heat[m]) heat[m] = [0, 0, 0, 0];
        heat[m][week] += postDateMap[key].length;
      }

      const gridEl = $("cal-heatmap-grid");
      gridEl.innerHTML = "";
      for (let week = 0; week < 4; week++) {
        for (let m = 1; m <= 12; m++) {
          const cell = mk("div", "calendar__heat-cell");
          cell.dataset.month = String(m);
          const count = (heat[m] || [])[week] || 0;
          if (count > 0) {
            // 4 档深浅（l1-l4），色值由 CSS class 定义 —— 不用 opacity：
            // opacity 会让格子透出玻璃底下的背景照片，颜色浑浊
            const level = Math.min(count, 4);
            cell.classList.add(`calendar__heat-cell--l${level}`);
          } else {
            cell.classList.add("calendar__heat-cell--empty");
          }
          cell.dataset.tooltip = `${m}月第${week + 1}周，${count}篇文章`;
          gridEl.appendChild(cell);
        }
      }
    }

    function renderMonths() {
      const wrap = $("cal-month-view");
      wrap.innerHTML = "";
      const hasPosts = new Set();
      const prefix = `${displayYear}-`;
      for (const key of Object.keys(postDateMap)) {
        if (key.startsWith(prefix)) hasPosts.add(Number(key.slice(5, 7)) - 1);
      }
      for (let m = 0; m < 12; m++) {
        const cell = mk("div", "calendar__pick");
        if (m === displayMonth) cell.classList.add("calendar__pick--current");
        cell.dataset.monthCell = String(m);
        cell.appendChild(mk("span", "", MONTH_NAMES[m]));
        if (hasPosts.has(m)) cell.appendChild(mk("span", "calendar__pick-dot"));
        wrap.appendChild(cell);
      }
    }

    function renderYears() {
      const wrap = $("cal-year-view");
      wrap.innerHTML = "";
      if (!availableYears.length) {
        wrap.appendChild(mk("div", "calendar__pick", `${displayYear}年`));
        return;
      }
      for (const y of availableYears) {
        const cell = mk("div", "calendar__pick");
        if (Number(y) === displayYear) cell.classList.add("calendar__pick--current");
        cell.dataset.yearCell = y;
        cell.appendChild(mk("span", "", `${y}年`));
        wrap.appendChild(cell);
      }
    }

    // ── 交互：事件委托（grid 用 innerHTML 重建，委托避免重复绑定） ──
    root.addEventListener("click", (e) => {
      if (!(e.target instanceof Element)) return;
      const target = e.target.closest("[data-day],[data-month-cell],[data-year-cell],[data-month]");
      if (!target) return;

      if (target.dataset.day && view === "day") {
        selectedDay = selectedDay === target.dataset.day ? null : target.dataset.day;
        render();
        return;
      }
      if (target.dataset.monthCell) {
        displayMonth = Number(target.dataset.monthCell);
        view = "day";
        selectedDay = null;
        render();
        return;
      }
      if (target.dataset.yearCell) {
        displayYear = Number(target.dataset.yearCell);
        view = "month";
        render();
        return;
      }
      if (target.dataset.month) {
        // 热力图格子：跳到该月日视图
        displayMonth = Number(target.dataset.month) - 1;
        view = "day";
        selectedDay = null;
        render();
      }
    });

    // 头部按钮
    $("cal-title").addEventListener("click", () => {
      view = view === "day" ? "month" : view === "month" ? "year" : "day";
      selectedDay = null;
      render();
    });
    $("cal-prev").addEventListener("click", () => {
      if (view === "month") displayYear--;
      else {
        displayMonth--;
        if (displayMonth < 0) {
          displayMonth = 11;
          displayYear--;
        }
      }
      selectedDay = null;
      render();
    });
    $("cal-next").addEventListener("click", () => {
      if (view === "month") displayYear++;
      else {
        displayMonth++;
        if (displayMonth > 11) {
          displayMonth = 0;
          displayYear++;
        }
      }
      selectedDay = null;
      render();
    });
    $("cal-reset").addEventListener("click", () => {
      const t = siteToday();
      displayYear = t.year;
      displayMonth = t.month;
      view = "day";
      selectedDay = null;
      render();
    });

    // tooltip：挂 body（卡片 backdrop-filter 会劫持 fixed 定位基准，不能挂卡片内）
    document.getElementById("cal-tooltip")?.remove();
    const tip = mk("div", "calendar__tooltip");
    tip.id = "cal-tooltip";
    document.body.appendChild(tip);
    root.addEventListener("mouseover", (e) => {
      if (!(e.target instanceof Element)) return;
      const cell = e.target.closest("[data-tooltip]");
      if (!cell) return;
      tip.textContent = cell.dataset.tooltip;
      const r = cell.getBoundingClientRect();
      tip.style.left = `${r.left + r.width / 2}px`;
      tip.style.top = `${r.top - 6}px`;
      tip.style.opacity = "1";
    });
    root.addEventListener("mouseout", (e) => {
      if (!(e.target instanceof Element)) return;
      if (e.target.closest("[data-tooltip]")) tip.style.opacity = "0";
    });

    // 初始化：先渲染空网格，数据到后重渲染
    render();
    fetchData();
  })();
</script>

<style>
  .calendar {
    padding: var(--space-4) var(--space-5);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--glass-highlight);
  }

  .calendar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .calendar__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: relative;
    padding: var(--space-1) var(--space-2);
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--foreground);
    transition: background var(--duration-fast) var(--ease-material);
  }

  .calendar__title::before {
    content: "";
    width: 4px;
    height: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--accent);
  }

  .calendar__title:hover {
    background: var(--surface-1);
  }

  .calendar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .calendar__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--foreground-muted);
    transition: all var(--duration-fast) var(--ease-material);
  }

  .calendar__nav:hover {
    background: var(--surface-1);
    color: var(--accent);
  }

  .calendar__nav--today {
    color: var(--accent);
  }

  /* 作者样式 display:flex 会覆盖 UA 的 [hidden]{display:none}，
     必须显式声明「回到今天」按钮才能随状态真正隐藏 */
  .calendar__nav[hidden] {
    display: none;
  }

  .calendar__nav [data-icon] {
    width: 16px;
    height: 16px;
  }

  /* 星期标题 */
  .calendar__weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: var(--space-1);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--foreground-muted);
  }

  /* 日格子 */
  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .calendar__day {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    min-height: 32px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--foreground);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-material),
                background var(--duration-fast) var(--ease-material);
  }

  .calendar__day--empty {
    cursor: default;
  }

  .calendar__day--has-post {
    font-weight: 700;
  }

  .calendar__day--has-post:hover {
    transform: translateY(-2px);
    background: var(--surface-1);
  }

  .calendar__day--today {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .calendar__day--selected {
    background: oklch(from var(--accent) l c h / 0.16);
  }

  .calendar__day-num {
    line-height: 1;
  }

  .calendar__day-dot {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .calendar__day-count {
    position: absolute;
    top: 0;
    right: 1px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  /* 热力图（月度 12×4） */
  .calendar__heatmap {
    margin-top: var(--space-4);
  }

  .calendar__heatmap-months {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    margin-bottom: 2px;
  }

  .calendar__heat-month {
    font-size: 10px;
    line-height: 1;
    text-align: center;
    color: var(--foreground-muted);
  }

  .calendar__heatmap-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(4, 1fr);
    row-gap: 2px;
  }

  .calendar__heat-cell {
    width: 85%;
    aspect-ratio: 1;
    margin: 0 auto;
    border-radius: 3px;
    background: var(--surface-1);
    cursor: pointer;
    transition: box-shadow 0.15s ease;
  }

  /* 4 档深浅：accent 亮度递减（oklch 相对语法），颜色真实不透明。
     color-mix(in oklch, var(--accent) X%, var(--surface-1)) 在本环境
     computedStyle 为透明（两个 oklch 变量混合解析失败），弃用 */
  .calendar__heat-cell--l1 { background: oklch(from var(--accent) calc(l + 0.16) c h); }
  .calendar__heat-cell--l2 { background: oklch(from var(--accent) calc(l + 0.10) c h); }
  .calendar__heat-cell--l3 { background: oklch(from var(--accent) calc(l + 0.04) c h); }
  .calendar__heat-cell--l4 { background: var(--accent); }

  .calendar__heat-cell--empty {
    cursor: default;
  }

  .calendar__heat-cell:hover {
    box-shadow: 0 0 0 1.5px var(--accent);
  }

  /* 月/年选择器 */
  .calendar__pick-view {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .calendar__pick-view[hidden] {
    display: none;
  }

  .calendar__pick {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) 0;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--foreground);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-material);
  }

  .calendar__pick:hover {
    background: var(--surface-1);
  }

  .calendar__pick--current {
    font-weight: 700;
    color: var(--accent);
  }

  .calendar__pick-dot {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 文章列表 */
  .calendar__posts {
    margin-top: var(--space-3);
  }

  .calendar__divider {
    height: 1px;
    width: 100%;
    background: var(--border-subtle);
    margin-bottom: var(--space-2);
  }

  .calendar__post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-height: 150px;
    overflow-y: auto;
  }

  .calendar__post-list::-webkit-scrollbar {
    width: 4px;
  }

  .calendar__post-list::-webkit-scrollbar-thumb {
    background-color: color-mix(in oklch, var(--foreground-muted) 50%, transparent);
    border-radius: 2px;
  }

  .calendar__post-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--foreground-secondary);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-material);
  }

  .calendar__post-link:hover {
    color: var(--accent);
    background: var(--surface-1);
  }

  .calendar__post-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }

  .calendar__post-date {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }

  /* tooltip — fixed 挂 body */
  .calendar__tooltip {
    position: fixed;
    z-index: 999;
    padding: 4px 8px;
    border-radius: 6px;
    background: oklch(0.16 0.012 var(--hue) / 0.92);
    color: oklch(0.98 0.008 var(--hue));
    font-size: 12px;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -100%);
    transition: opacity 0.15s ease;
  }
</style>
