---
/**
 * Twikoo 1.7.15 评论组件
 * 动态加载 + View Transitions 兼容 + CSS 本地强制覆盖
 */
import { commentConfig } from "../../config/comment";
import { Icon } from "astro-icon/components";
---

{commentConfig.enabled && (
  <div class="comments-section">
    <h2 class="comments__heading">评论</h2>
    <div id="twikoo" class="comments__container"></div>
  </div>
  <button class="comments__fab" id="jump-comments" aria-label="跳转到评论">
    <Icon name="ph:chat-circle-text" />
  </button>
)}

<style>
  .comments-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .comments__heading {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-4);
    color: var(--foreground);
  }

  .comments__container {
    min-height: 200px;
    width: 100%;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  /* 跳转评论 FAB */
  .comments__fab {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-10) + 20px + 44px + var(--space-2));
    z-index: 50;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-md);
    color: var(--foreground-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 初始隐藏，滚动门控显示（跟随 BackToTop 可见性）——避免常驻遮住评论区 */
    opacity: 0;
    transform: translateX(calc(100% + 20px));
    pointer-events: none;
    transition: opacity 0.2s var(--ease-decelerate),
                transform 0.2s var(--ease-decelerate);
  }

  .comments__fab--visible {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .comments__fab--visible:hover {
    color: var(--accent);
    transform: scale(1.05);
  }

  .comments__fab svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 640px) {
    .comments__fab {
      bottom: calc(var(--space-8) + 16px + 40px + var(--space-2));
      right: var(--space-3);
    }
  }
</style>

{commentConfig.enabled && (
  <script is:inline>
    (function() {
      function bindFab() {
        var fab = document.getElementById("jump-comments");
        if (!fab || fab.dataset.bound) return;
        fab.dataset.bound = "1";
        fab.addEventListener("click", function() {
          var el = document.getElementById("twikoo");
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        // 滚动门控：跟随 BackToTop 的可见性（GlobalScripts 控制 .fab--visible/.fab--hiding），
        // 滚动到一定位置才显示 FAB，避免常驻遮住评论区
        var btt = document.getElementById("back-to-top");
        function sync() {
          var show = btt && btt.classList.contains("fab--visible");
          fab.classList.toggle("comments__fab--visible", !!show);
        }
        if (btt) {
          new MutationObserver(sync).observe(btt, { attributes: true, attributeFilter: ["class"] });
        }
        sync();
      }
      bindFab();
      document.addEventListener("astro:page-load", bindFab);
    })();
  </script>
  <script define:vars={{ envId: commentConfig.twikoo.envId }}>
    (() => {
      var TWIKOO_SRC = "/js/twikoo.min.js";
      var STATE_KEY = "__dusklightTwikoo";
      var state = window[STATE_KEY];

      if (!state) {
        state = {
          loadPromise: null,
          observer: null,
          mountVersion: 0,
          currentEl: null,
          eventsBound: false,
        };
        window[STATE_KEY] = state;
      }

      function getTheme() {
        return document.documentElement.classList.contains("dark") ? "dark" : "light";
      }

      function loadTwikoo() {
        if (window.twikoo && typeof window.twikoo.init === "function") {
          return Promise.resolve(window.twikoo);
        }
        if (state.loadPromise) return state.loadPromise;

        state.loadPromise = new Promise(function(resolve, reject) {
          // 删除旧标签再重建，保证 load 事件一定触发。
          // View Transitions 导航后 DOM 中的旧标签早已加载完毕，
          // 复用它会挂载一个永不触发的 load 监听器 → Promise 永久挂起。
          var old = document.querySelector('script[src="' + TWIKOO_SRC + '"]');
          if (old) old.remove();
          state.loadPromise = null;

          var script = document.createElement("script");

          function loaded() {
            if (window.twikoo && typeof window.twikoo.init === "function") {
              resolve(window.twikoo);
            } else {
              reject(new Error("Twikoo script loaded without an init API"));
            }
          }

          script.addEventListener("load", loaded, { once: true });
          script.addEventListener("error", function() {
            state.loadPromise = null;
            reject(new Error("Failed to load Twikoo: " + TWIKOO_SRC));
          }, { once: true });

          script.src = TWIKOO_SRC;
          script.async = true;
          document.head.appendChild(script);
        });

        return state.loadPromise;
      }

      function stopOverrides() {
        state.observer?.disconnect();
        state.observer = null;
      }

      function patchInputs(container) {
        var cs = getComputedStyle(document.documentElement);
        var bg = cs.getPropertyValue("--glass-bg").trim();
        var border = cs.getPropertyValue("--glass-border").trim();
        var fg = cs.getPropertyValue("--foreground").trim();

        container.querySelectorAll(".el-textarea__inner, .el-input__inner").forEach(function(input) {
          input.style.setProperty("background", bg, "important");
          input.style.setProperty("color", fg, "important");
          input.style.setProperty("border-color", border, "important");
        });
      }

      function mount() {
        var version = ++state.mountVersion;
        var container = document.getElementById("twikoo");
        if (!container) return;

        loadTwikoo().then(function(client) {
          if (version !== state.mountVersion || !container.isConnected) return;

          stopOverrides();

          // Observer 必须在 init 之前启动 — client.init()
          // 内部是异步的 Vue render，如果在 observer 设置前完成
          // 首次渲染，Element UI 组件会逃脱样式覆盖。
          state.observer = new MutationObserver(function() { patchInputs(container); });
          state.observer.observe(container, { childList: true, subtree: true });

          try { client.destroy(); } catch {}
          client.init({ envId: envId, el: "#twikoo", theme: getTheme() });
          state.currentEl = container;

          patchInputs(container);
        }).catch(function(error) {
          console.error("[Twikoo] 初始化失败：", error);
        });
      }

      function unmount() {
        state.mountVersion++;
        stopOverrides();
        state.currentEl = null;
        if (window.twikoo && typeof window.twikoo.destroy === "function") {
          try { window.twikoo.destroy(); } catch {}
        }
        // 彻底清理全局状态和脚本标签，强制下次 mount()
        // 走完整加载路径——复用已加载的 twikoo 全局对象
        // 会导致第二次 View Transitions 导航后渲染异常。
        delete window.twikoo;
        state.loadPromise = null;
        var oldScript = document.querySelector('script[src="' + TWIKOO_SRC + '"]');
        if (oldScript) oldScript.remove();
      }

      function syncTheme() {
        if (window.twikoo && typeof window.twikoo.setTheme === "function") {
          try { window.twikoo.setTheme(getTheme()); } catch {}
        }
        if (state.currentEl?.isConnected) patchInputs(state.currentEl);
      }

      if (!state.eventsBound) {
        state.eventsBound = true;
        document.addEventListener("astro:before-swap", unmount);
        document.addEventListener("astro:page-load", mount);
        new MutationObserver(syncTheme).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", mount, { once: true });
      } else {
        mount();
      }
    })();
  </script>
)}
