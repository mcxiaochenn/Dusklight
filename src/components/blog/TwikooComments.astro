---
/**
 * Twikoo 评论组件
 * CDN 加载 + View Transitions 兼容
 */
import { commentConfig } from "../../config/comment";
import { cdnConfig } from "../../config/cdn";
---

{commentConfig.enabled && (
  <div class="comments-section">
    <div id="tcomment" class="comments__container glass"></div>
  </div>
)}

<style>
  .comments-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .comments__container {
    padding: var(--space-4);
    min-height: 200px;
  }
</style>

{commentConfig.enabled && (
  <script define:vars={{
    envId: commentConfig.twikoo.envId,
    cdnUrl: cdnConfig.resources.twikoo,
  }}>
    function initTwikoo() {
      const container = document.getElementById("tcomment");
      if (!container) return;

      // 检查 twikoo 是否已加载
      if (typeof twikoo !== "undefined") {
        twikoo.init({
          envId: envId,
          el: "#tcomment",
          onCommentLoaded: function () {
            // 评论加载完成后的回调
          },
        });
      }
    }

    // 动态加载 Twikoo 脚本
    function loadTwikoo() {
      if (document.querySelector(`script[src="${cdnUrl}"]`)) {
        // 脚本已存在，直接初始化
        initTwikoo();
        return;
      }

      const script = document.createElement("script");
      script.src = cdnUrl;
      script.onload = initTwikoo;
      script.onerror = function () {
        console.error("Failed to load Twikoo from CDN");
      };
      document.head.appendChild(script);
    }

    // 页面加载时初始化
    document.addEventListener("DOMContentLoaded", loadTwikoo);

    // View Transitions 重新初始化（使用 loadTwikoo 而非 initTwikoo）
    document.addEventListener("astro:page-load", loadTwikoo);
  </script>
)}
