---
/**
 * Twikoo 评论组件
 * CDN 加载 + 主题跟随 + View Transitions 兼容
 */
import { commentConfig } from "../../config/comment";
import { cdnConfig } from "../../config/cdn";
---

{commentConfig.enabled && (
  <div class="comments-section">
    <h2 class="comments__heading">评论</h2>
    <div id="tcomment" class="comments__container"></div>
  </div>
)}

<style>
  .comments-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .comments__heading {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-4);
    color: var(--foreground);
  }

  .comments__container {
    padding: var(--space-4);
    min-height: 200px;
    border-radius: var(--radius-lg);
  }

  /* Twikoo 深色模式覆盖 */
  :root.dark .comments__container .tk-content,
  :root.dark .comments__container .tk-comment,
  :root.dark .comments__container .tk-submit {
    color: var(--foreground) !important;
  }

  :root.dark .comments__container .tk-input,
  :root.dark .comments__container .tk-preview,
  :root.dark .comments__container textarea,
  :root.dark .comments__container input {
    background: var(--surface-2) !important;
    color: var(--foreground) !important;
    border-color: var(--border) !important;
  }

  :root.dark .comments__container .tk-submit-action-btn {
    background: var(--accent) !important;
    color: var(--surface-0) !important;
  }
</style>

{commentConfig.enabled && (
  <script define:vars={{
    envId: commentConfig.twikoo.envId,
    cdnUrl: cdnConfig.resources.twikoo,
  }}>
    function getTwikooTheme() {
      return document.documentElement.classList.contains("dark") ? "dark" : "light";
    }

    function initTwikoo() {
      const container = document.getElementById("tcomment");
      if (!container) return;
      if (typeof twikoo === "undefined") return;
      try { twikoo.destroy(); } catch {}

      twikoo.init({
        envId: envId,
        el: "#tcomment",
        theme: getTwikooTheme(),
        onCommentLoaded: function () {},
      });
    }

    function loadTwikoo() {
      if (document.querySelector(`script[src="${cdnUrl}"]`)) {
        initTwikoo();
        return;
      }
      const script = document.createElement("script");
      script.src = cdnUrl;
      script.onload = initTwikoo;
      script.onerror = () => console.error("Failed to load Twikoo CDN");
      document.head.appendChild(script);
    }

    document.addEventListener("DOMContentLoaded", loadTwikoo);
    document.addEventListener("astro:page-load", loadTwikoo);

    // 主题切换时更新 Twikoo 主题
    new MutationObserver(() => {
      if (typeof twikoo !== "undefined") {
        try { twikoo.setTheme(getTwikooTheme()); } catch {}
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  </script>
)}
