---
/**
 * Twikoo 1.7.15 评论组件
 * 动态加载 + View Transitions 兼容 + CSS 本地强制覆盖
 */
import { commentConfig } from "../../config/comment";
import "../../styles/twikoo.css";
---

{commentConfig.enabled && (
  <div class="comments-section">
    <h2 class="comments__heading">评论</h2>
    <div id="twikoo" class="comments__container"></div>
  </div>
)}

<style>
  .comments-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .comments__heading {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-4);
    color: var(--foreground);
  }

  .comments__container {
    min-height: 200px;
  }
</style>

{commentConfig.enabled && (
  <script define:vars={{ envId: commentConfig.twikoo.envId }}>
    var TWIKOO_SRC = "/js/twikoo.min.js";

    function getTheme() {
      return document.documentElement.classList.contains("dark") ? "dark" : "light";
    }

    function initTwikoo() {
      var el = document.getElementById("twikoo");
      if (!el || typeof twikoo === "undefined" || typeof twikoo.init !== "function") return;
      try { twikoo.destroy(); } catch {}
      twikoo.init({
        envId: envId,
        el: "#twikoo",
        theme: getTheme(),
      });
      /* 每次 init 后用 JS 兜底 Element UI 内联样式 */
      injectOverrides();
    }

    function injectOverrides() {
      var root = document.documentElement;
      var cs = getComputedStyle(root);
      var bg = cs.getPropertyValue("--glass-bg").trim();
      var border = cs.getPropertyValue("--glass-border").trim();
      var fg = cs.getPropertyValue("--foreground").trim();

      function patch() {
        var c = document.getElementById("twikoo");
        if (!c) return;
        [".el-textarea__inner", ".el-input__inner"].forEach(function(s) {
          c.querySelectorAll(s).forEach(function(el) {
            el.style.setProperty("background", bg, "important");
            el.style.setProperty("color", fg, "important");
            el.style.setProperty("border-color", border, "important");
          });
        });
      }

      patch();
      var mo = new MutationObserver(patch);
      mo.observe(document.getElementById("twikoo") || document.body, { childList: true, subtree: true });
      setTimeout(function() { mo.disconnect(); }, 5000);
    }

    function loadTwikoo() {
      if (typeof twikoo !== "undefined") { initTwikoo(); return; }
      if (document.querySelector('script[src="' + TWIKOO_SRC + '"]')) {
        /* script 标签已存在但还没加载完，等 onload */
        return;
      }
      var s = document.createElement("script");
      s.src = TWIKOO_SRC;
      s.onload = initTwikoo;
      s.onerror = function() { console.error("[Twikoo] 加载失败:", TWIKOO_SRC); };
      document.head.appendChild(s);
    }

    /* View Transitions 兼容：首次 + SPA 导航后均触发 */
    document.addEventListener("DOMContentLoaded", loadTwikoo);
    document.addEventListener("astro:page-load", loadTwikoo);

    /* 主题跟随 */
    new MutationObserver(function() {
      if (typeof twikoo !== "undefined" && typeof twikoo.setTheme === "function") {
        try { twikoo.setTheme(getTheme()); } catch {}
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  </script>
)}
