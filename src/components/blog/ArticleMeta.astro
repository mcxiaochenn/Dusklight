---
/**
 * 文章元信息组件
 */
import FormattedDate from "../FormattedDate.astro";
import { Icon } from "astro-icon/components";

interface Props {
  date: Date;
  updated?: Date;
  category?: string;
  readingTime?: number;
  class?: string;
}

const { date, updated, category, readingTime, class: className } = Astro.props;
---

<div class:list={["article-meta", className]}>
  <time datetime={date.toISOString()} class="article-meta__item">
    <Icon name="ph:calendar" class="article-meta__icon" />
    <FormattedDate date={date} />
  </time>
  {updated && (
    <span class="article-meta__item article-meta__updated">
      <Icon name="ph:pencil-simple" class="article-meta__icon" />
      更新于 <time datetime={updated.toISOString()}><FormattedDate date={updated} /></time>
    </span>
  )}
  {category && (
    <span class="article-meta__item article-meta__category">
      <Icon name="ph:folder" class="article-meta__icon" />
      {category}
    </span>
  )}
  {readingTime && (
    <span class="article-meta__item">
      <Icon name="ph:clock" class="article-meta__icon" />
      {readingTime} 分钟
    </span>
  )}
</div>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--foreground-muted);
  }

  .article-meta__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .article-meta__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .article-meta__updated {
    font-style: italic;
  }

  .article-meta__category {
    padding: 2px 8px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }
</style>
