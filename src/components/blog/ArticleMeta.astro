---
/**
 * 文章元信息组件
 */
import FormattedDate from "../FormattedDate.astro";
import { Icon } from "astro-icon/components";

interface Props {
  date: Date;
  updated?: Date;
  category?: string;
  readingTime?: number;
  wordCount?: number;
  class?: string;
}

const { date, updated, category, readingTime, wordCount, class: className } = Astro.props;
---

<div class:list={["article-meta", className]}>
  <time datetime={date.toISOString()} class="article-meta__item">
    <Icon name="fa7-solid:calendar-days" class="article-meta__icon" />
    <FormattedDate date={date} />
  </time>
  {updated && (
    <span class="article-meta__item article-meta__updated">
      <Icon name="fa7-solid:pencil" class="article-meta__icon" />
      更新于 <time datetime={updated.toISOString()}><FormattedDate date={updated} /></time>
    </span>
  )}
  {category && (
    <span class="article-meta__item article-meta__category">
      <Icon name="fa7-solid:folder" class="article-meta__icon" />
      {category}
    </span>
  )}
  {wordCount && (
    <span class="article-meta__item">
      <Icon name="fa7-solid:font" class="article-meta__icon" />
      {wordCount.toLocaleString()} 字
    </span>
  )}
  {readingTime && (
    <span class="article-meta__item">
      <Icon name="fa7-regular:clock" class="article-meta__icon" />
      {readingTime} 分钟
    </span>
  )}
</div>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--foreground-muted);
  }

  .article-meta__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .article-meta__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .article-meta__updated {
    font-style: italic;
  }

  .article-meta__category {
    padding: var(--space-1) var(--space-2);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }
</style>
