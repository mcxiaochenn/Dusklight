---
/**
 * 目录组件
 * 玻璃面板，粘性定位由父容器统一管理，支持滚动高亮与折叠。
 */
import { Icon } from "astro-icon/components";

interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[]; title?: string }
const { headings, title = "目录" } = Astro.props;
// 清理 rehype-autolink-headings append 的 "#" 锚点文本
const cleanHeadings = headings.map((h) => ({
  ...h,
  text: h.text.replace(/\s*#$/, "").trim(),
}));
const toc = cleanHeadings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{toc.length > 0 && (
  <nav class="toc glass-panel" aria-label="文章目录">
    <div class="toc__header">
      <div class="toc__header-left">
        <Icon name="fa7-solid:list-ul" class="toc__icon" />
        <h2 class="toc__title">{title}</h2>
      </div>
      <button class="toc__toggle" aria-label="折叠目录" aria-expanded="true">
        <Icon name="fa7-solid:caret-down" />
      </button>
    </div>
    <ul class="toc__list">
      {toc.map((h) => (
        <li class:list={["toc__item", `toc__item--h${h.depth}`]}>
          <a href={`#${h.slug}`} class="toc__link">{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    max-height: 46vh;
    overflow-y: auto;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--duration-fast) var(--ease-material),
      box-shadow var(--duration-fast) var(--ease-material);
  }

  .toc:hover {
    border-color: var(--accent);
    box-shadow: var(--glass-hover-shadow), var(--glass-highlight);
  }

  .toc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .toc__header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .toc__icon {
    width: 15px;
    height: 15px;
    color: var(--accent);
  }

  .toc__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--foreground);
  }

  .toc__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    color: var(--foreground-muted);
    transition:
      background var(--duration-fast) var(--ease-material),
      transform var(--duration-fast) var(--ease-material);
  }

  .toc__toggle:hover {
    background: var(--accent-subtle);
  }

  .toc__toggle svg {
    width: 16px;
    height: 16px;
  }

  .toc__toggle[aria-expanded="false"] {
    transform: rotate(-90deg);
  }

  .toc__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc__link {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--foreground-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-material),
      background var(--duration-fast) var(--ease-material);
  }

  .toc__link:hover {
    color: var(--foreground);
    background: var(--accent-subtle);
  }

  .toc__link--active,
  .toc__link.active {
    color: var(--accent);
    background: var(--accent-subtle);
    border-left: 2px solid var(--accent);
    padding-left: calc(var(--space-2) - 2px);
    font-weight: 600;
  }

  .toc__item--h3 { padding-left: var(--space-4); }
  .toc__item--h4 { padding-left: var(--space-8); }

  .toc.collapsed .toc__list { display: none; }

  .toc::-webkit-scrollbar { width: 4px; }
  .toc::-webkit-scrollbar-track { background: transparent; }
  .toc::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--radius-sm); }
</style>

<script>
  let tocIO: IntersectionObserver | null = null;
  function initTOC() {
    const toc = document.querySelector(".toc");
    if (!toc || (toc as HTMLElement).dataset.tocInit) return;
    (toc as HTMLElement).dataset.tocInit = "1";

    const toggle = toc.querySelector(".toc__toggle");
    const links = toc.querySelectorAll(".toc__link");
    const headings = document.querySelectorAll(".article h2, .article h3, .article h4");

    toggle?.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      toc.classList.toggle("collapsed");
    });

    tocIO?.disconnect();
    tocIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((link) => {
              link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
            });
          }
        });
      },
      { rootMargin: "-80px 0px -80% 0px", threshold: 0 }
    );

    headings.forEach((h) => { if (h.id) tocIO!.observe(h); });

    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.getAttribute("href")?.slice(1) || "";
        const target = document.getElementById(id);
        if (!target) return;
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        target.classList.remove("anchor-spotlight");
        void target.offsetWidth;
        target.classList.add("anchor-spotlight");
        window.setTimeout(() => target.classList.remove("anchor-spotlight"), 1400);
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initTOC);
  document.addEventListener("astro:page-load", initTOC);
</script>
