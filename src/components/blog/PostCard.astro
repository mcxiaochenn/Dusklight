---
/**
 * 文章卡片组件
 * 响应式布局：中屏水平（左图右文），大屏/移动端垂直（图上文下）。
 * 学习 blog.zhheo.com 的三段式断点策略。
 * 无封面时降级到 /images/cover-fallback.svg。
 *
 * 可点击区域设计：HTML 不允许 <a> 嵌套 <a>，而卡片需要「整卡可点 +
 * 标签/分类独立可点」同时成立。做法是主链接用绝对定位覆盖整卡
 * （inset:0 + z-index:1），标签/分类用 z-index:2 浮在其上 —— 点卡片
 * 空白进文章，点标签/分类进对应归档页。
 */
import type { CollectionEntry } from "astro:content";
import Tag from "../ui/Tag.astro";
import FormattedDate from "../FormattedDate.astro";
import { Icon } from "astro-icon/components";
import { getPostUrl } from "@/utils/abbrlink";

interface Props {
  post: CollectionEntry<"blog">;
  class?: string;
  excerpt?: string;
}

const { post, class: className, excerpt: autoExcerpt } = Astro.props;

// 优先使用 frontmatter description，fallback 到 remark-content 自动摘录
const displayDesc = post.data.description || autoExcerpt || "";
const coverSrc = post.data.cover || "/images/cover-fallback.svg";
const postUrl = getPostUrl(post);
---

<article class:list={["post-card", "reveal", className]}>
  {/* 整卡主链接 — 绝对定位覆盖层，承载除标签/分类外的全部点击 */}
  <a href={postUrl} class="post-card__link" aria-label={post.data.title}></a>

  <div class="post-card__cover">
    <img
      src={coverSrc}
      alt={post.data.title}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="post-card__body">
    {(post.data.pinned || (post.data.tags && post.data.tags.length > 0)) && (
      <div class="post-card__tags">
        {post.data.pinned && (
          <span class="post-card__pin">
            <Icon name="fa7-solid:thumbtack" />置顶
          </span>
        )}
        {(post.data.tags ?? []).slice(0, 3).map((t) => (
          <Tag href={`/tags/${encodeURIComponent(t)}/`}>{t}</Tag>
        ))}
      </div>
    )}

    <h3 class="post-card__title">{post.data.title}</h3>

    {displayDesc && (
      <p class="post-card__desc">{displayDesc}</p>
    )}

    <div class="post-card__meta">
      <Icon name="fa7-solid:calendar-days" class="post-card__meta-icon" />
      <FormattedDate date={post.data.date} />
      {post.data.category && (
        <a href={`/categories/${encodeURIComponent(post.data.category.trim())}/`} class="post-card__category">
          {post.data.category.trim()}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* Liquid glass card */
  .post-card {
    position: relative;
    display: flex;
    flex-direction: row;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition: box-shadow var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
    height: 100%;
  }

  .post-card:hover {
    box-shadow: var(--shadow-md), var(--glass-highlight);
    border-color: var(--border);
  }

  /* 主链接覆盖层 — 承接整卡点击；标签/分类 z-index 浮在其上 */
  .post-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;
  }

  /* 封面：默认水平，45%宽 + 16:9 比例 */
  .post-card__cover {
    overflow: hidden;
    width: 45%;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
  }

  .post-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform var(--duration-slow) var(--ease-material);
  }

  .post-card:hover .post-card__cover img {
    transform: scale(1.03);
  }

  .post-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
    min-width: 0;
  }

  .post-card__tags {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .post-card__tags :global(.tag) {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid oklch(from var(--accent) l c h / 0.2);
    box-shadow: inset 0 0.5px 0 oklch(1 0 0 / 0.2);
    color: var(--accent);
  }

  .post-card__tags :global(.tag):hover {
    background: oklch(from var(--accent) l c h / 0.15);
    border-color: oklch(from var(--accent) l c h / 0.35);
  }

  .post-card__pin {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: oklch(0.99 0.002 var(--hue));
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
  }

  .post-card__pin [data-icon] {
    width: 11px;
    height: 11px;
  }

  .post-card__title {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    color: var(--foreground);
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--foreground-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }

  .post-card__meta-icon {
    width: 13px;
    height: 13px;
    opacity: 0.6;
  }

  .post-card__category {
    padding: var(--space-1) var(--space-2);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .post-card__category:hover {
    background: oklch(from var(--accent) l c h / 0.15);
    border-color: oklch(from var(--accent) l c h / 0.35);
  }

  /* ── 大屏(≥1300px)：垂直布局，封面固定210px ── */
  @media (min-width: 1300px) {
    .post-card {
      flex-direction: column;
    }

    .post-card__cover {
      width: 100%;
      height: 210px;
      aspect-ratio: auto;
    }
  }

  /* ── 移动端(≤768px)：垂直布局，封面固定170px ── */
  @media (max-width: 768px) {
    .post-card {
      flex-direction: column;
    }

    .post-card__cover {
      width: 100%;
      height: 170px;
      aspect-ratio: auto;
    }

    .post-card__body {
      padding: var(--space-3);
    }
  }
</style>
