---
/**
 * 文章卡片组件
 * 扩展 Card，添加封面、标题、描述、元信息。
 * 两种变体：default（纵向）和 hero（横向）。
 */
import type { CollectionEntry } from "astro:content";
import Tag from "../ui/Tag.astro";
import FormattedDate from "../FormattedDate.astro";
import { Icon } from "astro-icon/components";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "default" | "hero";
  class?: string;
  excerpt?: string;
}

const { post, variant = "default", class: className, excerpt: autoExcerpt } = Astro.props;

// 优先使用 frontmatter description，fallback 到 remark-content 自动摘录
const displayDesc = post.data.description || autoExcerpt || "";
---

<article class:list={["post-card", `post-card--${variant}`, className]}>
  <a href={`/blog/${post.id}/`} class="post-card__link">
    {post.data.cover && (
      <div class="post-card__cover">
        <img
          src={post.data.cover}
          alt={post.data.title}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="post-card__body">
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="post-card__tags">
          {post.data.tags.slice(0, 3).map((t) => <Tag>{t}</Tag>)}
        </div>
      )}

      <h3 class="post-card__title">{post.data.title}</h3>

      {displayDesc && (
        <p class="post-card__desc">{displayDesc}</p>
      )}

      <div class="post-card__meta">
        <Icon name="ph:calendar" class="post-card__meta-icon" />
        <FormattedDate date={post.data.date} />
        {post.data.category && (
          <span class="post-card__category">{post.data.category}</span>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  /* Liquid glass card */
  .post-card {
    position: relative;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(var(--glass-brightness));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm), var(--glass-highlight);
    transition: box-shadow var(--duration-fast) var(--ease-material),
                border-color var(--duration-fast) var(--ease-material);
  }

  .post-card:hover {
    box-shadow: var(--shadow-md), var(--glass-highlight);
    border-color: var(--border);
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .post-card__cover {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .post-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform var(--duration-slow) var(--ease-material);
  }

  .post-card:hover .post-card__cover img {
    transform: scale(1.03);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .post-card__tags :global(.tag) {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid oklch(from var(--accent) l c h / 0.2);
    box-shadow: inset 0 0.5px 0 oklch(1 0 0 / 0.2);
    color: var(--accent);
  }

  .post-card__tags :global(.tag):hover {
    background: oklch(from var(--accent) l c h / 0.15);
    border-color: oklch(from var(--accent) l c h / 0.35);
  }

  .post-card__title {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    color: var(--foreground);
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--foreground-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--foreground-muted);
  }

  .post-card__meta-icon {
    width: 13px;
    height: 13px;
    opacity: 0.6;
  }

  .post-card__category {
    padding: var(--space-1) var(--space-2);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-weight: 600;
  }

  /* Hero variant — horizontal */
  .post-card--hero .post-card__link {
    flex-direction: row;
  }

  .post-card--hero .post-card__cover {
    width: 45%;
    aspect-ratio: auto;
    min-height: 200px;
  }

  .post-card--hero .post-card__title {
    font-size: var(--text-lg);
  }

  .post-card--hero .post-card__desc {
    -webkit-line-clamp: 3;
  }

  @media (max-width: 768px) {
    .post-card--hero .post-card__link {
      flex-direction: column;
    }

    .post-card--hero .post-card__cover {
      width: 100%;
    }
  }
</style>
