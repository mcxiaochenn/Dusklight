---
import { Icon } from "astro-icon/components";
interface Props { current: "archive" | "tags" | "categories"; posts: number; tags: number; categories: number }
const { current, posts, tags, categories } = Astro.props;
const links = [
  { key: "archive", label: "全部文章", icon: "fa7-solid:book-open", count: posts },
  { key: "tags", label: "标签", icon: "fa7-solid:tags", count: tags },
  { key: "categories", label: "分类", icon: "fa7-solid:folder-open", count: categories },
];
---
<nav class="browse-nav" aria-label="文章浏览方式">
  {links.map(({ key, label, icon, count }) => (
    <a href={`/${key}/`} aria-current={current === key ? "page" : undefined}>
      <Icon name={icon} /><span>{label}</span><span class="browse-nav__count">{count}</span>
    </a>
  ))}
</nav>
<style>
  .browse-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); }
  a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: var(--space-2) var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-full); color: var(--foreground-secondary); background: var(--surface-1); text-decoration: none; font-size: var(--text-sm); font-weight: 600; }
  a:hover, a[aria-current] { color: var(--accent); background: var(--accent-subtle); border-color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .browse-nav__count { font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) { a { gap: var(--space-1); padding-inline: var(--space-3); } }
</style>
