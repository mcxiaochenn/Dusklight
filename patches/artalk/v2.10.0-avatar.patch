+	user := entity.User{Name: "测试", Email: "12345@qq.com"}
+	if err := database.Create(&user).Error; err != nil {
+		t.Fatal(err)
+	}
+	comment := entity.Comment{UserID: user.ID, Content: "保持内容", Page: &entity.Page{}}
+	got := d.CookComment(&comment)
+	if got.AvatarURL != "https://thirdqq.qlogo.cn/g?b=sdk&nk=12345&s=140" {
+		t.Fatal("未装配 QQ 头像")
+	}
+	user.AvatarURL = "https://example.com/github"
+	comment.User = &user
+	got2 := d.CookAllComments([]*entity.Comment{&comment})[0]
+	if got2.AvatarURL != user.AvatarURL || got2.EmailEncrypted != got.EmailEncrypted || got2.Content != got.Content {
+		t.Fatal("头像或既有字段错误")
+	}
+}
