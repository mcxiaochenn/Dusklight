+package entity
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestResolveAvatarURL(t *testing.T) {
+	for _, tc := range []struct{ email, qq string }{
+		{"12345@qq.com", "12345"}, {" 12345678901@QQ.COM\t", "12345678901"},
+		{"1234@qq.com", ""}, {"123456789012@qq.com", ""}, {"012345@qq.com", ""},
+		{"abc@qq.com", ""}, {"12345+tag@qq.com", ""}, {"12345@QQ.COM.evil", ""},
+		{"12345@example.com", ""}, {"１２３４５@qq.com", ""}, {"", ""},
+	} {
+		t.Run(tc.email, func(t *testing.T) {
+			want := ""
+			if tc.qq != "" {
+				want = "https://thirdqq.qlogo.cn/g?b=sdk&nk=" + tc.qq + "&s=140"
+			}
+			if got := ResolveAvatarURL(&User{Email: tc.email}); got != want {
+				t.Fatalf("got %q, want %q", got, want)
+			}
+		})
+	}
+	if ResolveAvatarURL(nil) != "" {
+		t.Fatal("空用户必须返回空")
+	}
+	if ResolveAvatarURL(&User{Email: "12345@qq.com", AvatarURL: "https://example.com/avatar"}) != "https://example.com/avatar" {
+		t.Fatal("已保存头像必须优先")
+	}
+}
+
+func TestAvatarJSONOptional(t *testing.T) {
+	b, _ := json.Marshal(CookedComment{})
+	if strings.Contains(string(b), "avatar_url") {
+		t.Fatal("空值应省略")
+	}
+	b, _ = json.Marshal(CookedComment{AvatarURL: "https://example.com/avatar"})
+	if !strings.Contains(string(b), `"avatar_url":"https://example.com/avatar"`) {
+		t.Fatal("头像未序列化")
+	}
+}
