+package auth
+
+import (
+	"net/url"
+
+	"github.com/artalkjs/artalk/v2/internal/dao"
+	"github.com/artalkjs/artalk/v2/internal/entity"
+	"github.com/artalkjs/artalk/v2/internal/log"
+)
+
+// SyncGitHubAvatar 在身份关联完成后调用；失败不阻断登录，也不输出提供方资料。
+func SyncGitHubAvatar(dao *dao.Dao, user *entity.User, social SocialUser) {
+	if social.Provider != "github" || user == nil || user.IsEmpty() || social.AvatarURL == "" || social.AvatarURL == user.AvatarURL {
+		return
+	}
+	parsed, err := url.Parse(social.AvatarURL)
+	if err != nil || parsed.Scheme != "https" || parsed.Hostname() == "" || parsed.User != nil {
+		return
+	}
+	if err := dao.UpdateUserAvatar(user, social.AvatarURL); err != nil {
+		log.Warn("[SocialLogin] GitHub 头像保存失败，继续登录")
+	}
+}
diff --git a/internal/auth/avatar_test.go b/internal/auth/avatar_test.go
new file mode 100644
index 0000000..74934ae
--- /dev/null
+++ b/internal/auth/avatar_test.go
@@ -0,0 +1,66 @@
+package auth
+
+import (
+	"testing"
+
+	"github.com/artalkjs/artalk/v2/internal/cache"
+	"github.com/artalkjs/artalk/v2/internal/config"
+	"github.com/artalkjs/artalk/v2/internal/dao"
+	"github.com/artalkjs/artalk/v2/internal/db"
+	"github.com/artalkjs/artalk/v2/internal/entity"
+	"github.com/markbates/goth"
+)
+
+func TestSyncGitHubAvatar(t *testing.T) {
+	database, err := db.NewTestDB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.CloseDB(database) })
+	d := dao.NewDao(database)
+	c, err := cache.New(config.CacheConf{Type: config.CacheTypeBuiltin})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { c.Close() })
+	d.SetCache(dao.NewCacheAdaptor(c))
+	user := entity.User{Name: "测试用户", Email: "avatar@example.com"}
+	if err := database.Create(&user).Error; err != nil {
+		t.Fatal(err)
+	}
+	d.FindUserByID(user.ID) // 先填充缓存，验证更新会失效。
+	writes := 0
+	database.Callback().Update().After("gorm:update").Register("avatar_write_count", func(tx *dao.DB) { writes++ })
+	social := SocialUser{User: goth.User{Provider: "github", AvatarURL: "https://avatars.githubusercontent.com/u/12345?v=4"}}
+	SyncGitHubAvatar(d, &user, social)
+	if user.AvatarURL != social.AvatarURL || d.FindUserByID(user.ID).AvatarURL != social.AvatarURL {
+		t.Fatal("头像未保存或缓存未失效")
+	}
+	SyncGitHubAvatar(d, &user, social)
+	if writes != 1 {
+		t.Fatal("重复登录发生额外写入")
+	}
+	for _, address := range []string{"", "http://example.com/a", "https:///a", "https://user:secret@example.com/a", "javascript:alert(1)"} {
+		social.AvatarURL = address
+		SyncGitHubAvatar(d, &user, social)
+	}
+	social.Provider = "google"
+	social.AvatarURL = "https://example.com/google"
+	SyncGitHubAvatar(d, &user, social)
+	if writes != 1 {
+		t.Fatal("无效头像或非 GitHub 提供方触发了写入")
+	}
+	old := user.AvatarURL
+	if err := database.Exec("CREATE TRIGGER deny_avatar BEFORE UPDATE ON atk_users BEGIN SELECT RAISE(ABORT, '测试失败'); END").Error; err != nil {
+		t.Fatal(err)
+	}
+	social.Provider = "github"
+	social.AvatarURL = "https://example.com/new"
+	SyncGitHubAvatar(d, &user, social) // 不抛出错误，调用方继续生成登录令牌。
+	if user.AvatarURL != old || d.FindUserByID(user.ID).AvatarURL != old {
+		t.Fatal("失败写入污染了用户或缓存")
+	}
+	if d.FindUserByID(user.ID).Name != "测试用户" {
+		t.Fatal("无关字段发生变化")
+	}
+}
diff --git a/internal/dao/avatar.go b/internal/dao/avatar.go
new file mode 100644
index 0000000..56e38fc
--- /dev/null
+++ b/internal/dao/avatar.go
@@ -0,0 +1,13 @@
+package dao
+
+import "github.com/artalkjs/artalk/v2/internal/entity"
+
+// UpdateUserAvatar 只写头像列，成功后使用户缓存失效，保留其他资料。
+func (dao *Dao) UpdateUserAvatar(user *entity.User, avatarURL string) error {
+	if err := dao.DB().Model(&entity.User{}).Where("id = ?", user.ID).UpdateColumn("avatar_url", avatarURL).Error; err != nil {
+		return err
+	}
+	user.AvatarURL = avatarURL
+	dao.CacheAction(func(cache *DaoCache) { cache.UserCacheDel(user) })
+	return nil
+}
