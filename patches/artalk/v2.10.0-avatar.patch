diff --git a/internal/entity/avatar.go b/internal/entity/avatar.go
new file mode 100644
index 0000000..b255b09
--- /dev/null
+++ b/internal/entity/avatar.go
@@ -0,0 +1,22 @@
+package entity
+
+import (
+	"regexp"
+	"strings"
+)
+
+var numericQQEmail = regexp.MustCompile(`^([1-9][0-9]{4,10})@qq\.com$`)
+
+// ResolveAvatarURL 仅下发头像，不向客户端提供邮箱明文。
+func ResolveAvatarURL(user *User) string {
+	if user == nil {
+		return ""
+	}
+	if user.AvatarURL != "" {
+		return user.AvatarURL
+	}
+	if match := numericQQEmail.FindStringSubmatch(strings.ToLower(strings.TrimSpace(user.Email))); match != nil {
+		return "https://thirdqq.qlogo.cn/g?b=sdk&nk=" + match[1] + "&s=140"
+	}
+	return ""
+}
