# ===== 内容同步配置 =====

# 是否启用内容同步（false = 使用本地 content/ 目录）
ENABLE_CONTENT_SYNC=true

# 内容仓库地址（HTTPS 或 SSH）
CONTENT_REPO_URL=https://github.com/mcxiaochenn/Dusklight-Content.git
# SSH 方式：
# CONTENT_REPO_URL=git@github.com:mcxiaochenn/Dusklight-Content.git

# 内容目录（默认 ./content）
CONTENT_DIR=./content

# 内容仓库分支
CONTENT_BRANCH=main

# ===== 站点配置 =====
# SITE_URL=https://blog.mcxiaochen.top
